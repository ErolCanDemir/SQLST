<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AÇIK · SLATE MAVİ (v19-S9, 2026-08-03): beyaz-mavimsi yüzeyler, gök mavisi vurgu.
         Anahtar kümesi PaletAcik.xaml ile BİREBİR aynıdır (PaletUyumTestleri korur). -->
    <SolidColorBrush x:Key="SeritFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BaglamSeridiFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VurguFircasi" Color="#0284C7" />
    <SolidColorBrush x:Key="VurguKoyuFircasi" Color="#0369A1" />
    <SolidColorBrush x:Key="VurguZeminFircasi" Color="#E5F3FC" />
    <!-- v22-S1 m.8: chip/vurgu-zemin uzerindeki YAZI rengi (kontrast bekcisi olctu) -->
    <SolidColorBrush x:Key="VurguZeminMetinFircasi" Color="#0369A1" />
    <SolidColorBrush x:Key="VurguBasiliFircasi" Color="#CFE9FA" />
    <SolidColorBrush x:Key="MetinFircasi" Color="#0F1E2E" />
    <SolidColorBrush x:Key="IkincilFircasi" Color="#64748B" />
    <SolidColorBrush x:Key="KenarFircasi" Color="#DFE8F2" />
    <SolidColorBrush x:Key="ZeminAcikFircasi" Color="#F6FAFD" />
    <SolidColorBrush x:Key="PencereZeminFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TehlikeFircasi" Color="#DC2626" />
    <SolidColorBrush x:Key="UyariFircasi" Color="#B45309" />
    <SolidColorBrush x:Key="BasariFircasi" Color="#16A34A" />
    <!-- Ctrl+F eşleşme vurgusu (v20-S17): yarı saydam amber — koyu metinle okunur. -->
    <SolidColorBrush x:Key="AramaVurguFircasi" Color="#66FFC107" />

    <Color x:Key="RayGradyanUst">#1E3A5F</Color>
    <Color x:Key="RayGradyanAlt">#1E3A5F</Color> <!-- v22-S15: düz ray -->
    <SolidColorBrush x:Key="RayMetinFircasi" Color="#EAF3FD" />
    <SolidColorBrush x:Key="RaySolukFircasi" Color="#9DBBDA" />
    <SolidColorBrush x:Key="RayBaslikFircasi" Color="#8CACCE" />
    <SolidColorBrush x:Key="RayHoverFircasi" Color="#2C5484" />

    <SolidColorBrush x:Key="ZayifMetinFircasi" Color="#3E4C5E" />
    <SolidColorBrush x:Key="SolukMetinFircasi" Color="#94A3B8" />
    <SolidColorBrush x:Key="PanelZeminFircasi" Color="#F1F6FB" />
    <SolidColorBrush x:Key="BilgiZeminFircasi" Color="#E5F3FC" />
    <SolidColorBrush x:Key="BilgiMetinFircasi" Color="#075985" />
    <SolidColorBrush x:Key="UyariZeminFircasi" Color="#FEF3E2" />
    <SolidColorBrush x:Key="UyariMetinFircasi" Color="#92500A" />
    <SolidColorBrush x:Key="UyariKenarFircasi" Color="#E0A83A" />
    <SolidColorBrush x:Key="FarkSilinenZeminFircasi" Color="#FBEAEA" />
    <SolidColorBrush x:Key="FarkEklenenZeminFircasi" Color="#E7F5EC" />
    <SolidColorBrush x:Key="EditorZeminFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorMetinFircasi" Color="#1E1E1E" />
    <SolidColorBrush x:Key="GirisZeminFircasi" Color="#FFFFFF" />

    <SolidColorBrush x:Key="KaydiriciZeminFircasi" Color="#F6FAFD" />
    <SolidColorBrush x:Key="KaydiriciTutamacFircasi" Color="#C4D2E1" />
    <SolidColorBrush x:Key="KaydiriciTutamacUstuFircasi" Color="#9EB3C9" />
    <SolidColorBrush x:Key="KaydiriciTutamacBasiliFircasi" Color="#7F97B1" />

    <SolidColorBrush x:Key="IkonMor" Color="#8B5CF6" />
    <SolidColorBrush x:Key="IkonYesil" Color="#0E9F6E" />
    <SolidColorBrush x:Key="IkonAmber" Color="#D97706" />
    <SolidColorBrush x:Key="IkonMavi" Color="#0284C7" />
    <SolidColorBrush x:Key="IkonSari" Color="#CA8A04" />
    <SolidColorBrush x:Key="IkonIndigo" Color="#4F46E5" />
    <SolidColorBrush x:Key="IkonGul" Color="#E11D48" />
    <SolidColorBrush x:Key="IkonTeal" Color="#0D9488" />
    <SolidColorBrush x:Key="IkonPembe" Color="#DB2777" />

    <SolidColorBrush x:Key="TabloFircasi" Color="#1565C0" />
    <SolidColorBrush x:Key="ViewFircasi" Color="#00838F" />
    <SolidColorBrush x:Key="SpFircasi" Color="#6A1B9A" />
    <SolidColorBrush x:Key="FonksiyonFircasi" Color="#EF6C00" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE9FA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F1E2E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2ECF5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F1E2E" />

    <!-- Durum çubuğu (v22-S15): anahtar ayrıştı; ESKİ değerlerin aynısı — görsel fark yok. -->
    <SolidColorBrush x:Key="DurumCubuguZeminFircasi" Color="#0284C7" />
    <SolidColorBrush x:Key="DurumCubuguMetinFircasi" Color="#FFFFFF" />

    <!-- Ray çipi (v22-S15 sistem tasarımı): örtü ray tonunda → monokrom ray (renk aileden). -->
    <SolidColorBrush x:Key="RayCipOrtusuFircasi" Color="#1E3A5F" />
    <SolidColorBrush x:Key="RayIkonFircasi" Color="#FFFFFF" />

    <!-- v23-S14 GRID IZGARASI: bu aile DEĞİŞMEDİ (bkz. PaletAcik.xaml notu). -->
    <x:Static x:Key="GridCizgiGorunurlugu" Member="DataGridGridLinesVisibility.All" />
    <SolidColorBrush x:Key="GridCizgiFircasi" Color="#DFE8F2" />
    <Thickness x:Key="GridBaslikKenarKalinligi">0,0,1,1</Thickness>
    <SolidColorBrush x:Key="GridAlternatifSatirFircasi" Color="#F6FAFD" />
</ResourceDictionary>
