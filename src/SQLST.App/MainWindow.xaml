<Window x:Class="SQLST.App.MainWindow" x:Name="AnaPencere"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:SQLST.Contracts;assembly=SQLST.Contracts"
        xmlns:vm="clr-namespace:SQLST.App.ViewModels"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:conv="clr-namespace:SQLST.App.Converters"
        xmlns:app="clr-namespace:SQLST.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SQLST" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}"
        WindowState="Maximized" Icon="sqlst.ico"
        AllowDrop="True" Drop="PencereyeDosyaBirakildi">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolGorunurluk" />
        <conv:TersBoolGorunurluk x:Key="TersBoolGorunurluk" />
        <conv:MarkdownCevirici x:Key="MarkdownCevir" />
        <conv:NullGizleConverter x:Key="NullGizle" />
        <conv:GorunurlukBoolConverter x:Key="GorunurlukBool" />
        <conv:DegerDoluysaGorunurConverter x:Key="DegerVarsaGorunur" />
        <conv:TurGorunurConverter x:Key="TurGorunur" />
        <!-- Tür + motor birlikte: T-SQL script üreten menüler yalnız SQL Server'da (V3) -->
        <conv:TurVeMotorGorunurConverter x:Key="TurVeMotor" />
        <conv:TurSimgeConverter x:Key="TurSimge" />
        <!-- v20-S4 kolon arama: aramayla eşleşen kolon adını KALIN gösterir (neden eşleşti belli olsun) -->
        <conv:KolonEslesmeKalinlikConverter x:Key="KolonEslesmeKalinlik" />
        <!-- Sonuç grid'i mevcut alana orantılı büyüsün (result set sayısına bölünür) -->
        <conv:OranliYukseklikConverter x:Key="OranliYukseklik" />
    </Window.Resources>
    <Window.FontFamily>
        <StaticResource ResourceKey="ArayuzYazisi" />
    </Window.FontFamily>
    <!-- 03-ui-tasarim §2 ana yerleşim -->
    <!-- Kısayollar — 03-ui-tasarim §4 (SSMS uyumlu) -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SeciliyiCalistirCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding SeciliyiCalistirCommand}" />
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SeciliyiImlectenCalistirCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding SeciliyiBicimlendirCommand}" />
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding SeciliyiProvaCommand}" />
        <KeyBinding Key="Escape" Command="{Binding SeciliyiIptalEtCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding YeniSekmeCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding YeniSekmeCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding SekmeKapatCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding SekmeKapatCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding GezginiGizleGosterCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding SonuclariGizleGosterCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding GecmisiGizleGosterCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding KapatilanSekmeyiGeriAlCommand}" />
        <!-- Ctrl+P paleti code-behind'da bağlanır (pencere açmak view işidir) -->
    </Window.InputBindings>
    <!-- F1 → kısayol kılavuzu (Help komutunun varsayılan tuşu F1'dir) -->
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Kisayollar_Executed" />
    </Window.CommandBindings>
    <Grid>
    <DockPanel>
        <!-- ══ SOL RAY (Command Deck, 2026-07-24 — kullanıcı 5 mockup'tan seçti): koyu renkli ray;
             büyük özellikler İRİ + ETİKETLİ + renk çipiyle (sağdaki minik ikonların yerine).
             Ray İKİ TEMADA DA koyu (sabit gradyan). -->
        <Border DockPanel.Dock="Left" MouseEnter="Ray_MouseEnter" MouseLeave="Ray_MouseLeave"
                ClipToBounds="True">
            <Border.Style>
                <!-- Açık/kapalı: kullanıcı isteği 2026-07-24. Kapalıyken 72px (yalnız çipler —
                     60 dardı, kullanıcı isteği 2026-08-03 "width'i birazcık arttıralım").
                     Hover (2026-07-25): sabit değilken üstüne gelince açılır, çekilince kapanır.
                     ANİMASYON (kullanıcı isteği 2026-07-25 akşam): "bi tık yavaş açılsın" —
                     genişleme 250ms yumuşak (CubicEase), kapanma 180ms daha çevik. -->
                <Style TargetType="Border">
                    <Setter Property="Width" Value="72" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RayGenisMi}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="216" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="72" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <!-- Duraklar palet Color'larına bağlı (2026-07-26): açık temada bir ton açık,
                     koyu temada eski koyu — tema takasında ray da anında döner. -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource RayGradyanUst}" Offset="0" />
                    <GradientStop Color="{DynamicResource RayGradyanAlt}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <!-- Logo + aç/kapa düğmesi. Ray kapalıyken ☰ ortalanır (çiplerle aynı eksen —
                     kullanıcı bulgusu 2026-08-03). -->
                <DockPanel DockPanel.Dock="Top">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Margin" Value="10,12,8,12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RayGenisMi}" Value="False">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="8,12,8,12" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <!-- v22-S15 rötuşu: genel buton hover'ı (açık indigo kutu) koyu rayda sırıtıyordu
                         (kullanıcı ekran görüntüsü) → raya özel sade stil (hover=RayHover). -->
                    <Button DockPanel.Dock="Left" Width="30" Height="30" Style="{StaticResource RayGecisDugmesi}"
                            Command="{Binding RayAcKapaCommand}"
                            ToolTip="Menüyü sabitle / bırak — sabit değilken üstüne gelince açılır, çekilince kapanır"
                            AutomationProperties.AutomationId="BtnRayAcKapa">
                        <!-- v22-S1 (saha turu-2 m.8): renk SABİT "White" değil RAY METİN fırçası. Kor AÇIK
                             temada ray zemini açık küldür (m.7) → beyaz ikon/yazı görünmez oluyordu.
                             RayMetinFircasi 11 palette zaten açık, YALNIZ Kor açıkta koyu (#2B1A14):
                             diğer temalarda görünüm birebir aynı kalır, Kor açıkta okunur olur. -->
                        <Path Data="{StaticResource Ikon.Menu}" Stretch="Uniform" Width="18" Height="18"
                              Stroke="{DynamicResource RayMetinFircasi}" StrokeThickness="1.8"
                              Fill="Transparent" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <!-- Logo (2026-07-25): vektör marka — Tema.xaml SqlstLogo -->
                    <Image Source="{StaticResource SqlstLogo}" Width="24" Height="24" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding RayGenisMi, Converter={StaticResource BoolGorunurluk}}" />
                    <TextBlock Text="SQLST" Foreground="{DynamicResource RayMetinFircasi}"
                               FontWeight="Bold" FontSize="16.5" Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding RayGenisMi, Converter={StaticResource BoolGorunurluk}}" />
                </DockPanel>
                <!-- Alt yardımcılar (docked Bottom) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,10">
                    <!-- v22-S1 m.8: ayırıcı da palete bağlandı (eski indigo #2A2A55 sabiti Kor açıkta
                         açık kül rayda koyu lacivert bir çizgi olarak kalıyordu). -->
                    <Rectangle Height="1" Fill="{DynamicResource KenarFircasi}" Margin="14,0,14,8" />
                    <Button Style="{StaticResource RayOgesi}" Background="#6366F1" Tag="{StaticResource Ikon.Parcalar}"
                            Content="Kod parçaları" Click="Snippetler_Click"
                            ToolTip="Kısayolla genişleyen kod kalıpları (V5-S4)"
                            AutomationProperties.AutomationId="BtnSnippetler" />
                    <Button Style="{StaticResource RayOgesi}" Background="#64748B" Tag="{StaticResource Ikon.Kisayol}"
                            Content="Kısayollar" Click="Kisayollar_Click"
                            ToolTip="Klavye kısayolları kılavuzu (F1)"
                            AutomationProperties.AutomationId="BtnKisayollar" />
                    <Button Style="{StaticResource RayOgesi}" Background="#F43F5E" Tag="{StaticResource Ikon.Cikis}"
                            Content="Bağlantıyı değiştir" Click="BaglantiDegistir_Click"
                            ToolTip="Bağlantı ekranına dön (FG-1.9)"
                            AutomationProperties.AutomationId="BtnBaglantiDegistir" />
                </StackPanel>
                <!-- Büyük özellikler (kaydırılabilir). v19-S9 cila (kullanıcı bulgusu 2026-08-03):
                     ray kaydırıcısı AÇIK temada açık gri şerit olarak koyu ray ile içerik arasında
                     sırıtıyordu ("her şey kaymış" hissi) — ray hep koyu olduğundan kaydırıcı yerel
                     kaynakla palet-bağımsız saydamlaştırılır: zemin yok, yarı saydam beyaz tutamaç. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <SolidColorBrush x:Key="KaydiriciZeminFircasi" Color="Transparent" />
                        <SolidColorBrush x:Key="KaydiriciTutamacFircasi" Color="#40FFFFFF" />
                        <SolidColorBrush x:Key="KaydiriciTutamacUstuFircasi" Color="#66FFFFFF" />
                        <SolidColorBrush x:Key="KaydiriciTutamacBasiliFircasi" Color="#80FFFFFF" />
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="6" />
                            <Setter Property="MinWidth" Value="6" />
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="ÇALIŞMA" Foreground="{DynamicResource RayBaslikFircasi}" FontSize="10"
                                   FontWeight="Bold" Margin="16,2,0,4"
                                   Visibility="{Binding RayGenisMi, Converter={StaticResource BoolGorunurluk}}" />
                        <Button Style="{StaticResource RayOgesi}" Background="#4F46E5" Tag="{StaticResource Ikon.Arti}"
                                Content="Yeni Sorgu" Command="{Binding YeniSekmeCommand}"
                                ToolTip="Yeni sorgu sekmesi (Ctrl+N)"
                                AutomationProperties.AutomationId="BtnRayYeniSekme" />
                        <!-- 📂 Dosya Aç (v20-S14): .sql'i sekmede aç — Ctrl+S kaydedişinin aynası -->
                        <Button Style="{StaticResource RayOgesi}" Background="#D97706" Tag="{StaticResource Ikon.DosyaAc}"
                                Content="Dosya Aç" Click="DosyaAc_Click"
                                ToolTip="Bir .sql dosyasını sekmede aç (Ctrl+O) — pencereye sürükleyip bırakmak da açar; kodlama otomatik (BOM/UTF-8/Türkçe ANSI)"
                                AutomationProperties.AutomationId="BtnRayDosyaAc" />
                        <!-- "BÜYÜK ÖZELLİKLER" → "ÖZELLİKLER" (kullanıcı isteği 2026-08-08) -->
                        <TextBlock Text="ÖZELLİKLER" Foreground="{DynamicResource RayBaslikFircasi}" FontSize="10"
                                   FontWeight="Bold" Margin="16,9,0,4"
                                   Visibility="{Binding RayGenisMi, Converter={StaticResource BoolGorunurluk}}" />
                        <!-- Görsel Sorgu (v6): SQL ailesi, Mongo'da gizli -->
                        <Button Style="{StaticResource RayOgesi}" Background="#8B5CF6" Tag="{StaticResource Ikon.GorselSorgu}"
                                Content="Görsel Sorgu" Command="{Binding GorselSorguAcCommand}"
                                Visibility="{Binding GorselSorguGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Tabloları tuvale sürükle; ▶ Çalıştır sonucu aynı sekmede gösterir"
                                AutomationProperties.AutomationId="BtnGorselSorgu" />
                        <!-- 🪄 SP Sihirbazı (kullanıcı fikri 2026-07-31): giriş/çıkışlardan şema analiziyle SP taslağı -->
                        <Button Style="{StaticResource RayOgesi}" Background="#EAB308" Tag="{StaticResource Ikon.Yonetim}"
                                Content="SP Sihirbazı" Click="SpSihirbazi_Click"
                                Visibility="{Binding MotorMssqlMu, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Giriş/çıkış kolon adlarını ver: tablolar şemada bulunur, FK'lardan JOIN'lenir, CREATE PROCEDURE taslağı editörde açılır"
                                AutomationProperties.AutomationId="BtnSpSihirbazi" />
                        <!-- Plan v11-S7 rötuşunda editör araç çubuğuna GERİ döndü (kullanıcı isteği). -->
                        <!-- Veritabanı Haritası (v9): bağlı her motorda -->
                        <Button Style="{StaticResource RayOgesi}" Background="#06B6D4" Tag="{StaticResource Ikon.Harita}"
                                Content="Veritabanı Haritası" Command="{Binding HaritaAcCommand}"
                                Visibility="{Binding HaritaGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Şemayı ER-diyagramı olarak resmeder: tablolar kart, FK'ler bağ; PNG/SVG"
                                AutomationProperties.AutomationId="BtnHarita" />
                        <!-- Yönetim Paneli: SQL Server DMV / Mongo (V3 kapılama) -->
                        <Button Style="{StaticResource RayOgesi}" Background="#F43F5E" Tag="{StaticResource Ikon.Yonetim}"
                                Content="Yönetim Paneli" Command="{Binding TeshisAcCommand}"
                                Visibility="{Binding TeshisGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="SQL Server: eksik/kullanılmayan index, RCSI, pahalı sorgular · MongoDB: koleksiyonlar, index, işlemler"
                                AutomationProperties.AutomationId="BtnTeshis" />
                        <!-- 🔌 SOAP İstemcisi (v14-S2): WSDL → operasyon → zarf → çağrı -->
                        <Button Style="{StaticResource RayOgesi}" Background="#0891B2" Tag="{StaticResource Ikon.Soap}"
                                Content="SOAP İstemcisi" Click="SoapIstemci_Click"
                                Visibility="{Binding AsistanGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="WCF/SOAP servisini test et: WSDL ver → operasyonu seç → zarfı düzenle → gönder (SP değişikliğinin servise etkisini aynı araçta doğrula)"
                                AutomationProperties.AutomationId="BtnSoapIstemci" />
                        <!-- 🌐 REST İstemcisi (v20-S8): SOAP'ın kardeşi HTTP/REST test aracı -->
                        <Button Style="{StaticResource RayOgesi}" Background="#0D9488" Tag="{StaticResource Ikon.Rest}"
                                Content="REST İstemcisi" Click="RestIstemci_Click"
                                Visibility="{Binding AsistanGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="REST/HTTP API test et: method + URL + başlık/gövde + auth → gönder; JSON yanıtı renkli gör, ayrı pencerede aç, URL kopyala/aç, AI Yorumla"
                                AutomationProperties.AutomationId="BtnRestIstemci" />
                        <!-- 🔁 LINQ ⇄ SQL (v20-S11/S12): kendi çeviri motorlarımız — AI'sız, iki yön.
                             m.24: Mongo profilinde GİZLİ — SQL üretmez, orada anlamı yok. -->
                        <Button Style="{StaticResource RayOgesi}" Background="#2563EB" Tag="{StaticResource Ikon.Linq}"
                                Content="LINQ ⇄ SQL" Click="LinqSql_Click"
                                Visibility="{Binding MotorMongoMu, Converter={StaticResource TersBoolGorunurluk}}"
                                ToolTip="İki yönlü çeviri: C# LINQ → motorun SQL'i (şema+FK farkındalıklı JOIN'ler) ve T-SQL SELECT → C# LINQ — AI'sız, çevrimdışı, kendi motorumuz"
                                AutomationProperties.AutomationId="BtnLinqSql" />
                        <!-- ⏪ Geri Al Paketleri (V15-S4, BF-1): Güvenli Yazma COMMIT'lerinin eski hali; yalnız SQL Server -->
                        <Button Style="{StaticResource RayOgesi}" Background="#7C3AED" Tag="{StaticResource Ikon.GeriAl}"
                                Content="Geri Al" Click="GeriAl_Click"
                                Visibility="{Binding MotorMssqlMu, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Güvenli Yazma ile COMMIT ettiğin UPDATE/DELETE'lerin eski halini gösterir; tersine çeviren script'i üretir (uçuş kaydedici)"
                                AutomationProperties.AutomationId="BtnGeriAl" />
                        <!-- 📥 Excel/TXT İçe Aktar (v13-S2): dosyadan tabloya -->
                        <Button Style="{StaticResource RayOgesi}" Background="#16A34A" Tag="{StaticResource Ikon.IceAktar}"
                                Content="İçe Aktar" Click="IceAktar_Click"
                                Visibility="{Binding IceAktarGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Excel (.xlsx/.xls) ya da TXT/CSV dosyasını okuyup tabloya aktarır: önizle → eşle → INSERT"
                                AutomationProperties.AutomationId="BtnIceAktar" />
                        <!-- 📦 Paket Aktarım (v12-S2): SQL ailesinde; Mongo v12-S5 -->
                        <Button Style="{StaticResource RayOgesi}" Background="#F97316" Tag="{StaticResource Ikon.Paket}"
                                Content="Paket Aktarım" Click="PaketAktarim_Click"
                                Visibility="{Binding AktarimGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Kaynaktan hedef tabloya veri aktarımı (SSIS mantığı): tablo/sorgu → eşle → aktar"
                                AutomationProperties.AutomationId="BtnPaketAktarim" />
                        <!-- Karşılaştır -->
                        <Button Style="{StaticResource RayOgesi}" Background="#22C55E" Tag="{StaticResource Ikon.Karsilastir}"
                                Content="Karşılaştır" Click="Karsilastir_Click"
                                ToolTip="İki bağlantı arasında şema ve veri farkı"
                                AutomationProperties.AutomationId="BtnKarsilastir" />
                        <!-- Log Analizi: Mongo'da gizli -->
                        <Button Style="{StaticResource RayOgesi}" Background="#EAB308" Tag="{StaticResource Ikon.Log}"
                                Content="Log Analizi" Click="LogAnaliz_Click"
                                Visibility="{Binding LogAnalizGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Veritabanındaki exception/log tablosunu analiz eder: en çok tekrarlayanlar sırayla"
                                AutomationProperties.AutomationId="BtnLogAnaliz" />
                        <!-- 🔍 Profiler (v23-S1): YALNIZ MSSQL — Extended Events üstünde canlı izleme -->
                        <Button Style="{StaticResource RayOgesi}" Background="#0EA5E9" Tag="{StaticResource Ikon.Ara}"
                                Content="Profiler" Click="Profiler_Click"
                                Visibility="{Binding ProfilerGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Sunucudaki TÜM uygulamaların sorgu trafiğini canlı izler (SSMS Profiler karşılığı — Extended Events üstünde)"
                                AutomationProperties.AutomationId="BtnProfiler" />
                        <!-- 🔎 FTS (v23 S1+S2, K1): YALNIZ MSSQL — tam metin arama yardımcısı + kurulum sihirbazı -->
                        <Button Style="{StaticResource RayOgesi}" Background="#7C3AED" Tag="{StaticResource Ikon.Ara}"
                                Content="Full-Text" Click="Fts_Click"
                                Visibility="{Binding FtsGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Full-Text Search: CONTAINS/FREETEXT sorgu yardımcısı + index kurulum sihirbazı (kelime/önek/yakınlık/çekim — LIKE'tan kat kat hızlı)"
                                AutomationProperties.AutomationId="BtnFts" />
                        <!-- ⏱ SQL Agent (v23-S16, K1/K6): YALNIZ MSSQL — job izleme + başlat/durdur/aç-kapat -->
                        <Button Style="{StaticResource RayOgesi}" Background="#2563EB" Tag="{StaticResource Ikon.Saat}"
                                Content="SQL Agent" Click="Agent_Click"
                                Visibility="{Binding AgentGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="SQL Server Agent: job'ların durumu, son/sonraki koşu, geçmiş ve hata mesajları; başlat · durdur · aç/kapat · script olarak al"
                                AutomationProperties.AutomationId="BtnAgent" />
                        <!-- 🤖 Asistan (v11-S1, 2026-07-25; v22-S6): kendi ajanımızla (🏠 Yerel/Ollama)
                             şema-farkında yardım — "müşteri için en can alıcı nokta". -->
                        <Button Style="{StaticResource RayOgesi}" Background="#EC4899" Tag="{StaticResource Ikon.Robot}"
                                Content="AI Asistan" Command="{Binding AsistanAcCommand}"
                                Visibility="{Binding AsistanGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Yapay zeka asistanı: sorgu değerlendirme, doğal dilden sorgu, hata çözümü. Modele yalnız ŞEMA gider — satır verisi asla."
                                AutomationProperties.AutomationId="BtnAsistan" />
                        <!-- Metin ara (V5-S2): editör araç çubuğundan RAYA taşındı (#7, 2026-07-25).
                             Ray global — MetinAramaAc arama sekmesini SEÇİLİ DB nesne tanımlarında açar
                             (view/SP/fonksiyon; Mongo'da view+index). Motor kapısı: AramaGorunur. -->
                        <!-- 🔎 Veri Arama (kullanıcı onayı 2026-08-03, öneri 1): değer VERİDE aranır.
                             Özellik eşitliği: MSSQL+PG+MySQL (üretici ILehce ile motor-parametrik). -->
                        <Button Style="{StaticResource RayOgesi}" Background="#0D9488" Tag="{StaticResource Ikon.VeriAra}"
                                Content="Veri Arama" Click="VeriArama_Click"
                                Visibility="{Binding MotorScriptDestekli, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="Bir değeri (TC no, sicil, metin…) TÜM tabloların uygun kolonlarında arar — hangi tablolarda geçtiğini listeler, çift tıkla satırları açar"
                                AutomationProperties.AutomationId="BtnVeriArama" />
                        <!-- Ad "Metin ara"→"Kod Arama" (kullanıcı isteği 2026-08-03: daha anlaşılır olsun;
                             "Veri Arama" adı VERİ içinde arayan YENİ özelliğe verildi). -->
                        <Button Style="{StaticResource RayOgesi}" Background="#14B8A6" Tag="{StaticResource Ikon.Ara}"
                                Content="Kod Arama" Command="{Binding MetinAramaAcCommand}"
                                Visibility="{Binding AramaGorunur, Converter={StaticResource BoolGorunurluk}}"
                                ToolTip="KOD içinde arar — seçili veritabanının nesne tanımlarında: SQL motorlarında view/SP/fonksiyon gövdeleri, MongoDB'de view ve index tanımları. Tablo VERİSİ için '🔎 Veri Arama'yı kullanın."
                                AutomationProperties.AutomationId="BtnMetinAra" />
                        <!-- Görsele çevir v11-S7 rötuşunda editör araç çubuğuna GERİ döndü (kullanıcı isteği). -->
                        <!-- Find yardımcısı v12-S6'da editör araç çubuğuna taşındı (kullanıcı isteği
                             2026-07-26: "Biçimlendir'in yanına koyalım"). -->
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══ ÇALIŞMA ALANI ÜST BARI: bağlantı çipi (tıklanabilir) + arama/komut kutusu + tema -->
        <Border DockPanel.Dock="Top" Height="46" Background="{DynamicResource BaglamSeridiFircasi}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource KenarFircasi}">
            <DockPanel LastChildFill="False">
                <!-- Bağlantı çipi: TIKLANABİLİR → bağlantı ekranı -->
                <!-- v23-S14 klasik (B — Antrasit): çip zemini kalkar, metin antrasit bandın üstünde
                     BEYAZ; nokta gizlenir (metin zaten ⚡ ile başlar). Değerler STİLDE — yerel değer
                     tetikleyiciyi ezerdi. -->
                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,0,0" Padding="10,5"
                        Cursor="Hand" MouseLeftButtonUp="BaglantiRozeti_Tik"
                        ToolTip="Tıkla → bağlantı ekranına dön">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Background" Value="{DynamicResource VurguZeminFircasi}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0,5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BasariFircasi}"
                                 VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="BaglamMetni" FontWeight="SemiBold" FontSize="12" Text="Bağlantı yok">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BilgiMetinFircasi}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontSize" Value="12.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- Arama / komut kutusu: içerik-boyutlu (boşluk yok — kullanıcı bulgusu); tıkla ya da Ctrl+P -->
                <Button DockPanel.Dock="Left" Margin="12,0,0,0" Height="30" Cursor="Hand" VerticalAlignment="Center"
                        Padding="10,0" Background="{DynamicResource GirisZeminFircasi}"
                        BorderBrush="{DynamicResource KenarFircasi}"
                        Click="PaletKutusu_Click"
                        ToolTip="Her yere atla: nesne, sekme, komut ara (Ctrl+P)"
                        AutomationProperties.AutomationId="BtnPaletKutusu">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource AramaSimgesi}" Stroke="{DynamicResource VurguFircasi}" Margin="0,0,8,0" />
                        <TextBlock Text="Ara / komut…" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                        <Border Margin="14,0,0,0" BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="1"
                                CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+P" FontSize="9.5" Foreground="{DynamicResource SolukMetinFircasi}" />
                        </Border>
                    </StackPanel>
                </Button>
                <!-- Tema menüsü (v19-S9): tıklayınca açılır — Açık Tema ▸ 5 palet · Koyu Tema ▸ 5 palet.
                     Menü code-behind'da kurulur (seçili varyant ✓ işaretlenir); tercih kalıcıdır. -->
                <Button DockPanel.Dock="Right" Tag="{StaticResource Ikon.Tema}" Margin="0,0,10,0"
                        Click="TemaMenusu_Ac"
                        ToolTip="Tema — açık/koyu kip ve renk paleti seçimi (tercih kalıcıdır, geçiş anında uygulanır)"
                        AutomationProperties.AutomationId="BtnTema">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SeritIkonu}">
                            <Setter Property="Foreground" Value="{DynamicResource IkonAmber}" />
                            <Style.Triggers>
                                <!-- v23-S14 klasik: tek renk ikonlar koyu gri — antrasit bantta açık ton şart. -->
                                <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                                    <Setter Property="Foreground" Value="#CFD8DC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- v23-S14 klasik (B): bandın sağında beyaz "Bağlantıyı değiştir" — yalnız Antrasit'te
                     (diğer ailelerde bağlantı çipi + ray çıkış düğmesi aynı işi görür). -->
                <Button DockPanel.Dock="Right" Content="⏏ Bağlantıyı değiştir" Margin="0,0,8,0" Padding="10,2"
                        MinHeight="24" VerticalAlignment="Center" Click="BaglantiDegistir_Click"
                        Background="White" Foreground="#1E1E1E" BorderBrush="#CFD8DC"
                        ToolTip="Bağlantı ekranına dön" AutomationProperties.AutomationId="BtnBagliDegistirKlasik">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Durum}" AutomationProperties.AutomationId="LblDurum" />
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding GezginGenisligi, Mode=TwoWay}" MinWidth="0" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Nesne gezgini (FG-2.1–2.4) -->
            <DockPanel Grid.Column="0" Visibility="{Binding GezginGorunur, Converter={StaticResource BoolGorunurluk}}">
                <Grid DockPanel.Dock="Top" Margin="6,6,6,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox Padding="24,3,22,3"
                                 Text="{Binding Arama, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nesne ya da kolon adı ara — yazdıkça tüm türlerde VE kolon adlarında süzer (eşleşen kolon kalın gösterilir)"
                                 AutomationProperties.AutomationId="TxtArama" />
                        <!-- Kutuya gömülü büyüteç (vektör; kullanıcı bulgusu 2026-07-24: aramada büyüteç yoktu) -->
                        <Path Style="{StaticResource AramaSimgesi}" HorizontalAlignment="Left"
                              Stroke="{DynamicResource IkonTeal}" Margin="7,0,0,0" IsHitTestVisible="False" />
                        <!-- Kutuya gömülü temizle düğmesi (kullanıcı isteği): yalnız metin varken görünür -->
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,3,0" Padding="4,0" MinHeight="0" FontSize="10"
                                BorderThickness="0" Background="Transparent" Foreground="{DynamicResource SolukMetinFircasi}"
                                Command="{Binding AramayiTemizleCommand}" ToolTip="Aramayı temizle"
                                Visibility="{Binding Arama, Converter={StaticResource NullGizle}}"
                                AutomationProperties.AutomationId="BtnAramaTemizleKutu" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- ＋ Yeni veritabanı (kullanıcı isteği 2026-07-31) — yalnız CREATE DATABASE
                             üretebilen motorlarda görünür (MSSQL/PG/MySQL; Oracle/Mongo'da gizli). -->
                        <Button Content="＋" Margin="4,0,0,0" Padding="8,2"
                                Click="YeniVeritabani_Click" ToolTip="Yeni veritabanı oluştur"
                                Visibility="{Binding YeniVeritabaniDestekli, Converter={StaticResource BoolGorunurluk}}"
                                AutomationProperties.AutomationId="BtnYeniVeritabani" />
                        <Button Content="⟳" Margin="4,0,0,0" Padding="8,2"
                                Click="Yenile_Click" ToolTip="Şemayı yenile"
                                AutomationProperties.AutomationId="BtnYenile" />
                    </StackPanel>
                </Grid>
                <!-- Arama boşsa "eşleşme yok" (03 §6); temizleme kutudaki ✕ ile -->
                <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource UyariZeminFircasi}"
                        Visibility="{Binding AramaBos, Converter={StaticResource BoolGorunurluk}}">
                    <TextBlock Text="Eşleşme yok — ✕ ile aramayı temizleyin." Foreground="{DynamicResource UyariMetinFircasi}" FontSize="12" />
                </Border>
                <TreeView ItemsSource="{Binding KokDugumler}" BorderThickness="0" Margin="2,0,0,0"
                          VirtualizingPanel.IsVirtualizing="True"
                          MouseDoubleClick="Agac_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="Agac_MouseDown"
                          PreviewMouseMove="Agac_MouseMove"
                          SelectedItemChanged="Agac_SecimDegisti"
                          AutomationProperties.AutomationId="AgacGezgin">
                    <TreeView.ItemContainerStyle>
                        <!-- BasedOn şart: BasedOn'suz lokal implicit stil Tema.xaml'ı gölgeler (3. tur) -->
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding AcikMi, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <!-- TEK paylaşımlı sağ tık menüsü: düğüm başına menü örneği oluşturulmaz (perf);
                             DataContext açılış anında tıklanan düğümden gelir. -->
                        <ContextMenu x:Key="NesneMenusu"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     AutomationProperties.AutomationId="NesneMenusu">
                            <MenuItem Header="İlk 200 satır" Click="IlkNSatir_Click"
                                      Visibility="{Binding Tur, Converter={StaticResource TurGorunur}, ConverterParameter='Tablo,View,Koleksiyon'}"
                                      AutomationProperties.AutomationId="MenuIlkNSatir" />
                            <!-- Edit modu V4-S1'den beri SQL ailesinin DÖRT motorunda da çalışır;
                                 kapı artık lehçenin yetenek bayrağıdır (MongoDB'de kapalı). -->
                            <MenuItem Header="✏ Düzenle (ilk 1.000 satır)" Click="Duzenle_Click"
                                      AutomationProperties.AutomationId="MenuDuzenle">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.DuzenlemeGorunur" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>

                            <!-- Aşağıdakiler T-SQL script üretir → yalnız SQL Server'da görünür (V3 denetimi).
                                 Diğer motorlarda ya söz dizimi hatası verirlerdi ya da (ALTER) sessizce
                                 hiçbir şey yapmayan script üretirlerdi. -->
                            <MenuItem Header="SELECT script'i" Click="SelectScripti_Click"
                                      AutomationProperties.AutomationId="MenuSelectScript">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo,View">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorMssqlMu" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <!-- 🎨 v20-S4 (kullanıcı isteği 2026-08-05: "görsel sorguya in"): tabloyu Görsel Sorgu
                                 tasarımcısına indir — sürükle-bırakın menü karşılığı; yalnız SQL Server (görsel sorgu kapısı). -->
                            <MenuItem Header="🎨 Görsel sorguya ekle" Click="GorseleEkle_Click"
                                      ToolTip="Bu tabloyu Görsel Sorgu tuvaline koyarak tasarımcıyı aç (JOIN'leri görsel kur)"
                                      AutomationProperties.AutomationId="MenuGorseleEkle">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.GorselSorguGorunur" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <!-- 🔗 Bağımlılık Gezgini (2026-08-03): kim kullanıyor / neyi kullanıyor — AĞAÇ penceresi.
                                 Madde 2: MSSQL + PostgreSQL (pg_depend; fonksiyonlar ~metin eşleşmesi). -->
                            <MenuItem Header="🔗 Bağımlılık ağacı (kim kullanıyor?)" Click="Bagimliliklar_Click"
                                      AutomationProperties.AutomationId="MenuBagimliliklar">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo,View,StoredProcedure,Fonksiyon">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorBagimlilikDestekli" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <!-- 👁 v22-S3 (saha turu-3 m.1, kullanıcı: "tablo önizlemeyi sağ tıkla da koyalım"):
                                 editördeki Ctrl+hover önizlemesinin menü karşılığı — kolonlar + ilk 5 satır,
                                 sekme açmadan.
                                 v22-S4 (saha turu-4 m.2, kullanıcı: "önizleme butonu Mongo'da hiç çıkmasın,
                                 zaten yapılmıyor — sadece SQL'e özel yazmışız"): Koleksiyon LİSTEDEN ÇIKARILDI.
                                 Sebep dürüst: önizleme satırları lehçenin IlkNSatirSorgusu'ndan gelir, Mongo'da
                                 o yol yok — kart yalnız kolon listesiyle açılıyordu, yani yarım bir özellik. -->
                            <MenuItem Header="👁 Önizleme (kolonlar + ilk 5 satır)" Click="Onizleme_Click"
                                      ToolTip="Sekme açmadan bak: kolonlar (🔑 PK · 🔗 FK · tip) ve ilk 5 satır"
                                      AutomationProperties.AutomationId="MenuOnizleme">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo,View">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.BaglantiVar" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <!-- #11 (2026-07-29): tip-farkında çok satırlı örnek INSERT (identity/computed atlanır).
                                 Özellik eşitliği 2026-08-03: MSSQL+PG+MySQL (değer fonksiyonları motora göre). -->
                            <MenuItem Header="INSERT örneği" Click="InsertOrnegi_Click"
                                      AutomationProperties.AutomationId="MenuInsertOrnegi">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorScriptDestekli" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <!-- v20-S21 saha m.29: INSERT örneğinin UPDATE eşi — SET örnek değerlerle, WHERE PK'dan -->
                            <MenuItem Header="UPDATE örneği" Click="UpdateOrnegi_Click"
                                      AutomationProperties.AutomationId="MenuUpdateOrnegi">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorScriptDestekli" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <MenuItem Header="Çalıştır (EXEC iskeleti)" Click="SpCalistir_Click"
                                      AutomationProperties.AutomationId="MenuSpCalistir">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="StoredProcedure">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorMssqlMu" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <!-- 🔌 v14-S4: SP imzasından WCF sarmalayıcı kodu — sekmede açılır, kopyalanır -->
                            <MenuItem Header="🔌 Servis iskeleti üret (WCF)" Click="ServisIskeleti_Click"
                                      AutomationProperties.AutomationId="MenuServisIskeleti">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="StoredProcedure">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorMssqlMu" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <MenuItem Header="Değiştir (ALTER)" Click="NesneScripti_Click"
                                      AutomationProperties.AutomationId="MenuAlter">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="View,StoredProcedure,Fonksiyon">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorMssqlMu" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <!-- Script: CREATE ham tanımı gösterir (motor-nötr) — açık kalır -->
                            <MenuItem Header="Script: CREATE" Click="ScriptCreate_Click"
                                      Visibility="{Binding Tur, Converter={StaticResource TurGorunur}, ConverterParameter='View,StoredProcedure,Fonksiyon'}"
                                      AutomationProperties.AutomationId="MenuScriptCreate" />
                            <MenuItem Header="Script: DROP ve CREATE" Click="ScriptDropCreate_Click"
                                      AutomationProperties.AutomationId="MenuScriptDropCreate">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="View,StoredProcedure,Fonksiyon">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorMssqlMu" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <MenuItem Header="Script: CREATE TABLE" Click="ScriptCreateTable_Click"
                                      ToolTip="Kolonlar + PK + index'ler (FG-5.4)"
                                      AutomationProperties.AutomationId="MenuScriptCreateTable">
                                <MenuItem.Visibility>
                                    <MultiBinding Converter="{StaticResource TurVeMotor}" ConverterParameter="Tablo">
                                        <Binding Path="Tur" />
                                        <Binding Path="PlacementTarget.Tag.MotorMssqlMu" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    </MultiBinding>
                                </MenuItem.Visibility>
                            </MenuItem>
                            <MenuItem Header="🕘 Tarihçe" Click="Tarihce_Click"
                                      Visibility="{Binding Tur, Converter={StaticResource TurGorunur}, ConverterParameter='View,StoredProcedure,Fonksiyon'}"
                                      ToolTip="Bu araçla görülen yerel sürümler + karşılaştırma (Ö2)"
                                      AutomationProperties.AutomationId="MenuTarihce" />
                            <Separator Visibility="{Binding Tur, Converter={StaticResource TurGorunur}, ConverterParameter='Tablo,View'}" />
                            <MenuItem Header="Kolonları kopyala" Click="KolonlariKopyala_Click"
                                      Visibility="{Binding Tur, Converter={StaticResource TurGorunur}, ConverterParameter='Tablo,View'}"
                                      AutomationProperties.AutomationId="MenuKolonKopyala" />
                        </ContextMenu>
                        <HierarchicalDataTemplate DataType="{x:Type vm:GezginSistemKlasoru}" ItemsSource="{Binding Veritabanlari}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="▤" Foreground="{DynamicResource IkincilFircasi}" Margin="0,0,5,0"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource IkincilFircasi}" VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:GezginVeritabani}" ItemsSource="{Binding Gruplar}">
                            <StackPanel Orientation="Horizontal" Margin="0,2"
                                        ContextMenuOpening="MotorMenusu_Aciliyor">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <!-- 📤 Şema Kopyalama (2026-07-31): DB şemasını başka bağlantıya kur.
                                             v1 SQL Server'a özgü (tanımlar T-SQL) — diğer motorlarda gizli.
                                             v22-S1 (m.5): görünürlük Tag ile KODDA kurulur — ContextMenu popup
                                             ağacından "AncestorType=Window" bağlaması Window'u bulamıyordu. -->
                                        <MenuItem Header="📤 Şemayı başka bağlantıya kopyala…" Click="SemaKopyala_Click"
                                                  Tag="M:Mssql"
                                                  AutomationProperties.AutomationId="MenuSemaKopyala" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="▣" Foreground="{DynamicResource VurguFircasi}" Margin="0,0,5,0"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Ad}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MetinFircasi}" />
                                <TextBlock Text="{Binding Bilgi, StringFormat='  ({0})', TargetNullValue=''}"
                                           Foreground="{DynamicResource IkincilFircasi}" FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:GezginGrubu}" ItemsSource="{Binding Nesneler}">
                            <!-- Bölüm başlığı (Tasarım 1 · T3): mockup'taki gibi SOLUK etiket — göz nesne
                                 adlarına gitsin, başlıklar geri planda bölsün. -->
                            <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold" Margin="0,3,0,1"
                                       Foreground="{DynamicResource IkincilFircasi}" FontSize="11"
                                       Background="Transparent"
                                       ContextMenuOpening="TabloGrubuMenu_Acilyor"
                                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <!-- Yalnız "Tablolar" grubunda + MSSQL'de anlamlı; ContextMenuOpening diğer
                                     gruplarda/motorlarda menüyü iptal eder (boş menü çıkmasın). -->
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="➕ Tablo oluştur…" Click="TabloOlustur_Click"
                                                  ToolTip="Yeni tablo sihirbazı — kolonları girin, CREATE TABLE üretilip sekmede açılır (SQL Server)"
                                                  AutomationProperties.AutomationId="MenuTabloOlustur" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                        <!-- Nesne düğümü + paylaşımlı sağ tık menüsü (FG-2.6, 5.1, 5.6, 5.7) -->
                        <HierarchicalDataTemplate DataType="{x:Type c:SemaNesnesi}" ItemsSource="{Binding Kolonlar}">
                            <!-- Tag: menüye MainViewModel köprüsü (ContextMenu popup ağacındadır,
                                 Window'a RelativeSource ile ulaşamaz) — motor kapılaması için gerekli. -->
                            <StackPanel Orientation="Horizontal" AutomationProperties.AutomationId="AgacNesne"
                                        Background="Transparent" ContextMenu="{StaticResource NesneMenusu}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <TextBlock Text="{Binding Tur, Converter={StaticResource TurSimge}}"
                                           Margin="0,0,5,0" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <!-- Tür renkleri DynamicResource ile (03 §5): converter fırçayı bir kez
                                             çözüp donduruyordu — canlı tema takasında eski palette kalıyordu (3. tur) -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource IkincilFircasi}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tur}" Value="Tablo">
                                                    <Setter Property="Foreground" Value="{DynamicResource TabloFircasi}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tur}" Value="View">
                                                    <Setter Property="Foreground" Value="{DynamicResource ViewFircasi}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tur}" Value="StoredProcedure">
                                                    <Setter Property="Foreground" Value="{DynamicResource SpFircasi}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tur}" Value="Fonksiyon">
                                                    <Setter Property="Foreground" Value="{DynamicResource FonksiyonFircasi}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tur}" Value="Koleksiyon">
                                                    <Setter Property="Foreground" Value="{DynamicResource ViewFircasi}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TamAd}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MetinFircasi}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type c:SemaKolonu}">
                            <!-- v20-S4 kolon arama: aramayla eşleşen kolon KALIN (tabloyu neden gördün belli olsun) -->
                            <TextBlock Text="{Binding Gosterim}" Foreground="{DynamicResource IkincilFircasi}"
                                       FontFamily="{StaticResource KodYazisi}" FontSize="11" Background="Transparent"
                                       AutomationProperties.AutomationId="AgacKolon">
                                <TextBlock.FontWeight>
                                    <MultiBinding Converter="{StaticResource KolonEslesmeKalinlik}">
                                        <Binding Path="Ad" />
                                        <Binding Path="DataContext.Arama" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                    </MultiBinding>
                                </TextBlock.FontWeight>
                                <TextBlock.ContextMenu>
                                    <!-- v20-S10: kolonun FK bağları (kullanıcı fikri 2026-08-07) -->
                                    <ContextMenu>
                                        <MenuItem Header="🔗 Tüm bağlantılarını göster" Click="KolonBaglari_Click"
                                                  ToolTip="Bu kolonun yabancı anahtar bağları: nereyi işaret ediyor + onu kim işaret ediyor"
                                                  AutomationProperties.AutomationId="MenuKolonBaglari" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- Sorgu sekmeleri (S3, FG-3.1–3.5 + 3.12) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl x:Name="SekmeKontrolu" Grid.Row="0" Grid.RowSpan="2"
                            ItemsSource="{Binding Sekmeler}" SelectedItem="{Binding SeciliSekme}"
                            SelectionChanged="SekmeKontrolu_SecimDegisti"
                            ItemContainerStyle="{StaticResource BelgeSekmesi}"
                            AutomationProperties.AutomationId="SekmeAlani">
                    <!-- Yerleşim v2 (2026-07-24): sekme şeridi kendi satırında, "＋" son sekmenin
                         yanında (sağda). TabPanel sığmayınca SSMS/VS gibi ALT SATIRA SARAR —
                         hiçbir sekme gizlenmez (kullanıcı isteği). -->
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource SeritFircasi}"
                                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource KenarFircasi}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Tag="{StaticResource Ikon.Arti}" Margin="2,0,6,2"
                                                Foreground="{DynamicResource IkonYesil}"
                                                VerticalAlignment="Bottom" Height="26" Width="28"
                                                ToolTip="Yeni sorgu sekmesi (Ctrl+N)"
                                                Command="{Binding YeniSekmeCommand}"
                                                AutomationProperties.AutomationId="BtnYeniSekme">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SeritIkonu}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- v23-S14 klasik (B): metinli "＋ Yeni sekme (Ctrl+N)" düğmesi -->
                                        <Button DockPanel.Dock="Right" Content="＋ Yeni sekme (Ctrl+N)" Margin="2,3,6,3"
                                                Padding="10,1" MinHeight="24" VerticalAlignment="Center"
                                                Command="{Binding YeniSekmeCommand}"
                                                AutomationProperties.AutomationId="BtnYeniSekmeKlasik">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TabPanel IsItemsHost="True" Margin="0,0,0,0" />
                                    </DockPanel>
                                </Border>
                                <!-- v20-S21 saha m.30 ("sekme değişince grid en üste dönüyor"): tek
                                     ContentPresenter her geçişte görseli söküp YENİDEN kuruyordu —
                                     kaydırma/seçim/imleç sıfırlanıyordu. Artık her sekmenin görseli
                                     BİR KEZ kurulur, bu yuvada CANLI tutulur (gizle/göster) — konum
                                     korunur, geçiş hızlanır. Yönetim: SekmeIcerikleriniEsitle. -->
                                <Grid x:Name="SekmeIcerikYuvasi" />
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <!-- v20-S21 saha m.11/12/13: DockPanel + MinWidth → ✕ her sekmede SAĞ KENARDA
                                 sabit durur (kısa başlıkta yapışık değil); sağ tık menüsü kapatma/sabitleme.
                                 v22-S1 m.6: 📌 artık TIKLANABİLİR düğme — her sekmede soluk durur, tek tıkla
                                 sabitler/kaldırır; sabitken vurgu renginde ve ✕ gizlenir (kapatılamaz). -->
                            <DockPanel Background="Transparent" MinWidth="96" MaxWidth="220"
                                       LastChildFill="True">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="SekmeSabitDegistir_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="📌 Sekmeyi sabitle" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sabit}" Value="True">
                                                            <Setter Property="Header" Value="📌 Sabitlemeyi kaldır" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="✕ Kapat" InputGestureText="Ctrl+W"
                                                  Click="SekmeKapat_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sabit}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="Diğerlerini kapat" Click="DigerSekmeleriKapat_Click" />
                                        <MenuItem Header="Tümünü kapat" Click="TumSekmeleriKapat_Click" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <!-- Sağ kenar: sabit sekmede 📌, değilse ✕ (m.11 — hep sağa yaslı) -->
                                <Button DockPanel.Dock="Right" Content="✕" Margin="6,0,0,0" Padding="3,0"
                                        BorderThickness="0" Background="Transparent" Cursor="Hand"
                                        Foreground="{DynamicResource SolukMetinFircasi}"
                                        VerticalAlignment="Center" ToolTip="Sekmeyi kapat (Ctrl+W)"
                                        Click="SekmeKapat_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sabit}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- 📌 RAPTİYE DÜĞMESİ (v22-S1 saha turu-2 m.6, kullanıcı: "sabitlemeyi sağ tık
                                     olmadan raptiye ikonuyla yapalım"): her sekmede görünür, sabit DEĞİLKEN
                                     soluk (hover'da belirir), sabitken vurgu renginde ve dolu. Tek tıkla
                                     sabitler/kaldırır — sağ tık menüsü de aynı işleyiciyle duruyor.
                                     Opacity/ToolTip/Foreground LOCAL yazılmaz: local değer Style trigger'ını
                                     EZER (m.13'te 📌 bu yüzden hiç görünmüyordu) — hepsi Style'dan gelir. -->
                                <Button DockPanel.Dock="Right" Content="📌" Margin="6,0,0,0" Padding="2,0"
                                        FontSize="11" BorderThickness="0" Background="Transparent"
                                        Cursor="Hand" VerticalAlignment="Center"
                                        Click="SekmeSabitDegistir_Click"
                                        AutomationProperties.AutomationId="BtnSekmeSabitle">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Opacity" Value="0.35" />
                                            <Setter Property="ToolTip" Value="Sekmeyi sabitle — kapanmaz (Ctrl+W ve toplu kapatma atlar)" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Sabit}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Foreground" Value="{DynamicResource VurguFircasi}" />
                                                    <Setter Property="ToolTip" Value="Sabit sekme — sabitlemeyi kaldır" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Durum NOKTASI (Tasarım 1 · T2, 2026-07-24): simge (⏳✔✖■) yerine renkli
                                     nokta — yeşil tamam · kırmızı hata · sarı iptal · "çalışıyor" petrol NABIZ.
                                     Boşta hiç görünmez (yeni sekme temiz açılır). -->
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Durum}" Value="{x:Static vm:SekmeDurumu.Calisiyor}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource VurguFircasi}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="Nabiz">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0.25" Duration="0:0:0.55" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="Nabiz" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Durum}" Value="{x:Static vm:SekmeDurumu.Tamamlandi}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource BasariFircasi}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Durum}" Value="{x:Static vm:SekmeDurumu.Hata}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource TehlikeFircasi}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Durum}" Value="{x:Static vm:SekmeDurumu.IptalEdildi}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource UyariFircasi}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!-- Başlık DockPanel'in SON çocuğu: kalan alanı doldurur, uzun ad kırpılır
                                     (✕ böylece daima sağ kenarda kalır — m.11). -->
                                <TextBlock Text="{Binding Baslik}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Baslik}" />
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.Resources>
                        <!-- m.22 devamı: araç sekmesi — pencere içeriği sekmede barınır (AracSekmesiViewModel) -->
                        <DataTemplate DataType="{x:Type vm:AracSekmesiViewModel}">
                            <ContentPresenter Content="{Binding Icerik}" />
                        </DataTemplate>
                        <!-- Teşhis Merkezi (V2-S7): eksik/kullanılmayan index + RCSI + havuz -->
                        <DataTemplate x:Key="TeshisSetleri">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Baslik}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ZayifMetinFircasi}" Margin="4,6,4,2" />
                                <DataGrid ItemsSource="{Binding Gorunum}" IsReadOnly="True" AutoGenerateColumns="True"
                                          MaxHeight="280" EnableRowVirtualization="True"
                                          HeadersVisibility="Column" BorderThickness="0,1,0,1" />
                            </DockPanel>
                        </DataTemplate>
                        <!-- Genel motor Yönetim Paneli (V3): PostgreSQL/MySQL/Oracle — bölümleri lehçe verir -->
                        <DataTemplate DataType="{x:Type vm:LehceTeshisSekmesiViewModel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource KenarFircasi}"
                                        Background="{DynamicResource BilgiZeminFircasi}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="↻ Yenile" Padding="10,2"
                                                Command="{Binding YenileCommand}"
                                                AutomationProperties.AutomationId="BtnLehceTeshisYenile" />
                                        <ComboBox DockPanel.Dock="Right" Width="200" Margin="8,0"
                                                  ItemsSource="{Binding VeritabaniAdlari}"
                                                  SelectedItem="{Binding SecilenVeritabani}"
                                                  ToolTip="Veritabanına bağlı bölümler bu seçimi kullanır"
                                                  AutomationProperties.AutomationId="CmbLehceTeshisDb" />
                                        <TextBlock Text="{Binding SunucuBandi}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource BilgiMetinFircasi}"
                                                   AutomationProperties.AutomationId="LblLehceSunucuBandi" />
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource PanelZeminFircasi}"
                                        BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{Binding Bilgi}" FontSize="12" Foreground="{DynamicResource ZayifMetinFircasi}"
                                               AutomationProperties.AutomationId="LblLehceTeshisBilgi" />
                                </Border>
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3*" MinHeight="120" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2*" MinHeight="90" />
                                    </Grid.RowDefinitions>
                                <TabControl Grid.Row="0" ItemsSource="{Binding Bolumler}"
                                            AutomationProperties.AutomationId="LehceTeshisBolumleri">
                                    <TabControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Baslik}" />
                                        </DataTemplate>
                                    </TabControl.ItemTemplate>
                                    <TabControl.ContentTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Aciklama}" TextWrapping="Wrap"
                                                           Margin="6,6,6,2" FontSize="11.5"
                                                           Foreground="{DynamicResource ZayifMetinFircasi}" />
                                                <!-- "Bu alandan hangi bilgi takip edilecek?" (kullanıcı isteği 2026-07-19).
                                                     Açıklamadan AYRI bir bantta duruyor: açıklama bölümün ne olduğunu,
                                                     bu ise hangi kolona bakılacağını ve eşiği söyler. -->
                                                <Border DockPanel.Dock="Top" Margin="6,2,6,4" Padding="8,5" CornerRadius="3"
                                                        Background="{DynamicResource BilgiZeminFircasi}">
                                                    <TextBlock Text="{Binding Takip}" TextWrapping="Wrap" FontSize="11.5"
                                                               Foreground="{DynamicResource BilgiMetinFircasi}" />
                                                </Border>
                                                <Border DockPanel.Dock="Top" Margin="6,4" Padding="8,5"
                                                        Background="{DynamicResource UyariZeminFircasi}"
                                                        BorderBrush="{DynamicResource UyariKenarFircasi}" BorderThickness="1"
                                                        Visibility="{Binding HataVar, Converter={StaticResource BoolGorunurluk}}">
                                                    <TextBlock Text="{Binding Hata}" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource UyariMetinFircasi}" />
                                                </Border>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Setler}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </DataTemplate>
                                    </TabControl.ContentTemplate>
                                </TabControl>

                                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                                  Background="{DynamicResource KenarFircasi}" />

                                    <!-- Aktivite / Denetim (v10-S4): "kim ne iş yapmış" — dört motorda paylaşımlı bileşen -->
                                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="🧾 Aktivite / Denetim — bu araçtan yapılan sorgular (kim / ne türde / ne zaman)"
                                                   FontSize="11.5" FontWeight="SemiBold" Margin="2,0,2,4"
                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                        <ContentControl Content="{Binding DenetimIzi}" />
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                        <!-- MongoDB Yönetim Paneli (V3): SQL Server DMV panelinin Mongo karşılığı -->
                        <DataTemplate DataType="{x:Type vm:MongoTeshisSekmesiViewModel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource KenarFircasi}"
                                        Background="{DynamicResource BilgiZeminFircasi}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="↻ Yenile" Padding="10,2"
                                                Command="{Binding YenileCommand}"
                                                AutomationProperties.AutomationId="BtnMongoTeshisYenile" />
                                        <ComboBox DockPanel.Dock="Right" Width="200" Margin="8,0"
                                                  ItemsSource="{Binding VeritabaniAdlari}"
                                                  SelectedItem="{Binding SecilenVeritabani}"
                                                  ToolTip="Panelin baktığı veritabanı"
                                                  AutomationProperties.AutomationId="CmbMongoTeshisDb" />
                                        <TextBlock Text="{Binding SunucuBandi}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource BilgiMetinFircasi}"
                                                   AutomationProperties.AutomationId="LblMongoSunucuBandi" />
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource PanelZeminFircasi}"
                                        BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{Binding Bilgi}" FontSize="12" Foreground="{DynamicResource ZayifMetinFircasi}"
                                               AutomationProperties.AutomationId="LblMongoTeshisBilgi" />
                                </Border>
                                <TabControl Margin="4" AutomationProperties.AutomationId="MongoTeshisBolumleri">
                                    <!-- Takip notları (kullanıcı isteği 2026-07-19): her sekme hangi bilginin
                                         izleneceğini kendi başına söyler. -->
                                    <TabItem Header="Index kullanımı">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: '⚠ hiç kullanılmadı' işaretli satırlar (Kullanım = 0) — en üstte toplanırlar. Mongo'da her index her yazmada güncellenir ve BELLEKTE yer tutar; okunmayan index saf maliyettir. SİLMEDEN ÖNCE 'Sayaç başlangıcı' sütununa bakın: sayaç sunucunun son açılışından beri sayar, tarih yakınsa ayda bir koşan bir iş henüz görülmemiş olabilir. _id index'i silinemez, onu dikkate almayın." />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding IndexSetleri}" ItemTemplate="{StaticResource TeshisSetleri}"
                                                              AutomationProperties.AutomationId="MongoIndexSetleri" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="Koleksiyonlar">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: (1) 'Index (MB)' ile 'Veri (MB)' oranı — index toplamı veriye yaklaşıyorsa fazla index taşıyorsunuz demektir; 'Index kullanımı' sekmesiyle birlikte okuyun. Mongo'da index'lerin çalışma kümesi BELLEĞE SIĞMALIDIR, sığmazsa performans sert düşer. (2) 'Depolama (MB)' ile 'Veri (MB)' arasındaki büyük fark: çok silme görmüş koleksiyonda yer geri verilmemiştir. (3) Beklenmedik biçimde büyüyen koleksiyonlar — TTL index'i unutulmuş log/oturum koleksiyonları en sık çıkan sürprizdir." />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding KoleksiyonSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="Veritabanı özeti">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: Tek satırlık toplam — 'bu veritabanı ne kadar büyük?' sorusunun ucuz cevabıdır (tek komut; koleksiyon dökümü ise koleksiyon başına ayrı komut çalıştırır). Zaman içinde izlenecek iki değer: toplam boyutun BÜYÜME HIZI ve 'Index boyutu (MB)'nin sunucu belleğine oranı. Ayrıntı için 'Koleksiyonlar' sekmesine geçin — burası özet, orası dökümdür." />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding OzetSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="Çalışan işlemler">
