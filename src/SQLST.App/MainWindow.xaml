                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: 'Süre (sn)' sütunu büyük olan işlemler ve 'Durum' sütununda kilit bekleyenler. Uzun süren bir işlem çoğu zaman index'siz bir sorgunun tüm koleksiyonu taramasıdır — 'Ad alanı' hangi koleksiyon olduğunu söyler, oradan 'Index kullanımı' sekmesine bakın. Anlık bir görüntüdür: yenilediğinizde liste tamamen değişebilir, o yüzden tek bir bakışa değil TEKRAR EDEN desene güvenin." />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding IslemSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <!-- m.26 fikir 5+10: system.profile'dan index önerileri + yavaş sorgu geçmişi -->
                                    <TabItem Header="Index önerileri / Yavaş sorgular"
                                             AutomationProperties.AutomationId="MongoProfilSekmesi">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: Üstteki liste, GERÇEKTEN çalışmış ve index KULLANMAMIŞ (COLLSCAN) sorgulardan üretilen index önerileridir — 'Toplam ms' en çok zaman yiyen desendir, önce ona bakın. Öneriler ÇALIŞTIRILMAZ: komutu kopyalayıp kendi kontrolünüzle koşarsınız (her index yazma maliyeti ve bellek demektir). Alt liste ham yavaş sorgu geçmişidir: 'İncelenen' ile 'Dönen' arasındaki uçurum index'sizliğin en net işaretidir. Kaynak system.profile'dır; profiler kapalıysa bant bunu ve açma komutunu söyler." />
                                            </Border>
                                            <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource UyariZeminFircasi}"
                                                    BorderBrush="{DynamicResource UyariKenarFircasi}" BorderThickness="1"
                                                    Visibility="{Binding ProfilBandi, Converter={StaticResource DegerVarsaGorunur}}">
                                                <TextBlock Text="{Binding ProfilBandi}" TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource UyariMetinFircasi}"
                                                           AutomationProperties.AutomationId="LblMongoProfilBandi" />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ProfilSetleri}" ItemTemplate="{StaticResource TeshisSetleri}"
                                                              AutomationProperties.AutomationId="MongoProfilSetleri" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <!-- Aktivite / Denetim (v10-S4): bu araçtan yapılan işler (kim/ne türde) — paylaşımlı bileşen -->
                                    <TabItem Header="Aktivite / Denetim">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="KİM NE İŞ YAPMIŞ — bu araçtan (SQLST) çalıştırılan komutları kim/ne türde/ne zaman gösterir. MongoDB'de 'çalışan işlemler' sekmesi ŞU ANKİ etkinliği, bu sekme ise geçmiş denetim izini verir." />
                                            </Border>
                                            <ContentControl Content="{Binding DenetimIzi}" />
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:TeshisSekmesiViewModel}">
                            <DockPanel>
                                <!-- Uptime kapısı (R1.1 kural 2): zorunlu bant -->
                                <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource KenarFircasi}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BilgiZeminFircasi}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UptimeGuvenilmez}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource FarkSilinenZeminFircasi}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="↻ Yenile" Padding="10,2"
                                                Command="{Binding YenileCommand}"
                                                AutomationProperties.AutomationId="BtnTeshisYenile" />
                                        <!-- Metin rengi zemine EŞLENİR: koyu temada kalıtımla gelen renk
                                             bilgi/uyarı zemininde okunmuyordu (kullanıcı bulgusu 2026-07-18). -->
                                        <TextBlock Text="{Binding UptimeBandi}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   FontSize="12" AutomationProperties.AutomationId="LblUptimeBandi">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BilgiMetinFircasi}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UptimeGuvenilmez}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TehlikeFircasi}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource PanelZeminFircasi}"
                                        BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{Binding Bilgi}" FontSize="12" Foreground="{DynamicResource ZayifMetinFircasi}"
                                               AutomationProperties.AutomationId="LblTeshisBilgi" />
                                </Border>
                                <TabControl Margin="4" AutomationProperties.AutomationId="TeshisBolumleri">
                                    <TabItem Header="Eksik indexler">
                                        <DockPanel>
                                            <!-- "Bu alandan hangi bilgi takip edilecek?" (kullanıcı isteği 2026-07-19) -->
                                            <Border DockPanel.Dock="Top" Margin="4,4,4,0" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: Skoru en yüksek ilk birkaç satır + 'Kullanım' sütunu. Skor tek başına anlam taşımaz, YALNIZ SIRALAMA içindir — 'çok sorgu bundan etkileniyor' demektir, 'bu index'i aç' demez. Asıl bakılacak yer 'Örtüşme analizi' sütunudur: mevcut bir index'i genişletmek çoğu zaman yeni index açmaktan iyidir, çünkü her yeni index her INSERT/UPDATE'e maliyet bindirir. DİKKAT: bu liste optimizer'ın DİLEK LİSTESİDİR, tasarım önerisi değil — sunucu yeniden başlayınca sıfırlanır ve kolon sırasını hep doğru bilmez." />
                                            </Border>
                                            <DockPanel DockPanel.Dock="Top" Margin="4">
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SolukMetinFircasi}"
                                                           Text="çift tık → script'i sekmeye aç (İNCELE, çalıştırma otomatik değil)" />
                                                <CheckBox Content="düşük güçlüleri de göster" IsChecked="{Binding DusukleriGoster}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Skor yalnız sıralama içindir; düşük kova (&lt; 500k) varsayılan gizli"
                                                          AutomationProperties.AutomationId="ChkDusukler" />
                                            </DockPanel>
                                            <DataGrid ItemsSource="{Binding EksikIndexler}" IsReadOnly="True"
                                                      AutoGenerateColumns="False" EnableRowVirtualization="True"
                                                      HeadersVisibility="Column" BorderThickness="0,1,0,1"
                                                      MouseDoubleClick="TeshisEksik_CiftTik"
                                                      AutomationProperties.AutomationId="GridEksikIndex">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Soluk}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Güç" Binding="{Binding GucMetni}" Width="60" />
                                                    <DataGridTextColumn Header="Veritabanı" Binding="{Binding Veritabani}" Width="110" />
                                                    <DataGridTextColumn Header="Tablo" Binding="{Binding Tablo}" Width="200" />
                                                    <DataGridTextColumn Header="Anahtar kolonlar" Binding="{Binding Anahtar}" Width="180" />
                                                    <DataGridTextColumn Header="INCLUDE" Binding="{Binding Include}" Width="140" />
                                                    <DataGridTextColumn Header="Kullanım" Binding="{Binding Kullanim}" Width="80" />
                                                    <DataGridTextColumn Header="Son kullanım" Binding="{Binding SonKullanim}" Width="120" />
                                                    <DataGridTextColumn Header="Örtüşme analizi" Binding="{Binding OrtusmeNotu}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="Kullanılmayan indexler">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Margin="4" FontSize="11.5" Foreground="{DynamicResource UyariMetinFircasi}" TextWrapping="Wrap"
                                                       Text="⚠ Restart sayaçları sıfırlar; 'hiç satır yok' ≠ kullanılmıyor. Unique/PK ve FK öncü kolonlu index'ler aday DIŞI. Öneri DISABLE'dır (geri almak kolay) — çift tık script'i sekmeye açar." />
                                            <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: 'Güncelleme (maliyet)' sütunu YÜKSEK olan satırlar — Okuma zaten 0'dır, asıl bilgi index'in ne kadar BEDEL ödettiğidir. Güncellemesi düşük, hiç okunmayan bir index zaten neredeyse bedavadır; acele etmeyin. SİLMEDEN ÖNCE: sayaç sunucunun son açılışından beri sayar (üstteki uyarı) — ay sonu/yıl sonu raporları henüz çalışmamış olabilir. En az bir tam iş döngüsü geçmeden karar vermeyin ve DROP değil DISABLE ile başlayın: geri almak tek komuttur." />
                                            </Border>
                                            <DataGrid ItemsSource="{Binding Kullanilmayanlar}" IsReadOnly="True"
                                                      AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0,1,0,1"
                                                      MouseDoubleClick="TeshisKullanilmayan_CiftTik"
                                                      AutomationProperties.AutomationId="GridKullanilmayan">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tablo" Binding="{Binding Tablo}" Width="240" />
                                                    <DataGridTextColumn Header="Index" Binding="{Binding Ad}" Width="240" />
                                                    <DataGridTextColumn Header="Okuma" Binding="{Binding Okuma}" Width="90" />
                                                    <DataGridTextColumn Header="Güncelleme (maliyet)" Binding="{Binding Guncelleme}" Width="140" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="RCSI paneli">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8" Background="{DynamicResource UyariZeminFircasi}" BorderBrush="{DynamicResource UyariKenarFircasi}" BorderThickness="1">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource UyariMetinFircasi}"
                                                           Text="RCSI tek tuşla AÇILMAZ (R1.5). Riskler: tempdb version store yükü (+14 bayt/satır), check-then-act desenlerinde lost update, watermark'lı ETL'lerde satır atlama; koddaki NOLOCK hint'leri RCSI'yi bypass eder. Aşamalı geçiş: önce ALLOW_SNAPSHOT_ISOLATION + 1 hafta izleme, sonra RCSI (tek aktif bağlantı penceresi)." />
                                            </Border>
                                            <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP: Veritabanı başına 'is_read_committed_snapshot_on' sütunu. Bu bir İZLEME paneli değil, KARAR ekranıdır: her veritabanı için bir kez sorulur ve cevap yıllarca değişmez, o yüzden düzenli takip gerektirmez. Asıl soru şu: kodunuzda NOLOCK kullanıyor musunuz? Kullanıyorsanız sebebi büyük olasılıkla RCSI'nin KAPALI olmasıdır — NOLOCK kirli okuma yapar (aynı satırı iki kez ya da hiç görebilirsiniz), RCSI ise okuyucuyu bloklamadan TUTARLI veri verir. Yani doğru çözüm genelde NOLOCK değil, bu sütunu ON yapmaktır — ama yukarıdaki riskleri okuyup aşamalı geçiş script'iyle." />
                                            </Border>
                                            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                                                <Button DockPanel.Dock="Right" Content="📜 Aşamalı geçiş script'ini sekmeye aç" Padding="8,2"
                                                        Command="{Binding RcsiScriptiAcCommand}"
                                                        AutomationProperties.AutomationId="BtnRcsiScript" />
                                                <ComboBox Width="180" ItemsSource="{Binding VeritabaniAdlari}"
                                                          SelectedItem="{Binding SecilenVeritabani}" />
                                            </DockPanel>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding RcsiSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="Havuz">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP — bu sekme 'sunucuda genel olarak ne oluyor?' sorusuna bakar, dört ayrı liste dört ayrı şey söyler: (1) EN PAHALI SORGULAR: toplam CPU'ya göre sıralıdır, yani tek çalışışı yavaş olan değil, SUNUCUYA EN ÇOK YÜK BİNDİREN sorgular üsttedir — saniyede yüz kez koşan 'hızlı' bir sorgu buraya çıkabilir ve iyileştirilince en çok kazandıran odur. Çalışma sayısı ile ortalamayı birlikte okuyun. (2) BAĞLANTILAR: bir uygulamadan beklenmedik biçimde çok bağlantı varsa havuz sızıntısı olabilir. (3) SON TAM YEDEKLER: en çok gözden kaçan satır budur — tarihi ESKİ ya da BOŞ olan veritabanı korumasızdır; haftada bir bakmaya değer tek liste budur. (4) TABLO BOYUTLARI: yer sorununda nereden başlanacağını söyler. DİKKAT: sorgu istatistikleri plan önbelleğinden gelir — sunucu yeniden başlayınca ya da önbellek temizlenince sıfırlanır." />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding HavuzSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <!-- v22-S1 (saha turu-2 m.14, kullanıcı: "index önerileri ve yavaş sorgular
                                         alanı SQL'de neden yok, olması gerekiyor"): Mongo panelindeki
                                         "Index önerileri / Yavaş sorgular" sekmesinin SQL karşılığı.
                                         Index önerileri SQL'de zaten "Eksik indexler"/"Kullanılmayan
                                         indexler" sekmelerinde; eksik olan YAVAŞ SORGULAR'dı. -->
                                    <TabItem Header="Yavaş sorgular"
                                             AutomationProperties.AutomationId="YavasSorgularSekmesi">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="İki liste iki ayrı soruya bakar: (1) EN YAVAŞ — tek çalışışı en uzun süren sorgular (ortalama süreye göre); kullanıcının 'ekran kilitlendi' dediği yer genelde buradadır. (2) TOPLAM SÜREYİ EN ÇOK TÜKETEN — tek başına hızlı ama çok koşan sorgular; sunucu genelinde kazanç burada saklıdır. Ortalama ile çalışma sayısını BİRLİKTE okuyun. Kaynak plan önbelleğidir (sys.dm_exec_query_stats): sunucu yeniden başlayınca ya da önbellek temizlenince sayaçlar SIFIRLANIR; üstteki uptime bandı bu yüzden önemlidir. Yavaş bir sorgunun sebebi çoğu kez eksik index'tir — 'Eksik indexler' sekmesi öneriyi CREATE INDEX script'iyle verir." />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding YavasSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <!-- Bakım (V5-S3): tempdb şişmesi · bloklama ZİNCİRİ · istatistik tazeliği.
                                         Hepsi ucuz DMV okumasıdır, panel yenilemesinde gelir. -->
                                    <TabItem Header="Bakım">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Margin="4" Padding="8" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="Bu bölümler seçili veritabanına bakar (üstteki DB seçicisi). Bloklama sorusunun tek adresi burasıdır: asıl suçlu genelde KÖK bloklayandır ve çoğu zaman UYKUDADIR — açık işlem tutup bekleyen uygulama hiçbir sorgu çalıştırmadığı için 'çalışan sorgu' listelerinde hiç görünmez. İstatistik tazeliği, execution plan'daki tahmin/gerçek sapmalarının bir numaralı kök nedenidir." />
                                            </Border>
                                            <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="TAKİP — dört liste, dört ayrı soru: (1) TEMPDB DAĞILIMI: tempdb dolduğunda 'kim doldurdu?' sorusunun cevabı. Kullanıcı nesneleri mi (geçici tablolar), iç nesneler mi (sıralama/hash — sorgu belleğe sığmıyor), yoksa version store mu (RCSI/snapshot açıkken uzun süren AÇIK İŞLEM eski satır sürümlerini biriktirir) — üçü üç ayrı sorundur, çözümleri de farklıdır. (2) EN ESKİ AÇIK İŞLEMLER: süresi dakikalar mertebesine çıkan satır hem kilit tutar hem log'un kesilmesini engeller. (3) BLOKLAMA ZİNCİRİ: 'derinlik = 0' satırı KÖKTÜR, müdahale edilecek oturum odur — bekleyenler kurbandır. Durumu 'sleeping' çıkarsa sorumlu, COMMIT yapmadan bekleyen uygulamadır. (4) İSTATİSTİK TAZELİĞİ: 'yaş (gün)' ve değişen satır oranı yüksek olanlar. Bir sorgu dün hızlıyken bugün yavaşladıysa ve planında tahmin/gerçek farkı büyükse, önce buraya bakın — çözüm ucuzdur: UPDATE STATISTICS." />
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding BakimSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <!-- Aktivite / Denetim (v10-S3): A = denetim izi (kim ne iş yapmış — bu araçtan),
                                         B = canlı aktivite (şu an kim ne çalıştırıyor). -->
                                    <TabItem Header="Aktivite / Denetim">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="3*" MinHeight="120" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="2*" MinHeight="90" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Margin="4" Padding="8,5" CornerRadius="3"
                                                    Background="{DynamicResource BilgiZeminFircasi}">
                                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                           Text="KİM NE İŞ YAPMIŞ — üstteki DENETİM İZİ bu araçtan (SQLST) çalıştırılan sorguları kim/ne türde/ne zaman/sonuç olarak gösterir. Alttaki CANLI AKTİVİTE ise sunucuda ŞU AN kim bağlı ve ne çalıştırıyor. Dürüst sınır: tarihsel 'kim hangi satırı değiştirdi' ancak veritabanında denetim (Audit/CDC/trigger) kuruluysa bilinir — bu araç sonradan uyduramaz." />
                                            </Border>

                                            <!-- A = denetim izi: paylaşımlı DenetimIziViewModel şablonu (dört motorda ortak) -->
                                            <ContentControl Grid.Row="1" Content="{Binding DenetimIzi}" />

                                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                                                          Background="{DynamicResource KenarFircasi}" />

                                            <!-- B = canlı aktivite (SQL Server oturumları) -->
                                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding AktiviteSetleri}" ItemTemplate="{StaticResource TeshisSetleri}" />
                                            </ScrollViewer>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </DataTemplate>

                        <!-- Denetim izi (v10-S4): PAYLAŞIMLI şablon — SQL Server, diğer SQL motorları ve
                             MongoDB yönetim panellerinin hepsi bunu ContentControl ile gösterir. -->
                        <DataTemplate DataType="{x:Type vm:DenetimIziViewModel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="4,4,4,4">
                                    <TextBlock DockPanel.Dock="Left" Text="Denetim izi:" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <CheckBox DockPanel.Dock="Right" Content="Yalnız yazma" VerticalAlignment="Center"
                                              Margin="8,0,0,0" IsChecked="{Binding YalnizYazma}"
                                              ToolTip="Yalnız INSERT/UPDATE/DELETE/DDL"
                                              AutomationProperties.AutomationId="ChkDenetimYazma" />
                                    <Button DockPanel.Dock="Right" Content="⭳ CSV" Padding="8,2"
                                            Click="DenetimCsv_Click"
                                            ToolTip="Görünen denetim kayıtlarını CSV'ye aktar"
                                            AutomationProperties.AutomationId="BtnDenetimCsv" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Bilgi}" VerticalAlignment="Center"
                                               Margin="8,0" Foreground="{DynamicResource SolukMetinFircasi}" FontSize="11.5" />
                                    <TextBox VerticalContentAlignment="Center" Padding="4,3"
                                             Text="{Binding Suzgec, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Kullanıcı / tür / veritabanı / SQL içinde ara"
                                             AutomationProperties.AutomationId="TxtDenetimSuzgec" />
                                </DockPanel>
                                <!-- v22-S3 saha turu-3 m.2 (kullanıcı: "gridi sağa doğru kaydırabileyim ve çift
                                     tıklayınca sorguyu görebilmem için pencere açılsın, normal gridimizde olduğu gibi").
                                     SQL kolonu ESKİDEN Width="*" idi: yıldız kolon artan yeri yuttuğu için grid hiç
                                     taşmıyor, dolayısıyla yatay kaydırma çubuğu ASLA çıkmıyordu — sabit genişliğe
                                     alındı; kolonlar kullanıcı tarafından yeniden boyutlanabilir. -->
                                <DataGrid ItemsSource="{Binding Kayitlar}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                          EnableRowVirtualization="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          MouseDoubleClick="DenetimGrid_CiftTik"
                                          ToolTip="Çift tık: kaydın tam SQL'ini ayrı pencerede aç"
                                          AutomationProperties.AutomationId="DenetimGrid">
                                    <DataGrid.Columns>
                                        <!-- 155: "dd.MM.yyyy HH:mm:ss" tam sığsın — 140'ta saniye kesiliyordu (m.2) -->
                                        <DataGridTextColumn Header="Zaman" Binding="{Binding Zaman}" Width="155" />
                                        <DataGridTextColumn Header="Kullanıcı" Binding="{Binding Kullanici}" Width="150" />
                                        <DataGridTextColumn Header="İşlem" Binding="{Binding Tur}" Width="95" />
                                        <DataGridTextColumn Header="Veritabanı" Binding="{Binding Veritabani}" Width="110" />
                                        <DataGridTemplateColumn Header="Durum" Width="80" SortMemberPath="Durum">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SonucRozeti}" Tag="{Binding Durum, Converter={StaticResource RozetTuru}}">
                                                        <TextBlock Text="{Binding Durum}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Süre(ms)" Binding="{Binding SureMs}" Width="70" />
                                        <DataGridTextColumn Header="Satır" Binding="{Binding SatirSayisi}" Width="60" />
                                        <DataGridTextColumn Header="SQL" Binding="{Binding SqlKisa}" Width="900">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="ToolTip" Value="{Binding Sql}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </DataTemplate>
                        <!-- 🤖 AI Asistan sekmesi (v11-S7 SOHBET arayüzü, 2026-07-25): balonlar ortada
                             dar sütunda (kullanıcı sağda, asistan solda), giriş kutusu ALTTA.
                             İstem önizleme kaldırıldı (kullanıcı: gerek yok). -->
                        <DataTemplate DataType="{x:Type vm:AsistanSekmesiViewModel}">
                            <DockPanel>
                                <!-- ALT: durum + giriş çubuğu (sohbet düzeni) -->
                                <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource KenarFircasi}"
                                        Background="{DynamicResource PanelZeminFircasi}">
                                    <DockPanel MaxWidth="900">
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Bilgi}" FontSize="11.5"
                                                   Margin="2,0,0,6" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SolukMetinFircasi}"
                                                   AutomationProperties.AutomationId="LblAsistanBilgi" />
                                        <!-- VerticalAlignment=Center ŞART (saha m.6): DockPanel, çok satırlı kutu
                                             büyüyünce dock'lu ögeleri de DİKEYDE geriyordu — AI Sor devleşiyordu. -->
                                        <Button DockPanel.Dock="Right" Content="■" Padding="8,3" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding IptalCommand}" IsEnabled="{Binding Mesgul}"
                                                ToolTip="İsteği iptal et" AutomationProperties.AutomationId="BtnAsistanIptal" />
                                        <Button DockPanel.Dock="Right" Padding="14,3" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BirincilDugme}"
                                                Command="{Binding SorCommand}"
                                                AutomationProperties.AutomationId="BtnAsistanSor">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Renk düğmenin Foreground'undan (v23-S14 klasik düzende düğme dolgusuz). -->
                                                <Path Data="{StaticResource Ikon.Robot}" Stretch="Uniform" Width="14" Height="14"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" Fill="Transparent"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="AI Sor" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                        <CheckBox DockPanel.Dock="Right" Content="Editördeki sorguyu ekle" Margin="10,0,0,0"
                                                  VerticalAlignment="Center" IsChecked="{Binding EditordekiSorguyuEkle}"
                                                  ToolTip="Açıkken: son çalıştığın sorgu sekmesindeki metin soruyla birlikte gider"
                                                  AutomationProperties.AutomationId="ChkAsistanSorguEkle" />
                                        <!-- Çok satırlı (kullanıcı isteği 2026-08-10: çok satırlı sorgu yapıştırınca tek satıra
                                             düşüyordu → AcceptsReturn ile yapıştırma korunur). Enter GÖNDERİR (KeyBinding), Shift+Enter
                                             yeni satır (modifiersiz Enter keybinding'e takılmaz), MaxHeight'te kaydırır. -->
                                        <TextBox Text="{Binding Soru, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="34" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top" Padding="8,6"
                                                 ToolTip="Sorunu yaz — Enter gönderir, Shift+Enter yeni satır; çok satırlı sorgu yapıştırabilirsin"
                                                 AutomationProperties.AutomationId="TxtAsistanSoru">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SorCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                </Border>
                                <!-- ORTA: sohbet balonları -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10">
                                    <!-- v22-S5 (kullanıcı: "balonlar ekranın ortasında gibi, sola sağa
                                         yaslayalım"): kapsayıcı ESKİDEN MaxWidth=900 + Center idi —
                                         balonlar zaten sola/sağa hizalıydı ama o dar sütunun İÇİNDE
                                         hizalandığı için geniş ekranda hepsi ortada duruyordu. Kapsayıcı
                                         artık tam genişlikte; balonlar pencerenin gerçek kenarlarına
                                         yaslanır. Okunabilirlik balonun kendi MaxWidth'i (680) ile
                                         korunur — satırlar sonsuz uzamaz. -->
                                    <ItemsControl ItemsSource="{Binding Mesajlar}"
                                                  HorizontalAlignment="Stretch" Margin="16,0"
                                                  AutomationProperties.AutomationId="AsistanMesajlar">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Balon" CornerRadius="10" Padding="12,8" Margin="12,4"
                                                        MaxWidth="680" HorizontalAlignment="Left"
                                                        Background="{DynamicResource PanelZeminFircasi}"
                                                        BorderThickness="1" BorderBrush="{DynamicResource KenarFircasi}">
                                                    <StackPanel>
                                                        <!-- Bekleme satırı (yalnız Dusunuyor=true): AI logomuz + yanıp sönen "düşünüyor…"
                                                             + v22-S6 SANİYE SAYACI. Nabız artık YALNIZ NabizGrubu'na uygulanır: sayaç da
                                                             yanıp sönseydi okunması zorlaşırdı — oysa sayacın tek işi "takılmadı, çalışıyor"
                                                             kanıtını NET göstermek (kullanıcı bulgusu: "cevap vermiyor"). -->
                                                        <StackPanel x:Name="DusunuyorSatir" Orientation="Horizontal" Visibility="Collapsed">
                                                            <StackPanel x:Name="NabizGrubu" Orientation="Horizontal">
                                                                <Path Data="{StaticResource Ikon.Robot}" Stretch="Uniform" Width="16" Height="16"
                                                                      Stroke="{DynamicResource VurguFircasi}" StrokeThickness="1.8" Fill="Transparent"
                                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      VerticalAlignment="Center" />
                                                                <TextBlock Text="düşünüyor…" Margin="9,0,0,0" VerticalAlignment="Center"
                                                                           FontStyle="Italic" Foreground="{DynamicResource SolukMetinFircasi}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       FontFamily="Consolas" FontSize="12"
                                                                       Foreground="{DynamicResource SolukMetinFircasi}"
                                                                       AutomationProperties.AutomationId="AsistanBekleyenSure"
                                                                       Text="{Binding DataContext.BekleyenSure,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                        </StackPanel>
                                                        <ContentControl x:Name="CevapIcerik"
                                                                        Content="{Binding Metin, Converter={StaticResource MarkdownCevir}}" />
                                                        <Button Content="↗ Sekmede aç" HorizontalAlignment="Left"
                                                                Margin="0,8,0,0" Padding="10,3"
                                                                Style="{StaticResource BirincilDugme}"
                                                                Command="{Binding DataContext.MesajSorgusunuAcCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding Sorgu, Converter={StaticResource DegerVarsaGorunur}}"
                                                                ToolTip="Cevaptaki sorguyu yeni sekmede açar — çalıştırmaz" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding KullaniciMi}" Value="True">
                                                        <Setter TargetName="Balon" Property="HorizontalAlignment" Value="Right" />
                                                        <Setter TargetName="Balon" Property="Background" Value="{DynamicResource VurguZeminFircasi}" />
                                                        <Setter TargetName="Balon" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
                                                    </DataTrigger>
                                                    <!-- Bekleme balonu: cevap satırı gizli, "düşünüyor" satırı görünür + yavaş nabız -->
                                                    <DataTrigger Binding="{Binding Dusunuyor}" Value="True">
                                                        <Setter TargetName="DusunuyorSatir" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="CevapIcerik" Property="Visibility" Value="Collapsed" />
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="DusunuyorNabiz">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="NabizGrubu"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     From="0.45" To="1" Duration="0:0:0.85"
                                                                                     AutoReverse="True" RepeatBehavior="Forever" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="DusunuyorNabiz" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </DataTemplate>

                        <!-- Görsel Sorgu Tasarımcısı (v6-S1): ağaçtan tablo sürükle → tuvale kutu;
                             "Script'e aç" SELECT üretip yeni sekmede açar. Tuval hiçbir şey çalıştırmaz. -->
                        <DataTemplate DataType="{x:Type vm:GorselSorguSekmesiViewModel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="8,5" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource KenarFircasi}"
                                        Background="{DynamicResource PanelZeminFircasi}">
                                    <DockPanel>
                                        <!-- 🎯 DB seçici (kullanıcı bulgusu 2026-07-31): görsel sorgu hangi DB'de
                                             koşuyor GÖRÜNSÜN + değiştirilebilsin (editördeki seçicinin aynısı). -->
                                        <ComboBox DockPanel.Dock="Left" MinWidth="130" Margin="0,0,8,0"
                                                  ItemsSource="{Binding Veritabanlari}"
                                                  SelectedItem="{Binding SecilenVeritabani}"
                                                  ToolTip="Görsel sorgunun çalışacağı veritabanı — tablo sürükleyince o tablonun veritabanına geçer"
                                                  AutomationProperties.AutomationId="CmbGorselVeritabani" />
                                        <Button DockPanel.Dock="Left" Content="▶ Çalıştır (F5)" Padding="10,3"
                                                Command="{Binding CalistirCommand}"
                                                IsEnabled="{Binding ScriptUretilebilir}"
                                                Style="{StaticResource BirincilDugme}"
                                                ToolTip="Tuvaldeki sorguyu çalıştırır — sonuç script'e geçmeden aşağıda, bu sekmede görünür"
                                                AutomationProperties.AutomationId="BtnGorselCalistir" />
                                        <Button DockPanel.Dock="Left" Content="▶ Script'e aç" Padding="10,3" Margin="6,0,0,0"
                                                Command="{Binding ScripteAcCommand}"
                                                IsEnabled="{Binding ScriptUretilebilir}"
                                                ToolTip="Tuvaldeki tablolardan SELECT üretir ve yeni sorgu sekmesinde açar (çalıştırmaz)"
                                                AutomationProperties.AutomationId="BtnGorselScripteAc" />
                                        <Button DockPanel.Dock="Left" Content="🗑 Temizle" Padding="10,3" Margin="6,0,0,0"
                                                Command="{Binding TemizleCommand}"
                                                IsEnabled="{Binding ScriptUretilebilir}"
                                                AutomationProperties.AutomationId="BtnGorselTemizle" />
                                        <TextBlock Text="{Binding Bilgi}" VerticalAlignment="Center" Margin="12,0"
                                                   Foreground="{DynamicResource SolukMetinFircasi}" FontSize="11.5"
                                                   AutomationProperties.AutomationId="LblGorselBilgi" />
                                    </DockPanel>
                                </Border>
                                <!-- WHERE filtre çipi şeridi (#2, 2026-07-25): kolon satırındaki huniden eklenen
                                     koşullar burada çip olarak durur — bağlaç (VE/VEYA) tıklanınca döner, ✕ kaldırır. -->
                                <Border DockPanel.Dock="Top" Padding="8,5" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource KenarFircasi}"
                                        Background="{DynamicResource PanelZeminFircasi}"
                                        Visibility="{Binding CiplerVar, Converter={StaticResource BoolGorunurluk}}">
                                    <ItemsControl ItemsSource="{Binding Cipler}"
                                                  AutomationProperties.AutomationId="GorselCipSeridi">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <!-- Bağlaç anahtarı: ilk çipte gizli; tık → VE↔VEYA -->
                                                    <Button Content="{Binding Baglac}" Command="{Binding BaglacDegistirCommand}"
                                                            FontSize="10" FontWeight="Bold" Padding="5,1" Margin="2,0"
                                                            Cursor="Hand" BorderThickness="0"
                                                            Background="Transparent" Foreground="{DynamicResource VurguFircasi}"
                                                            ToolTip="Bir önceki koşulla bağlacı değiştir (VE ↔ VEYA)"
                                                            Visibility="{Binding IlkMi, Converter={StaticResource TersBoolGorunurluk}}"
                                                            AutomationProperties.AutomationId="BtnCipBaglac" />
                                                    <Border Background="{DynamicResource VurguZeminFircasi}" CornerRadius="10"
                                                            BorderThickness="1" BorderBrush="{DynamicResource VurguFircasi}"
                                                            Padding="9,3" Margin="2,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Metin}" FontSize="11.5"
                                                                       FontFamily="{StaticResource KodYazisi}"
                                                                       Foreground="{DynamicResource MetinFircasi}"
                                                                       VerticalAlignment="Center" />
                                                            <Button Content="✕" FontSize="10" Padding="4,0" Margin="6,0,0,0"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Foreground="{DynamicResource SolukMetinFircasi}"
                                                                    Command="{Binding SilCommand}" ToolTip="Bu koşulu kaldır"
                                                                    AutomationProperties.AutomationId="BtnCipSil" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <!-- Yerinde sonuç bölmesi (2026-07-23): ▶ Çalıştır script sekmesi açmaz,
                                     sonuç burada görünür. SonucBilgi null iken bölme tamamen gizli. -->
                                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                                        BorderBrush="{DynamicResource KenarFircasi}"
                                        Visibility="{Binding SonucBilgi, Converter={StaticResource DegerVarsaGorunur}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding SonucBilgi}" Padding="8,4" FontSize="12"
                                                   Background="{DynamicResource BilgiZeminFircasi}"
                                                   Foreground="{DynamicResource BilgiMetinFircasi}"
                                                   AutomationProperties.AutomationId="LblGorselSonucBilgi" />
                                        <!-- AutoGeneratingColumn ana grid'le ORTAK (inceleme 2026-07-23): özel
                                             karakterli kolon adı kaçışı + NULL stili + hücre converter'ı burada da geçerli -->
                                        <DataGrid ItemsSource="{Binding SonucGorunum}" AutoGenerateColumns="True"
                                                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                                                  IsReadOnly="True" MaxHeight="260" BorderThickness="0"
                                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                  HeadersVisibility="Column"
                                                  AutomationProperties.AutomationId="GridGorselSonuc" />
                                    </DockPanel>
                                </Border>
                                <!-- Tuval: kutular + bağlantı çizgileri aynı koordinat düzleminde katmanlı.
                                     Çizgiler ARKADA, kutular ÖNDE; boş alan tıkları Grid'e düşer (Drop burada). -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="{DynamicResource PencereZeminFircasi}">
                                    <Grid MinWidth="1200" MinHeight="800" Background="Transparent"
                                          AllowDrop="True" Drop="GorselTuval_Drop" DragOver="GorselTuval_DragOver"
                                          AutomationProperties.AutomationId="GorselTuval">

                                        <!-- KATMAN 1 (arkada): bağlantı çizgileri + join özeti -->
                                        <ItemsControl ItemsSource="{Binding Baglantilar}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                              Stroke="{DynamicResource VurguFircasi}" StrokeThickness="2" Cursor="Hand"
                                                              MouseLeftButtonDown="GorselBaglanti_Tik"
                                                              ToolTip="Çift tık: join tipini ve ON kolonlarını düzenle" />
                                                        <Border Canvas.Left="{Binding OrtaX}" Canvas.Top="{Binding OrtaY}" Cursor="Hand"
                                                                Background="{DynamicResource PanelZeminFircasi}" Padding="4,1"
                                                                BorderBrush="{DynamicResource VurguFircasi}" BorderThickness="1" CornerRadius="3"
                                                                MouseLeftButtonDown="GorselBaglanti_Tik">
                                                            <TextBlock Text="{Binding Ozet}" FontSize="10.5"
                                                                       Foreground="{DynamicResource MetinFircasi}" />
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- KATMAN 2 (önde): kutular -->
                                        <ItemsControl ItemsSource="{Binding Kutular}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Çift tık → bu tablonun WHERE koşulları (S3). -->
                                                    <Border Width="210" CornerRadius="4" BorderThickness="1"
                                                            BorderBrush="{DynamicResource VurguFircasi}"
                                                            Background="{DynamicResource PanelZeminFircasi}"
                                                            MouseLeftButtonDown="GorselKutu_CiftTik"
                                                            ToolTip="Çift tık → WHERE koşulları">
                                                        <DockPanel>
                                                            <!-- Başlık: ✕ (sağ) + ⚬ bağlama ucu (sol) Thumb'ın KARDEŞİDİR —
                                                                 yoksa Thumb mouse'u yakalar ve tıklamaları sürüklemeye takar. -->
                                                            <Border DockPanel.Dock="Top" Background="{DynamicResource VurguZeminFircasi}"
                                                                    CornerRadius="4,4,0,0" Padding="6,4">
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Content="✕"
                                                                            Padding="4,0" Background="Transparent"
                                                                            BorderThickness="0" Cursor="Hand"
                                                                            Click="GorselKutuSil_Click"
                                                                            ToolTip="Kutuyu tuvalden kaldır"
                                                                            AutomationProperties.AutomationId="BtnGorselKutuSil" />
                                                                    <TextBlock DockPanel.Dock="Left" Text="⚬" Margin="0,0,6,0"
                                                                               FontSize="15" FontWeight="Bold" Cursor="Cross"
                                                                               Foreground="{DynamicResource MetinFircasi}"
                                                                               MouseLeftButtonDown="GorselBaglantiUcu_MouseDown"
                                                                               MouseLeftButtonUp="GorselBaglantiUcu_MouseUp"
                                                                               ToolTip="Bağla (JOIN): buradan tutup başka bir tablonun üstüne SÜRÜKLEYİP bırak"
                                                                               AutomationProperties.AutomationId="GorselBaglantiUcu" />
                                                                    <Thumb DragDelta="Kutu_DragDelta" Cursor="SizeAll">
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Border Background="Transparent">
                                                                                    <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold"
                                                                                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{DynamicResource MetinFircasi}" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </DockPanel>
                                                            </Border>
                                                            <!-- WHERE şart rozeti (S3): koşul varsa alt şeritte "⧩ N" görünür. -->
                                                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource VurguZeminFircasi}"
                                                                    CornerRadius="0,0,4,4" Padding="6,2"
                                                                    Visibility="{Binding KosulVar, Converter={StaticResource BoolGorunurluk}}">
                                                                <TextBlock Text="{Binding KosulRozeti}" FontSize="10.5"
                                                                           Foreground="{DynamicResource MetinFircasi}"
                                                                           ToolTip="Bu tabloda WHERE koşulu var — çift tık ile düzenle" />
                                                            </Border>
                                                            <!-- Kolonlar: checkbox ile SELECT seçimi (S4). Hiçbiri seçili değilse SELECT *. -->
                                                            <ItemsControl ItemsSource="{Binding KolonSecimleri}" Margin="6,4" MaxHeight="220">
                                                                <ItemsControl.Template>
                                                                    <ControlTemplate TargetType="ItemsControl">
                                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                                                    </ControlTemplate>
                                                                </ItemsControl.Template>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!-- Satır: SELECT işareti + hover'da beliren HUNİ (WHERE koşulu — #2, 2026-07-25) -->
                                                                        <DockPanel x:Name="KolonSatiri" Background="Transparent">
                                                                            <Button DockPanel.Dock="Right" x:Name="HuniDugmesi"
                                                                                    Width="20" Height="18" Padding="0" Opacity="0"
                                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                                    Click="GorselHuni_Click"
                                                                                    ToolTip="Bu kolona WHERE koşulu ekle"
                                                                                    AutomationProperties.AutomationId="BtnGorselHuni">
                                                                                <Path Data="{StaticResource Ikon.Huni}" Stretch="Uniform"
                                                                                      Width="11" Height="11"
                                                                                      Fill="{DynamicResource VurguFircasi}" />
                                                                            </Button>
                                                                            <CheckBox IsChecked="{Binding Secili}" Content="{Binding Gosterim}"
                                                                                      FontSize="11" FontFamily="{StaticResource KodYazisi}"
                                                                                      Foreground="{DynamicResource IkincilFircasi}"
                                                                                      ToolTip="İşaretle → SELECT listesine ekle (hiçbiri işaretli değilse SELECT *)" />
                                                                        </DockPanel>
                                                                        <DataTemplate.Triggers>
                                                                            <Trigger SourceName="KolonSatiri" Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="HuniDugmesi" Property="Opacity" Value="1" />
                                                                            </Trigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </DataTemplate>

                        <!-- Veritabanı Haritası (v9-S2): ER-diyagramı tuvali. KATMAN 1 (arkada) FK bezier
                             bağları; KATMAN 2 (önde) tablo kartları. Zoom = Grid LayoutTransform (Ctrl+tekerlek). -->
                        <DataTemplate DataType="{x:Type vm:HaritaSekmesiViewModel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="8,5" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource KenarFircasi}"
                                        Background="{DynamicResource PanelZeminFircasi}">
                                    <DockPanel>
                                        <!-- Odak+Bağlam (#1, 2026-07-25): mahalle görünümüne dönüş + odak derinliği -->
                                        <Button DockPanel.Dock="Left" Content="🏘 Mahalle" Padding="10,3"
                                                Command="{Binding MahalleyeDonCommand}"
                                                Visibility="{Binding MahalleDonGorunur, Converter={StaticResource BoolGorunurluk}}"
                                                ToolTip="Mahalle görünümüne dön: tablolar FK-bağlantı kümeleri (mahalle kartları) olarak görünür"
                                                AutomationProperties.AutomationId="BtnHaritaMahalle" />
                                        <Button DockPanel.Dock="Left" Padding="10,3" Margin="6,0,0,0"
                                                Content="{Binding OdakDerinligi, StringFormat='◎ Derinlik: {0}'}"
                                                Command="{Binding DerinlikDegistirCommand}"
                                                Visibility="{Binding OdakModunda, Converter={StaticResource BoolGorunurluk}}"
                                                ToolTip="Odak komşuluk derinliği (1 = doğrudan komşular, 2 = komşunun komşusu)"
                                                AutomationProperties.AutomationId="BtnHaritaDerinlik" />
                                        <Button DockPanel.Dock="Left" Content="⚡ Otomatik yerleştir" Padding="10,3" Margin="6,0,0,0"
                                                Command="{Binding OtomatikYerlestirCommand}"
                                                Visibility="{Binding MahalleModu, Converter={StaticResource TersBoolGorunurluk}}"
                                                ToolTip="Kuvvet-yönlü yerleşim: bağlı tablolar yaklaşır, bağsızlar açılır"
                                                AutomationProperties.AutomationId="BtnHaritaOto" />
                                        <Button DockPanel.Dock="Left" Content="⤢ Sığdır" Padding="10,3" Margin="6,0,0,0"
                                                Command="{Binding SigdirCommand}"
                                                Visibility="{Binding MahalleModu, Converter={StaticResource TersBoolGorunurluk}}"
                                                ToolTip="Izgara dizilimine dön ve yakınlaştırmayı sıfırla"
                                                AutomationProperties.AutomationId="BtnHaritaSigdir" />
                                        <Button DockPanel.Dock="Left" Padding="10,3" Margin="6,0,0,0"
                                                Content="{Binding SeciliSayisi, StringFormat='🎨 Görsele gönder ({0})'}"
                                                Command="{Binding GorseleGonderCommand}"
                                                IsEnabled="{Binding SecililerVar}"
                                                ToolTip="Seçili tabloları (kart gövdesine tıklayarak seçin) Görsel Sorgu tuvaline aktarır"
                                                AutomationProperties.AutomationId="BtnHaritaGorsele" />
                                        <Button DockPanel.Dock="Right" Content="⭳ SVG" Padding="10,3" Margin="6,0,0,0"
                                                Click="HaritaSvg_Click" IsEnabled="{Binding DisaAktarilabilir}"
                                                ToolTip="Haritayı vektör SVG olarak dışa aktar (ölçeklenebilir, düzenlenebilir)"
                                                AutomationProperties.AutomationId="BtnHaritaSvg" />
                                        <Button DockPanel.Dock="Right" Content="⭳ PNG" Padding="10,3" Margin="12,0,0,0"
                                                Click="HaritaPng_Click" IsEnabled="{Binding DisaAktarilabilir}"
                                                ToolTip="Haritayı PNG görüntü olarak dışa aktar (%100 ölçekte)"
                                                AutomationProperties.AutomationId="BtnHaritaPng" />
                                        <TextBox DockPanel.Dock="Right" Width="180" VerticalContentAlignment="Center"
                                                 Margin="12,0,0,0" Padding="6,3"
                                                 Text="{Binding Arama, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="HaritaArama_KeyDown"
                                                 ToolTip="Tablo ara — eşleşenler aydınlanır; ENTER = ilk eşleşen tabloya ODAKLAN (uçuş)"
                                                 AutomationProperties.AutomationId="TxtHaritaArama" />
                                        <TextBlock Text="{Binding Bilgi}" VerticalAlignment="Center" Margin="12,0"
                                                   Foreground="{DynamicResource SolukMetinFircasi}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.AutomationId="LblHaritaBilgi" />
                                    </DockPanel>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="{DynamicResource PencereZeminFircasi}"
                                              PreviewMouseWheel="HaritaTuval_Wheel"
                                              AutomationProperties.AutomationId="HaritaTuval">
                                    <Grid MinWidth="2000" MinHeight="1400" Background="Transparent">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding Olcek}" ScaleY="{Binding Olcek}" />
                                        </Grid.LayoutTransform>

                                        <!-- MAHALLE KATMANI A (#1): kümeler arası toplu bağlar (çizgi + "N FK" rozeti) -->
                                        <ItemsControl ItemsSource="{Binding KumeBaglari}"
                                                      Visibility="{Binding MahalleModu, Converter={StaticResource BoolGorunurluk}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                              Stroke="{DynamicResource ZayifMetinFircasi}" StrokeThickness="2.5" />
                                                        <Border Canvas.Left="{Binding OrtaX}" Canvas.Top="{Binding OrtaY}"
                                                                Background="{DynamicResource PanelZeminFircasi}" Padding="5,1"
                                                                BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="1" CornerRadius="8">
                                                            <TextBlock Text="{Binding Rozet}" FontSize="10"
                                                                       Foreground="{DynamicResource SolukMetinFircasi}" />
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- MAHALLE KATMANI B (#1): küme (mahalle) kartları — çift tık kümeyi açar -->
                                        <ItemsControl ItemsSource="{Binding KumeKartlari}"
                                                      Visibility="{Binding MahalleModu, Converter={StaticResource BoolGorunurluk}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="240" Height="132" CornerRadius="9" Cursor="Hand"
                                                            Background="{DynamicResource PanelZeminFircasi}"
                                                            BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="1"
                                                            ToolTip="Çift tık: kümeyi aç — yalnız bu kümenin tabloları çizilir"
                                                            AutomationProperties.AutomationId="HaritaKumeKarti">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                          Command="{Binding DataContext.KumeAcCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <DockPanel>
                                                            <!-- Renkli üst band: küme adı + büyük üye sayısı -->
                                                            <Border DockPanel.Dock="Top" Height="38" Background="{Binding BandFircasi}"
                                                                    CornerRadius="9,9,0,0" Padding="10,0">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UyeSayisi}"
                                                                               VerticalAlignment="Center" FontSize="19" FontWeight="Bold"
                                                                               Foreground="White" />
                                                                    <TextBlock Text="{Binding Ad}" VerticalAlignment="Center"
                                                                               FontWeight="SemiBold" FontSize="12" Foreground="White"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Border>
                                                            <StackPanel Margin="10,7">
                                                                <TextBlock Text="ÖNE ÇIKANLAR" FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource SolukMetinFircasi}" Margin="0,0,0,3" />
                                                                <TextBlock Text="{Binding OneCikanlar}" FontSize="11.5" LineHeight="17"
                                                                           FontFamily="{StaticResource KodYazisi}"
                                                                           Foreground="{DynamicResource MetinFircasi}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- KATMAN 1: FK bağları (bezier + ok) — mahalle görünümünde gizli -->
                                        <ItemsControl ItemsSource="{Binding Kenarlar}"
                                                      Visibility="{Binding MahalleModu, Converter={StaticResource TersBoolGorunurluk}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Cizim}" StrokeThickness="1.6"
                                                          StrokeLineJoin="Round" ToolTip="{Binding Ozet}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Stroke" Value="{DynamicResource ZayifMetinFircasi}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Vurgulu}" Value="True">
                                                                        <Setter Property="Stroke" Value="{DynamicResource VurguFircasi}" />
                                                                        <Setter Property="StrokeThickness" Value="2.4" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Soluk}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.14" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- KATMAN 2: tablo kartları — mahalle görünümünde gizli -->
                                        <ItemsControl ItemsSource="{Binding Dugumler}"
                                                      Visibility="{Binding MahalleModu, Converter={StaticResource TersBoolGorunurluk}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="220" Height="{Binding Yukseklik}" CornerRadius="7"
                                                            Background="{DynamicResource PanelZeminFircasi}"
                                                            MouseEnter="HaritaDugum_MouseEnter" MouseLeave="HaritaDugum_MouseLeave"
                                                            MouseLeftButtonUp="HaritaDugum_Tik"
                                                            ToolTip="Gövdeye tık = seç · ÇİFT tık = bu tabloya ODAKLAN (komşuluk haritası)">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                          Command="{Binding DataContext.OdaklanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource KenarFircasi}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Vurgulu}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
                                                                        <Setter Property="BorderThickness" Value="1.6" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Soluk}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.35" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Secili}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BasariFircasi}" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <!-- Şema renk şeridi (sol) -->
                                                            <Border DockPanel.Dock="Left" Width="3" Background="{Binding SemaFircasi}"
                                                                    CornerRadius="7,0,0,7" />
                                                            <DockPanel>
                                                                <!-- Başlık = sürükleme tutamacı (Thumb) -->
                                                                <Border DockPanel.Dock="Top" Height="34"
                                                                        Background="{DynamicResource ZeminAcikFircasi}" CornerRadius="0,7,0,0">
                                                                    <Thumb DragDelta="HaritaDugum_DragDelta" DragCompleted="HaritaDugum_DragCompleted" Cursor="SizeAll">
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Border Background="Transparent" Padding="8,0">
                                                                                    <DockPanel>
                                                                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,7,0"
                                                                                                 VerticalAlignment="Center" Fill="{Binding SemaFircasi}" />
                                                                                        <TextBlock DockPanel.Dock="Right" Text="✓" VerticalAlignment="Center" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource BasariFircasi}" Margin="6,0,0,0"
                                                                                                   Visibility="{Binding Secili, Converter={StaticResource BoolGorunurluk}}" />
                                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Sema}" VerticalAlignment="Center"
                                                                                                   FontFamily="{StaticResource KodYazisi}" FontSize="10.5"
                                                                                                   Foreground="{DynamicResource SolukMetinFircasi}" Margin="6,0,0,0" />
                                                                                        <TextBlock Text="{Binding Ad}" VerticalAlignment="Center"
                                                                                                   FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                                                                   Foreground="{DynamicResource MetinFircasi}" />
                                                                                    </DockPanel>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </Border>
                                                                <!-- Kolon satırları (Kompakt kartta gizli — semantik sadelik, #1) -->
                                                                <ItemsControl ItemsSource="{Binding Kolonlar}"
                                                                              Visibility="{Binding Kompakt, Converter={StaticResource TersBoolGorunurluk}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Height="24">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="22" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" FontSize="11">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Text" Value="·" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource SolukMetinFircasi}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding FkMi}" Value="True">
                                                                                                    <Setter Property="Text" Value="🔗" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource VurguFircasi}" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding PkMi}" Value="True">
                                                                                                    <Setter Property="Text" Value="🔑" />
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource UyariFircasi}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Ad}" VerticalAlignment="Center"
                                                                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                                                                           Foreground="{DynamicResource MetinFircasi}" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding Tip}" VerticalAlignment="Center"
                                                                                           Margin="8,0,10,0" FontFamily="{StaticResource KodYazisi}" FontSize="10.5"
                                                                                           Foreground="{DynamicResource SolukMetinFircasi}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DockPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </DataTemplate>

                        <!-- 🔎 Veri Arama sekmesi (kullanıcı isteği 2026-08-09: ayrı pencere yerine sekme).
                             Değer → tüm tabloların uygun kolonlarında tablo tablo aranır; bulunan tabloya
                             çift tık → satırlar yeni sorgu sekmesinde. -->
                        <DataTemplate DataType="{x:Type vm:VeriAramaSekmesiViewModel}">
                            <DockPanel Margin="8">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}" CornerRadius="3"
                                        Padding="10,7" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource KenarFircasi}">
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource BilgiMetinFircasi}"
                                               Text="Değeri VERİNİN içinde arar (Kod Arama nesne tanımlarında arar): tüm tabloların uygun tipli kolonlarında tam eşitlikle taranır — sayı yazarsanız sayısal+metin, metin yazarsanız metin kolonları. Tablo başına ilk 100 satır ve 10 sn sınır (dev/indekssiz tablo aramayı kilitlemez — süreni aşan atlanıp raporlanır); Durdur çalışan sorguyu da anında keser. Bulunan tabloya çift tıklayın: satırlar sekmede açılır."
                                               AutomationProperties.AutomationId="LblVeriAramaNot" />
                                </Border>

                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DB:" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource SolukMetinFircasi}" />
                                    <ComboBox Grid.Column="1" Margin="0,0,8,0"
                                              ItemsSource="{Binding Veritabanlari}" SelectedItem="{Binding SecilenVeritabani}"
                                              AutomationProperties.AutomationId="CmbVeriAramaDb" />
                                    <TextBox Grid.Column="2" Padding="6,3"
                                             Text="{Binding Deger, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Aranacak değer — örn. 12345678901 ya da bir metin"
                                             AutomationProperties.AutomationId="TxtVeriAramaDeger">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AraCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="3" Content="🔎 Ara" Padding="14,4" Margin="8,0,0,0"
                                            Style="{StaticResource BirincilDugme}" Command="{Binding AraCommand}"
                                            AutomationProperties.AutomationId="BtnVeriAra" />
                                    <Button Grid.Column="4" Content="■" Padding="10,4" Margin="6,0,0,0"
                                            IsEnabled="{Binding Araniyor}" Command="{Binding DurdurCommand}" ToolTip="Aramayı durdur"
                                            AutomationProperties.AutomationId="BtnVeriAraDurdur" />
                                </Grid>

                                <!-- Kapsam seçici: Tümü (10 sn/tablo) ya da seçili tablolar (SINIRSIZ süre). -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Kapsam:" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource SolukMetinFircasi}" />
                                    <ToggleButton x:Name="KapsamDugmesi" DockPanel.Dock="Left" Content="{Binding KapsamEtiketi}" Padding="10,3"
                                                  IsChecked="{Binding KapsamAcik, Mode=TwoWay}"
                                                  ToolTip="Tümü: her tabloda 10 sn sınırıyla tarar. Tablo seçersen: yalnız seçilenlerde, SÜRE SINIRSIZ (Durdur her an keser)"
                                                  AutomationProperties.AutomationId="BtnVeriAramaKapsam" />
                                    <Popup PlacementTarget="{Binding ElementName=KapsamDugmesi}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding KapsamAcik, Mode=TwoWay}">
                                        <Border Background="{DynamicResource PencereZeminFircasi}" BorderBrush="{DynamicResource KenarFircasi}"
                                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,3,6,6" Width="300">
                                            <StackPanel>
                                                <TextBox Text="{Binding KapsamAra, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Padding="4,2"
                                                         ToolTip="Tablo adında ara" AutomationProperties.AutomationId="TxtVeriAramaKapsamAra" />
                                                <Button Content="Tümüne dön (seçimi temizle)" Style="{StaticResource MiniDugme}" Margin="0,0,0,6"
                                                        Command="{Binding KapsamTemizleCommand}" AutomationProperties.AutomationId="BtnVeriAramaKapsamTemizle" />
                                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding KapsamOgeleri}" AutomationProperties.AutomationId="PnlVeriAramaKapsam">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Ad}" IsChecked="{Binding Secili, Mode=TwoWay}"
                                                                          Margin="2,3,0,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <Button DockPanel.Dock="Right" Content="⏱ Atlananları seçip SINIRSIZ ara"
                                            Padding="10,3" Command="{Binding AtlananAraCommand}"
                                            Visibility="{Binding AtlananGorunur, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="10 sn sınırına takılan tabloları kapsama alır ve süre sınırı olmadan yeniden arar"
                                            AutomationProperties.AutomationId="BtnVeriAramaAtlanan" />
                                </DockPanel>

                                <TextBlock DockPanel.Dock="Top" Margin="0,8,0,6" TextWrapping="Wrap" FontSize="12.5"
                                           Text="{Binding DurumMetni}"
                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                           AutomationProperties.AutomationId="LblVeriAramaDurum" />

                                <ListBox ItemsSource="{Binding Sonuclar}" SelectedItem="{Binding SeciliSonuc}"
                                         DisplayMemberPath="Etiket" FontFamily="Consolas" FontSize="12.5"
                                         ToolTip="Çift tık: o tablonun eşleşen satırlarını sekmede açar"
                                         AutomationProperties.AutomationId="LstVeriAramaSonuc">
                                    <ListBox.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SonucAcCommand}" />
                                    </ListBox.InputBindings>
                                </ListBox>
                            </DockPanel>
                        </DataTemplate>

                        <!-- 🧾 Log Analizi sekmesi (kullanıcı isteği 2026-08-09: ayrı pencere yerine sekme).
                             DB → tablo → mesaj kolonu (+ istenirse EK kolonlar) seçilir; son 24 saat /
                             tarih aralığı / tüm zamanlar kapsamında en çok tekrarlayan hata imzaları
                             GERÇEK toplam sayısıyla. Seviye alanı/süzgeci KALDIRILDI (kullanıcı
                             2026-09-17: "belirleyemiyoruz, gereksiz"); ek kolonlar grid'e kod-arkasından
                             dinamik eklenir (LogGrid_Yuklendi). -->
                        <DataTemplate DataType="{x:Type vm:LogAnalizSekmesiViewModel}">
                            <DataTemplate.Resources>
                                <conv:HucreMetniConverter x:Key="TekSatir" />
                            </DataTemplate.Resources>
                            <DockPanel Margin="14">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource UyariZeminFircasi}" CornerRadius="3"
                                        BorderThickness="1" BorderBrush="{DynamicResource KenarFircasi}" Padding="10,7" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding LogNotu}" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource UyariMetinFircasi}"
                                               AutomationProperties.AutomationId="LblLogNot" />
                                </Border>

                                <!-- Seçiciler: DB / tablo / mesaj kolonu / ek kolonlar (çok seçim) -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Etiketlerde Foreground ŞART (saha m.4): fırça kalıtımı TabControl'de
                                         kırılıyor, fırçasız TextBlock sistem SİYAHINA düşüp koyu temada kayboluyordu.
                                         MetinFircasi (soluk değil): kullanıcı "daha belirgin olsun" dedi. -->
                                    <TextBlock Grid.Column="0" Text="Veritabanı:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MetinFircasi}" />
                                    <ComboBox Grid.Column="1" MinWidth="120" Margin="0,0,14,0"
                                              ItemsSource="{Binding Veritabanlari}" SelectedItem="{Binding SecilenVeritabani}"
                                              ToolTip="Log/exception tablosunun bulunduğu veritabanı"
                                              AutomationProperties.AutomationId="CmbLogVeritabani" />
                                    <TextBlock Grid.Column="2" Text="{Binding TabloEtiketi}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MetinFircasi}" />
                                    <ComboBox Grid.Column="3" MinWidth="150" Margin="0,0,14,0"
                                              ItemsSource="{Binding Tablolar}" SelectedItem="{Binding SecilenTablo}"
                                              ToolTip="Analiz edilecek log/exception tablosu (Mongo: koleksiyon)"
                                              AutomationProperties.AutomationId="CmbLogTablo" />
                                    <TextBlock Grid.Column="4" Text="{Binding KolonEtiketi}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MetinFircasi}" />
                                    <ComboBox Grid.Column="5" MinWidth="120" Margin="0,0,14,0"
                                              ItemsSource="{Binding Kolonlar}" SelectedItem="{Binding SecilenKolon}"
                                              IsEnabled="{Binding KolonKutusuAktif}"
                                              ToolTip="Gruplama bu kolonun metnine göre yapılır (exception mesajı kolonu)"
                                              AutomationProperties.AutomationId="CmbLogKolon" />
                                    <TextBlock Grid.Column="6" Text="{Binding EkKolonEtiketi}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MetinFircasi}" />
                                    <!-- v22-S12 "birden fazla kolonu yan yana": çok-seçimli açılır liste
                                         (Veri Arama kapsam deseni — ToggleButton + Popup + CheckBox). -->
                                    <ToggleButton x:Name="LogEkKolonDugmesi" Grid.Column="7" MinWidth="110" Padding="10,3"
                                                  Content="{Binding EkKolonOzeti}"
                                                  IsChecked="{Binding EkKolonAcik, Mode=TwoWay}"
                                                  ToolTip="Seçilen kolonların değeri, her hata grubunun örnek satırından sonuç listesine yan yana eklenir (ör. StackTrace'e göre grupla, yanında ExceptionMessage'ı gör)"
                                                  AutomationProperties.AutomationId="BtnLogEkKolon" />
                                    <Popup PlacementTarget="{Binding ElementName=LogEkKolonDugmesi}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding EkKolonAcik, Mode=TwoWay}">
                                        <Border Background="{DynamicResource PencereZeminFircasi}" BorderBrush="{DynamicResource KenarFircasi}"
                                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,3,6,6" MinWidth="220">
                                            <StackPanel>
                                                <TextBlock Text="Grupların örnek satırından gride eklenecek kolonlar:" TextWrapping="Wrap"
                                                           FontSize="11" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource SolukMetinFircasi}" />
                                                <Button Content="✕ Seçimi temizle" Style="{StaticResource MiniDugme}" Margin="0,0,0,6"
                                                        Command="{Binding EkKolonTemizleCommand}"
                                                        AutomationProperties.AutomationId="BtnLogEkKolonTemizle" />
                                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding EkKolonOgeleri}" AutomationProperties.AutomationId="PnlLogEkKolon">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Ad}" IsChecked="{Binding Secili, Mode=TwoWay}"
                                                                          Margin="2,3,0,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Sonuçlarda arama (seviye çipleri kaldırıldı — 2026-09-17) -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                                    <Grid DockPanel.Dock="Right" Width="240" HorizontalAlignment="Right">
                                        <TextBox Padding="24,3,6,3" Text="{Binding SonucSuz, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Aşağıdaki grup listesini metne göre süz"
                                                 AutomationProperties.AutomationId="TxtLogSonucSuz" />
                                        <TextBlock Text="🔎" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                    </Grid>
                                </DockPanel>

                                <!-- İki panel: Günlük (son 24 saat) · Tüm Zamanlar (tarih aralığı) -->
                                <TabControl DockPanel.Dock="Top" Margin="0,0,0,10"
                                            AutomationProperties.AutomationId="LogPaneller">
                                    <TabItem Header="Günlük Log Analizi" AutomationProperties.AutomationId="TabGunlukLog">
                                        <StackPanel Margin="10">
                                            <Border Background="{DynamicResource BilgiZeminFircasi}" CornerRadius="3"
                                                    BorderThickness="1" BorderBrush="{DynamicResource VurguFircasi}" Padding="10,7" Margin="0,0,0,10">
                                                <TextBlock TextWrapping="Wrap" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource VurguFircasi}"
                                                           Text="⏱ SON 24 SAATİ BAZ ALMAKTADIR — TÜM TABLO TARANMAZ; YALNIZCA SON 24 SAATTEKİ KAYITLAR GRUPLANIR."
                                                           AutomationProperties.AutomationId="LblLog24Saat" />
                                            </Border>
                                            <Button Content="🔎 Analiz et (son 24 saat)" HorizontalAlignment="Right" Padding="14,4"
                                                    Command="{Binding AnalizCommand}" Style="{StaticResource BirincilDugme}"
                                                    AutomationProperties.AutomationId="BtnLogAnalizEt" />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Tüm Zamanlar Log Analizi" AutomationProperties.AutomationId="TabTumZamanlarLog">
                                        <StackPanel Margin="10">
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10"
                                                       Foreground="{DynamicResource SolukMetinFircasi}"
                                                       Text="Seçilen tarih aralığındaki kayıtlar gruplanır (bitiş günü DAHİL). İki tarih de boş bırakılırsa tüm tablo örneklenir."
                                                       AutomationProperties.AutomationId="LblAralikNot" />
                                            <!-- v20-S21 saha m.5: çıplak DatePicker satırı → temalı KART: 📅 + aralık +
                                                 hızlı seçim düğmeleri (Bugün / 7 / 30 gün / Temizle). -->
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="🔎 Analiz et (aralık)" VerticalAlignment="Center"
                                                        Padding="14,5" Margin="12,0,0,0"
                                                        Command="{Binding AralikAnalizKomutCommand}" Style="{StaticResource BirincilDugme}"
                                                        AutomationProperties.AutomationId="BtnLogAralikAnalizEt" />
                                                <Border HorizontalAlignment="Left" Background="{DynamicResource PanelZeminFircasi}"
                                                        BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="1"
                                                        CornerRadius="4" Padding="10,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📅" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="Başlangıç:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource MetinFircasi}" />
                                                        <DatePicker Width="126" SelectedDate="{Binding BaslangicTarihi}"
                                                                    AutomationProperties.AutomationId="DtLogBaslangic" />
                                                        <TextBlock Text="—" VerticalAlignment="Center" Margin="8,0"
                                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                                        <TextBlock Text="Bitiş:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource MetinFircasi}" />
                                                        <DatePicker Width="126" SelectedDate="{Binding BitisTarihi}"
                                                                    AutomationProperties.AutomationId="DtLogBitis" />
                                                        <Border Width="1" Background="{DynamicResource KenarFircasi}" Margin="12,2" />
                                                        <Button Content="Bugün" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                Command="{Binding HizliAralikCommand}" CommandParameter="0"
                                                                AutomationProperties.AutomationId="BtnLogAralikBugun" />
                                                        <Button Content="Son 7 gün" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                Command="{Binding HizliAralikCommand}" CommandParameter="7"
                                                                AutomationProperties.AutomationId="BtnLogAralik7" />
                                                        <Button Content="Son 30 gün" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                Command="{Binding HizliAralikCommand}" CommandParameter="30"
                                                                AutomationProperties.AutomationId="BtnLogAralik30" />
                                                        <Button Content="✕ Temizle" Style="{StaticResource MiniDugme}"
                                                                Command="{Binding AralikTemizleCommand}"
                                                                ToolTip="İki tarihi de boşalt — tüm tablo örneklenir"
                                                                AutomationProperties.AutomationId="BtnLogAralikTemizle" />
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>

                                <!-- Özet bandı + eylemler: AI Özetle · Kopyala · CSV -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource KenarFircasi}" Padding="10,7" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="⏹ Durdur" Padding="10,2" Margin="8,0,0,0"
                                                Command="{Binding DurdurCommand}"
                                                Visibility="{Binding DurdurGorunur, Converter={StaticResource BoolGorunurluk}}"
                                                Foreground="White" BorderThickness="0" Background="#C0392B"
                                                ToolTip="Çalışan analizi/detay sorgusunu durdur (dev tabloda uzun sürerse)"
                                                AutomationProperties.AutomationId="BtnLogDurdur" />
                                        <!-- v20-S21 ara madde: gerçek sayım artık otomatik koşmaz — yalnız istenince (hız) -->
                                        <Button DockPanel.Dock="Right" Content="🔢 Gerçek toplamları getir" Padding="10,2" Margin="8,0,0,0"
                                                Command="{Binding GercekSayimGetirCommand}"
                                                Visibility="{Binding GercekSayimGorunur, Converter={StaticResource BoolGorunurluk}}"
                                                ToolTip="Örneklemdeki grupların GERÇEK toplamlarını tam tablo taramasıyla sayar — dev tabloda uzun sürebilir (⏹ Durdur ile kesilir)"
                                                AutomationProperties.AutomationId="BtnLogGercekSayim" />
                                        <Button DockPanel.Dock="Right" Content="🤖 AI Özetle" Padding="10,2" Margin="8,0,0,0"
                                                Command="{Binding AiOzetleCommand}" Style="{StaticResource BirincilDugme}"
                                                Visibility="{Binding AiGorunur, Converter={StaticResource BoolGorunurluk}}"
                                                ToolTip="Ekrandaki en çok tekrarlayan grupları asistana yorumlatır: muhtemel kök neden + sonraki adım"
                                                AutomationProperties.AutomationId="BtnLogAiOzet" />
                                        <Button DockPanel.Dock="Right" Content="⬇ CSV" Padding="10,2" Margin="8,0,0,0"
                                                Click="LogCsv_Click" ToolTip="Listeyi CSV dosyasına aktar"
                                                AutomationProperties.AutomationId="BtnLogCsv" />
                                        <Button DockPanel.Dock="Right" Content="⧉ Kopyala" Padding="10,2" Margin="8,0,0,0"
                                                Click="LogKopyala_Click" ToolTip="Listeyi panoya kopyala (sekmeyle ayrılmış)"
                                                AutomationProperties.AutomationId="BtnLogKopyala" />
                                        <TextBlock Text="{Binding Ozet}" TextWrapping="Wrap" Foreground="{DynamicResource BilgiMetinFircasi}" FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="LblLogOzet" />
                                    </DockPanel>
                                </Border>

                                <!-- AI özeti (kapalı başlar) -->
                                <Expander DockPanel.Dock="Bottom" Header="🤖 AI özeti" IsExpanded="{Binding AiOzetAcik, Mode=TwoWay}"
                                          Margin="0,6,0,0"
                                          Visibility="{Binding AiGorunur, Converter={StaticResource BoolGorunurluk}}"
                                          AutomationProperties.AutomationId="ExpLogAiOzet">
                                    <TextBox Text="{Binding AiOzet, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                             FontSize="12.5" AutomationProperties.AutomationId="TxtLogAiOzet" />
                                </Expander>

                                <!-- Seçili grubun TAM mesajı + "detaya in" ipucu -->
                                <Grid DockPanel.Dock="Bottom" Height="150" Margin="0,8,0,0"
                                      Visibility="{Binding SeciliGrup, Converter={StaticResource DegerVarsaGorunur}}">
                                    <Border BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="1" CornerRadius="3"
                                            Background="{DynamicResource PanelZeminFircasi}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
                                                <TextBlock DockPanel.Dock="Left" Text="Seçili grubun tam mesajı" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SolukMetinFircasi}" />
                                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                        Content="🔬 Ham kayıtlar + zaman dağılımı" Padding="10,2" Click="LogDetay_Click"
                                                        ToolTip="Bu grubun arkasındaki gerçek satırları ve saatlik/günlük dağılımı aç (çift tık da olur)"
                                                        AutomationProperties.AutomationId="BtnLogDetay" />
                                            </DockPanel>
                                            <TextBox Text="{Binding SeciliGrup.OrnekMesaj, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas"
                                                     FontSize="12" Padding="8,0,8,8"
                                                     AutomationProperties.AutomationId="TxtLogTamMesaj" />
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <!-- Ek kolonlar (v22-S12) kod-arkasında eklenir: Loaded mevcut analizi geri
                                     çizer (sekme geçişinde şablon yeniden kurulur), Unloaded aboneliği bırakır. -->
                                <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" EnableRowVirtualization="True"
                                          ItemsSource="{Binding Gruplar}" SelectedItem="{Binding SeciliGrup}"
                                          MouseDoubleClick="LogGrid_CiftTik"
                                          Loaded="LogGrid_Yuklendi" Unloaded="LogGrid_Bosaltildi"
                                          AutomationProperties.AutomationId="LogGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kez" Binding="{Binding Sayi}" Width="72">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,0,10,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="" Width="52">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Padding="6,0" Background="#E05A4F" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Visibility="{Binding YeniGorunur}">
                                                        <TextBlock Text="YENİ" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="İlk görülme" Width="128"
                                                            Binding="{Binding IlkGorulme, StringFormat='dd.MM.yyyy HH:mm'}" />
                                        <DataGridTextColumn Header="Son görülme" Width="128"
                                                            Binding="{Binding SonGorulme, StringFormat='dd.MM.yyyy HH:mm'}" />
                                        <DataGridTemplateColumn Header="Örnek mesaj" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OrnekMesaj, Converter={StaticResource TekSatir}}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding OrnekMesaj}"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </DataTemplate>

                        <!-- 🔍 Profiler sekmesi (v23-S1 — docs/09-profiler-arastirma.md, K1-K4):
                             Extended Events oturumu + ring_buffer sorgulamasıyla CANLI akış.
                             Yalnız MSSQL'de açılır (ray düğmesi ProfilerGorunur kapılı). -->
                        <!-- ⏱ SQL Agent sekmesi (v23-S16 — docs/11-sql-agent-arastirma.md, mockup
                             docs/mockup/sql-agent.html ONAYLI): durum rozeti + yönlendirme bandı · süzgeç
                             çipleri · Job Activity Monitor listesi · seçili job: Geçmiş/Adımlar/Zamanlamalar. -->
                        <DataTemplate DataType="{x:Type vm:AgentSekmesiViewModel}">
                            <DockPanel>
                                <!-- Durum çubuğu (alt) -->
                                <Border DockPanel.Dock="Bottom" Background="{DynamicResource DurumCubuguZeminFircasi}" Padding="12,4">
                                    <DockPanel TextElement.Foreground="{DynamicResource DurumCubuguMetinFircasi}" TextElement.FontSize="11.5">
                                        <TextBlock Text="{Binding SonYenileme}" DockPanel.Dock="Right" Margin="18,0,0,0" />
                                        <TextBlock Text="{Binding DurumCubugu}" Margin="0,0,18,0" />
                                        <TextBlock Text="{Binding Bilgi}" TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.AutomationId="LblAgentBilgi" />
                                    </DockPanel>
                                </Border>
                                <DockPanel Margin="14,10,14,8">
                                    <!-- Üst: durum rozeti + sunucu + arama + otomatik yenile + yenile -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Border Style="{StaticResource SonucRozeti}" Tag="{Binding DurumTuru}" CornerRadius="11" Padding="11,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DurumRozeti}" FontSize="12"
                                                       AutomationProperties.AutomationId="LblAgentDurum" />
                                        </Border>
                                        <Button DockPanel.Dock="Right" Content="⟳ Yenile" Padding="10,3" Margin="10,0,0,0"
                                                VerticalAlignment="Center" Command="{Binding YenileCommand}"
                                                AutomationProperties.AutomationId="BtnAgentYenile" />
                                        <Button DockPanel.Dock="Right" Content="＋ Yeni job" Padding="12,3" Margin="10,0,0,0"
                                                Style="{StaticResource BirincilDugme}" VerticalAlignment="Center"
                                                Command="{Binding YeniJobCommand}"
                                                ToolTip="Job oluşturma sihirbazı — script üretir, yeni sekmede açar (çalıştırmaz)"
                                                AutomationProperties.AutomationId="BtnAgentYeniJob" />
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource AnahtarKutusu}" Margin="12,0,0,0"
                                                  VerticalAlignment="Center" IsChecked="{Binding OtomatikYenile}"
                                                  Content="Otomatik yenile (10 sn)" Foreground="{DynamicResource SolukMetinFircasi}"
                                                  AutomationProperties.AutomationId="ChkAgentOtoYenile" />
                                        <Grid DockPanel.Dock="Right" Width="220" VerticalAlignment="Center">
                                            <TextBox Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                                                     AutomationProperties.AutomationId="TxtAgentAra" />
                                            <TextBlock Text="🔍 Job adında ara…" Margin="9,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Foreground="{DynamicResource ZayifMetinFircasi}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AramaMetni}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding SunucuBilgisi}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource SolukMetinFircasi}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <!-- Yönlendirme bandı: Agent yok / durmuş / yetki yok / okunamadı -->
                                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,8" CornerRadius="6" BorderThickness="1"
                                            Background="{DynamicResource UyariZeminFircasi}" BorderBrush="{DynamicResource UyariKenarFircasi}"
                                            Visibility="{Binding UyariVar, Converter={StaticResource BoolGorunurluk}}">
                                        <TextBlock Text="{Binding Uyari}" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource UyariMetinFircasi}"
                                                   AutomationProperties.AutomationId="LblAgentUyari" />
                                    </Border>
                                    <!-- Süzgeç çipleri + kategori -->
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" TextElement.FontSize="12">
                                        <ComboBox DockPanel.Dock="Right" MinWidth="150" ItemsSource="{Binding Kategoriler}"
                                                  SelectedItem="{Binding SeciliKategori}" VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="CmbAgentKategori" />
                                        <TextBlock DockPanel.Dock="Right" Text="Kategori:" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SuzgecCipi}" GroupName="AgentSuzgec" IsChecked="{Binding SuzgecTumu}"
                                                         AutomationProperties.AutomationId="CipAgentTumu">
                                                <TextBlock>Tümü <Run Text="{Binding TumSayisi, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource SuzgecCipi}" GroupName="AgentSuzgec" IsChecked="{Binding SuzgecHatali}"
                                                         AutomationProperties.AutomationId="CipAgentHatali">
                                                <TextBlock>❌ Son koşusu hata <Run Text="{Binding HataliSayisi, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource SuzgecCipi}" GroupName="AgentSuzgec" IsChecked="{Binding SuzgecCalisan}"
                                                         AutomationProperties.AutomationId="CipAgentCalisan">
                                                <TextBlock>▶ Şu an çalışan <Run Text="{Binding CalisanSayisi, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource SuzgecCipi}" GroupName="AgentSuzgec" IsChecked="{Binding SuzgecKapali}"
                                                         AutomationProperties.AutomationId="CipAgentKapali">
                                                <TextBlock>⏸ Kapalı <Run Text="{Binding KapaliSayisi, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                                            </RadioButton>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" MinHeight="120" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="1.1*" MinHeight="160" />
                                        </Grid.RowDefinitions>
                                        <!-- Job Activity Monitor -->
                                        <DataGrid Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                  HeadersVisibility="Column" EnableRowVirtualization="True" SelectionMode="Single"
                                                  ItemsSource="{Binding Joblar}" SelectedItem="{Binding SeciliJob}"
                                                  FontFamily="Segoe UI" FontSize="12.5"
                                                  AutomationProperties.AutomationId="AgentJobGrid">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Acik}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource ZayifMetinFircasi}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Açık" Binding="{Binding AcikIsareti}" Width="44" />
                                                <DataGridTextColumn Header="Job" Binding="{Binding Ad}" Width="2*" />
                                                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="1.2*" />
                                                <DataGridTextColumn Header="Son koşu" Binding="{Binding SonKosuMetni}" Width="140" />
                                                <DataGridTemplateColumn Header="Sonuç" Width="170">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource SonucRozeti}" Tag="{Binding SonucTuru}" Margin="2,1">
                                                                <TextBlock Text="{Binding SonucMetni}" FontSize="11.5" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Süre" Binding="{Binding SureMetni}" Width="86" FontFamily="Consolas" />
                                                <DataGridTextColumn Header="Sonraki koşu" Binding="{Binding SonrakiMetni}" Width="140" />
                                                <DataGridTextColumn Header="Sahip" Binding="{Binding Sahip}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="6"
                                                      Background="{DynamicResource SeritFircasi}" />
                                        <!-- Seçili job detayı -->
                                        <TextBlock Grid.Row="2" Text="Ayrıntı için listeden bir job seçin."
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SolukMetinFircasi}"
                                                   Visibility="{Binding JobSecili, Converter={StaticResource TersBoolGorunurluk}}" />
                                        <DockPanel Grid.Row="2" Margin="0,8,0,0"
                                                   Visibility="{Binding JobSecili, Converter={StaticResource BoolGorunurluk}}">
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource BirincilDugme}" Padding="12,4" Margin="0,0,6,0"
                                                            Content="▶ Başlat ▾" Click="AgentBaslatMenu_Click" IsEnabled="{Binding BaslatAcik}"
                                                            AutomationProperties.AutomationId="BtnAgentBaslat">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="▶ Baştan başlat" Command="{Binding BaslatCommand}"
                                                                          AutomationProperties.AutomationId="MnuAgentBastan" />
                                                                <MenuItem Header="{Binding SeciliAdimdanMetni}" Command="{Binding SeciliAdimdanBaslatCommand}"
                                                                          AutomationProperties.AutomationId="MnuAgentSeciliAdim" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                    <Button Content="■ Durdur" Padding="10,4" Margin="0,0,6,0"
                                                            Command="{Binding DurdurCommand}" IsEnabled="{Binding DurdurAcik}"
                                                            AutomationProperties.AutomationId="BtnAgentDurdur" />
                                                    <Button Content="{Binding AcKapatMetni}" Padding="10,4" Margin="0,0,6,0"
                                                            Command="{Binding AcKapatCommand}" IsEnabled="{Binding AcKapatAcik}"
                                                            AutomationProperties.AutomationId="BtnAgentAcKapat" />
                                                    <Button Content="✎ Düzenle" Padding="10,4" Margin="0,0,6,0"
                                                            Command="{Binding JobDuzenleCommand}"
                                                            ToolTip="Sihirbazda düzenle — script job'u SİLMEDEN günceller (geçmiş korunur)"
                                                            AutomationProperties.AutomationId="BtnAgentDuzenle" />
                                                    <Button Content="⧉ Kopyasını oluştur" Padding="10,4" Margin="0,0,6,0"
                                                            Command="{Binding JobKopyalaCommand}"
                                                            AutomationProperties.AutomationId="BtnAgentKopya" />
                                                    <Button Content="📜 Script olarak al" Padding="10,4"
                                                            Command="{Binding ScriptOlarakAlCommand}"
                                                            ToolTip="Job'u yeniden oluşturan script'i yeni sorgu sekmesinde açar (çalıştırmaz) — başka sunucuya taşımak için"
                                                            AutomationProperties.AutomationId="BtnAgentScript" />
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding SeciliJob.Ad, Mode=OneWay}" FontWeight="Bold" FontSize="14"
                                                         Foreground="{DynamicResource MetinFircasi}" />
                                                    <Run Text="{Binding SeciliJobAciklama, Mode=OneWay}" FontSize="12"
                                                         Foreground="{DynamicResource SolukMetinFircasi}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TabControl SelectedIndex="{Binding AltSekme}" AutomationProperties.AutomationId="AgentAltSekme">
                                                <TabItem AutomationProperties.AutomationId="TabAgentGecmis">
                                                    <TabItem.Header>
                                                        <TextBlock>Geçmiş <Run Text="{Binding Gecmis.Count, Mode=OneWay}" Foreground="{DynamicResource SolukMetinFircasi}" /></TextBlock>
                                                    </TabItem.Header>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.4*" />
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>
                                                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                                  HeadersVisibility="Column" SelectionMode="Single"
                                                                  ItemsSource="{Binding Gecmis}" SelectedItem="{Binding SeciliGecmis}"
                                                                  FontFamily="Segoe UI" FontSize="12.5"
                                                                  AutomationProperties.AutomationId="AgentGecmisGrid">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Koşu" Binding="{Binding ZamanMetni}" Width="140" />
                                                                <DataGridTextColumn Header="Adım" Binding="{Binding AdimMetni}" Width="1*" />
                                                                <DataGridTemplateColumn Header="Sonuç" Width="96">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource SonucRozeti}" Tag="{Binding SonucTuru}" Margin="2,1">
                                                                                <TextBlock Text="{Binding SonucMetni}" FontSize="11.5" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn Header="Süre" Binding="{Binding SureMetni}" Width="76" FontFamily="Consolas" />
                                                                <DataGridTextColumn Header="Mesaj" Binding="{Binding TekSatirMesaj}" Width="2*" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <DockPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock DockPanel.Dock="Top" Text="Seçili satırın tam mesajı" FontSize="11.5"
                                                                       Margin="0,0,0,4" Foreground="{DynamicResource SolukMetinFircasi}" />
                                                            <TextBox Text="{Binding TamMesaj, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                                                     VerticalContentAlignment="Top"
                                                                     AutomationProperties.AutomationId="TxtAgentTamMesaj" />
                                                        </DockPanel>
                                                    </Grid>
                                                </TabItem>
                                                <TabItem AutomationProperties.AutomationId="TabAgentAdimlar">
                                                    <TabItem.Header>
                                                        <TextBlock>Adımlar <Run Text="{Binding Adimlar.Count, Mode=OneWay}" Foreground="{DynamicResource SolukMetinFircasi}" /></TextBlock>
                                                    </TabItem.Header>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.4*" />
                                                            <ColumnDefinition Width="1*" />
                                                        </Grid.ColumnDefinitions>
                                                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                                  HeadersVisibility="Column" SelectionMode="Single"
                                                                  ItemsSource="{Binding Adimlar}" SelectedItem="{Binding SeciliAdim}"
                                                                  FontFamily="Segoe UI" FontSize="12.5"
                                                                  AutomationProperties.AutomationId="AgentAdimGrid">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="36" />
                                                                <DataGridTextColumn Header="Adım" Binding="{Binding Ad}" Width="1.3*" />
                                                                <DataGridTextColumn Header="Tür" Binding="{Binding Tur}" Width="86" />
                                                                <DataGridTextColumn Header="Veritabanı" Binding="{Binding Veritabani}" Width="1*" />
                                                                <DataGridTextColumn Header="Başarıda" Binding="{Binding BasaridaMetni}" Width="1*" />
                                                                <DataGridTextColumn Header="Hatada" Binding="{Binding HatadaMetni}" Width="1.4*" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <DockPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                                <Button DockPanel.Dock="Right" Content="Sorgu sekmesinde aç" Padding="8,2"
                                                                        Command="{Binding AdimiSekmedeAcCommand}"
                                                                        AutomationProperties.AutomationId="BtnAgentAdimAc" />
                                                                <TextBlock Text="Seçili adımın komutu" FontSize="11.5" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SolukMetinFircasi}" />
                                                            </DockPanel>
                                                            <TextBox Text="{Binding SeciliAdim.Komut, Mode=OneWay}" IsReadOnly="True"
                                                                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                                     VerticalContentAlignment="Top"
                                                                     AutomationProperties.AutomationId="TxtAgentAdimKomut" />
                                                        </DockPanel>
                                                    </Grid>
                                                </TabItem>
                                                <TabItem AutomationProperties.AutomationId="TabAgentZamanlamalar">
                                                    <TabItem.Header>
                                                        <TextBlock>Zamanlamalar <Run Text="{Binding Zamanlamalar.Count, Mode=OneWay}" Foreground="{DynamicResource SolukMetinFircasi}" /></TextBlock>
                                                    </TabItem.Header>
                                                    <DataGrid Margin="0,6,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                              HeadersVisibility="Column" ItemsSource="{Binding Zamanlamalar}"
                                                              FontFamily="Segoe UI" FontSize="12.5"
                                                              AutomationProperties.AutomationId="AgentZamanlamaGrid">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Ad" Binding="{Binding Ad}" Width="1*" />
                                                            <DataGridTextColumn Header="Açık" Binding="{Binding AcikIsareti}" Width="50" />
                                                            <DataGridTextColumn Header="Ne zaman" Binding="{Binding Metin}" Width="3*" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </TabItem>
                                            </TabControl>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </DockPanel>
                        </DataTemplate>
                        <!-- 🔎 FTS sekmesi (v23 S1+S2): keşif/envanter + arama yardımcısı + kurulum sihirbazı -->
                        <DataTemplate DataType="{x:Type vm:FtsSekmesiViewModel}">
                            <DockPanel Margin="14">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Veritabanı:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MetinFircasi}" />
                                    <ComboBox MinWidth="170" VerticalAlignment="Center"
                                              ItemsSource="{Binding Veritabanlari}" SelectedItem="{Binding SecilenVeritabani}"
                                              AutomationProperties.AutomationId="CmbFtsVeritabani" />
                                    <Button Content="🔄 Yenile" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding YenileCommand}" AutomationProperties.AutomationId="BtnFtsYenile" />
                                    <TextBlock Text="{Binding Ozet}" TextWrapping="Wrap" Margin="14,0,0,0" FontSize="12.5"
                                               VerticalAlignment="Center" Foreground="{DynamicResource BilgiMetinFircasi}"
                                               AutomationProperties.AutomationId="LblFtsOzet" />
                                </DockPanel>
                                <Grid IsEnabled="{Binding KuruluMu, FallbackValue=False, TargetNullValue=False}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" MinHeight="110" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- S4 (v23-S17): Index'ler (envanter + yönetim şeridi) · Kataloglar · Stoplist'ler -->
                                    <TabControl Grid.Row="0" AutomationProperties.AutomationId="FtsYonetimSekmeleri">
                                        <TabItem Header="Index'ler" AutomationProperties.AutomationId="TabFtsIndexler">
                                            <DockPanel Margin="0,6,0,0">
                                                <!-- Seçili index'in yönetim şeridi -->
                                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" IsEnabled="{Binding YonetimAcik}">
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding YonetimNotu}" FontSize="11.5" Margin="0,4,0,0"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource BilgiMetinFircasi}"
                                                               AutomationProperties.AutomationId="LblFtsYonetimNotu" />
                                                    <WrapPanel>
                                                        <Button Content="▶ Tam doldur" Padding="10,3" Margin="0,0,6,4"
                                                                Command="{Binding TamDoldurCommand}"
                                                                ToolTip="Tüm tabloyu baştan tarar (START FULL POPULATION)"
                                                                AutomationProperties.AutomationId="BtnFtsTamDoldur" />
                                                        <Button Content="↻ Artımlı doldur" Padding="10,3" Margin="0,0,6,4"
                                                                Command="{Binding ArtimliDoldurCommand}" IsEnabled="{Binding ArtimliMumkun}"
                                                                ToolTip="Yalnız değişen satırlar (tabloda timestamp/rowversion kolonu gerekir)"
                                                                ToolTipService.ShowOnDisabled="True"
                                                                AutomationProperties.AutomationId="BtnFtsArtimli" />
                                                        <Button Content="⇪ Bekleyenleri işle" Padding="10,3" Margin="0,0,6,4"
                                                                Command="{Binding BekleyenleriIsleCommand}"
                                                                ToolTip="Değişiklik izleme MANUAL iken biriken değişiklikleri index'e yansıtır (START UPDATE POPULATION)"
                                                                AutomationProperties.AutomationId="BtnFtsBekleyen" />
                                                        <Button Content="■ Durdur" Padding="10,3" Margin="0,0,14,4"
                                                                Command="{Binding DoldurmaDurdurCommand}"
                                                                AutomationProperties.AutomationId="BtnFtsDurdur" />
                                                        <TextBlock Text="Değişiklik izleme:" VerticalAlignment="Center" Margin="0,0,6,4"
                                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                                        <ComboBox Width="90" Margin="0,0,6,4" ItemsSource="{Binding IzlemeModlari}"
                                                                  SelectedItem="{Binding SeciliIzleme}"
                                                                  AutomationProperties.AutomationId="CmbFtsIzleme" />
                                                        <Button Content="Uygula" Padding="10,3" Margin="0,0,14,4"
                                                                Command="{Binding IzlemeUygulaCommand}"
                                                                AutomationProperties.AutomationId="BtnFtsIzlemeUygula" />
                                                        <Button Content="⏸ Etkin / devre dışı" Padding="10,3" Margin="0,0,6,4"
                                                                Command="{Binding EtkinlikDegistirCommand}"
                                                                AutomationProperties.AutomationId="BtnFtsEtkinlik" />
                                                        <Button Content="🗑 Silme script'i" Padding="10,3" Margin="0,0,6,4"
                                                                Command="{Binding SilmeScriptiUretCommand}"
                                                                ToolTip="DROP FULLTEXT INDEX script'ini sekmede açar (çalıştırmaz)"
                                                                AutomationProperties.AutomationId="BtnFtsSilScript" />
                                                        <TextBlock Text="● canlı izleniyor" VerticalAlignment="Center" Margin="8,0,0,4" FontSize="11.5"
                                                                   Foreground="{DynamicResource BasariFircasi}"
                                                                   Visibility="{Binding CanliIzleniyor, Converter={StaticResource BoolGorunurluk}}" />
                                                    </WrapPanel>
                                                </DockPanel>
                                                <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                          HeadersVisibility="Column" EnableRowVirtualization="True"
                                                          ItemsSource="{Binding Envanter}" SelectedItem="{Binding SeciliEnvanter}"
                                                          FontFamily="Segoe UI" FontSize="12.5"
                                                          AutomationProperties.AutomationId="FtsEnvanterGrid">
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="🗑 Silme script'ini üret (çalıştırmaz)"
                                                                      Command="{Binding SilmeScriptiUretCommand}" />
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Tablo" Binding="{Binding TamAd}" Width="1.2*" />
                                                        <DataGridTextColumn Header="Katalog" Binding="{Binding Katalog}" Width="*" />
                                                        <DataGridTextColumn Header="Kolonlar (dil)" Binding="{Binding Kolonlar}" Width="1.6*" />
                                                        <DataGridTextColumn Header="Öğe" Binding="{Binding OgeMetni}" Width="70" />
                                                        <DataGridTextColumn Header="Bekleyen" Binding="{Binding BekleyenMetni}" Width="70" />
                                                        <DataGridTextColumn Header="İzleme" Binding="{Binding Izleme}" Width="70" />
                                                        <DataGridTemplateColumn Header="Doldurma" Width="160" SortMemberPath="Doldurma">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource SonucRozeti}" Tag="{Binding Doldurma, Converter={StaticResource RozetTuru}}">
                                                                        <TextBlock Text="{Binding Doldurma}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Son doldurma" Binding="{Binding SonDoldurmaMetni}" Width="250" />
                                                        <DataGridTextColumn Header="Stoplist" Binding="{Binding Stoplist}" Width="80" />
                                                        <DataGridTemplateColumn Header="Etkin" Width="110" SortMemberPath="EtkinMetni">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource SonucRozeti}" Tag="{Binding EtkinMetni, Converter={StaticResource RozetTuru}}">
                                                                        <TextBlock Text="{Binding EtkinMetni}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </TabItem>
                                        <TabItem Header="Kataloglar" AutomationProperties.AutomationId="TabFtsKataloglar">
                                            <DockPanel Margin="0,6,0,0">
                                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" IsEnabled="{Binding KatalogSecili}">
                                                    <Button Content="⧉ Birleştir (REORGANIZE)" Padding="10,3" Margin="0,0,6,0"
                                                            Command="{Binding KatalogDuzenleCommand}"
                                                            ToolTip="Parçalı index'leri tek index'te toplar — sorgu hızlanır; çevrimiçi, hafif"
                                                            AutomationProperties.AutomationId="BtnFtsKatalogDuzenle" />
                                                    <Button Content="★ Varsayılan yap" Padding="10,3" Margin="0,0,14,0"
                                                            Command="{Binding KatalogVarsayilanYapCommand}"
                                                            AutomationProperties.AutomationId="BtnFtsKatalogVarsayilan" />
                                                    <Button Content="📜 Yeniden kurma script'i" Padding="10,3" Margin="0,0,6,0"
                                                            Command="{Binding KatalogYenidenKurScriptiUretCommand}"
                                                            ToolTip="REBUILD — tüm index'ler baştan dolar; ağır iş, script sekmede açılır (çalıştırmaz)"
                                                            AutomationProperties.AutomationId="BtnFtsKatalogRebuild" />
                                                    <Button Content="🗑 Silme script'i" Padding="10,3"
                                                            Command="{Binding KatalogSilmeScriptiUretCommand}"
                                                            AutomationProperties.AutomationId="BtnFtsKatalogSil" />
                                                </WrapPanel>
                                                <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                          HeadersVisibility="Column"
                                                          ItemsSource="{Binding KatalogDetaylari}" SelectedItem="{Binding SeciliKatalogDetay}"
                                                          FontFamily="Segoe UI" FontSize="12.5"
                                                          AutomationProperties.AutomationId="FtsKatalogGrid">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Katalog" Binding="{Binding Ad}" Width="1.5*" />
                                                        <DataGridTextColumn Header="" Binding="{Binding VarsayilanMetni}" Width="100" />
                                                        <DataGridTextColumn Header="Index" Binding="{Binding IndexSayisi}" Width="60" />
                                                        <DataGridTextColumn Header="Öğe" Binding="{Binding OgeMetni}" Width="90" />
                                                        <DataGridTextColumn Header="Boyut" Binding="{Binding BoyutMetni}" Width="80" />
                                                        <DataGridTemplateColumn Header="Durum" Width="1.5*" SortMemberPath="Durum">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource SonucRozeti}" Tag="{Binding Durum, Converter={StaticResource RozetTuru}}">
                                                                        <TextBlock Text="{Binding Durum}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </TabItem>
                                        <TabItem Header="Stoplist'ler" AutomationProperties.AutomationId="TabFtsStoplist">
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.6*" />
                                                </Grid.ColumnDefinitions>
                                                <ListBox ItemsSource="{Binding Stoplistler}" SelectedItem="{Binding SeciliStoplist}"
                                                         DisplayMemberPath="Gosterim" Margin="0,0,8,0"
                                                         AutomationProperties.AutomationId="ListFtsStoplist" />
                                                <DockPanel Grid.Column="1">
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                        <TextBlock Text="Dil:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                                        <ComboBox Width="170" HorizontalAlignment="Left" ItemsSource="{Binding Diller}"
                                                                  SelectedIndex="{Binding StopDilIndex}"
                                                                  AutomationProperties.AutomationId="CmbFtsStopDil" />
                                                        <TextBlock Text="{Binding StopKelimeOzeti}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                                    </DockPanel>
                                                    <ListBox ItemsSource="{Binding StopKelimeleri}" FontFamily="Consolas"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             AutomationProperties.AutomationId="ListFtsStopKelime">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                    </ListBox>
                                                </DockPanel>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                    <!-- Arama yardımcısı + kurulum sihirbazı yan yana -->
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <GroupBox Grid.Column="0" Header="🔎 Ara (CONTAINS / FREETEXT)" Margin="0,0,6,0"
                                                  Foreground="{DynamicResource MetinFircasi}">
                                            <StackPanel Margin="6">
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Tablo:" Width="60" VerticalAlignment="Center" />
                                                    <ComboBox ItemsSource="{Binding AramaTablolari}" SelectedItem="{Binding SeciliAramaTablo}"
                                                              AutomationProperties.AutomationId="CmbFtsAramaTablo" />
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Kolon:" Width="60" VerticalAlignment="Center" />
                                                    <ComboBox ItemsSource="{Binding KolonSecenekleri}" SelectedItem="{Binding SeciliKolon}"
                                                              AutomationProperties.AutomationId="CmbFtsKolon" />
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Kip:" Width="60" VerticalAlignment="Center" />
                                                    <ComboBox ItemsSource="{Binding Kipler}" SelectedIndex="{Binding SecilenKipIndex}"
                                                              AutomationProperties.AutomationId="CmbFtsKip" />
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Terim:" Width="60" VerticalAlignment="Center" />
                                                    <TextBox Text="{Binding Terim, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"
                                                             AutomationProperties.AutomationId="TxtFtsTerim" />
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,6"
                                                           Visibility="{Binding IkinciTerimGorunur, Converter={StaticResource BoolGorunurluk}}">
                                                    <TextBlock Text="2. terim:" Width="60" VerticalAlignment="Center" />
                                                    <TextBox DockPanel.Dock="Left" Width="140" Text="{Binding IkinciTerim}" Padding="4,2"
                                                             AutomationProperties.AutomationId="TxtFtsIkinciTerim" />
                                                    <TextBlock Text="  mesafe:" VerticalAlignment="Center" />
                                                    <TextBox Width="44" Text="{Binding Mesafe}" Padding="4,2" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="▶ Ara" Padding="16,4"
                                                            Style="{StaticResource BirincilDugme}" Command="{Binding AraCommand}"
                                                            AutomationProperties.AutomationId="BtnFtsAra" />
                                                    <CheckBox Content="Skorlu (RANK — en alakalı üstte)" VerticalAlignment="Center"
                                                              IsChecked="{Binding Rankli}" Foreground="{DynamicResource MetinFircasi}" />
                                                    <TextBlock Text="  TOP" VerticalAlignment="Center" />
                                                    <TextBox Width="56" Text="{Binding Tavan}" Padding="4,2" Margin="4,0,0,0"
                                                             HorizontalAlignment="Left" />
                                                </DockPanel>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Grid.Column="1" Header="🧰 Index kurulum sihirbazı (script üretir — çalıştırmaz)"
                                                  Margin="6,0,0,0" Foreground="{DynamicResource MetinFircasi}">
                                            <StackPanel Margin="6">
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Tablo:" Width="60" VerticalAlignment="Center" />
                                                    <ComboBox ItemsSource="{Binding SihirbazTablolari}" SelectedItem="{Binding SeciliSihirbazTablo}"
                                                              AutomationProperties.AutomationId="CmbFtsSihirbazTablo" />
                                                </DockPanel>
                                                <ListBox ItemsSource="{Binding SihirbazKolonlari}" MaxHeight="96" Margin="0,0,0,6"
                                                         AutomationProperties.AutomationId="ListFtsKolonlar">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding Secili}" VerticalContentAlignment="Center">
                                                                <TextBlock><Run Text="{Binding Ad, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Tip, Mode=OneWay}" Foreground="{DynamicResource SolukMetinFircasi}" /></TextBlock>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Dil:" Width="60" VerticalAlignment="Center" />
                                                    <ComboBox DockPanel.Dock="Left" Width="170" HorizontalAlignment="Left"
                                                              ItemsSource="{Binding Diller}" SelectedIndex="{Binding SecilenDilIndex}"
                                                              AutomationProperties.AutomationId="CmbFtsDil" />
                                                    <TextBlock Text="  Katalog:" VerticalAlignment="Center" />
                                                    <ComboBox IsEditable="True" Margin="4,0,0,0"
                                                              ItemsSource="{Binding Kataloglar}" Text="{Binding SeciliKatalog}"
                                                              AutomationProperties.AutomationId="CmbFtsKatalog" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="📜 Script üret" Padding="12,4"
                                                            Command="{Binding ScriptUretCommand}"
                                                            AutomationProperties.AutomationId="BtnFtsScriptUret" />
                                                    <TextBlock Text="{Binding SihirbazNotu}" TextWrapping="Wrap" FontSize="11.5"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource SolukMetinFircasi}"
                                                               AutomationProperties.AutomationId="LblFtsSihirbazNotu" />
                                                </DockPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfilerSekmesiViewModel}">
                            <DataTemplate.Resources>
                                <conv:HucreMetniConverter x:Key="PTekSatir" />
                            </DataTemplate.Resources>
                            <DockPanel Margin="14">
                                <!-- Kurulum + kontrol çubuğu -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Şablon:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MetinFircasi}" />
                                    <ComboBox MinWidth="180" Margin="0,0,12,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding Sablonlar}" SelectedIndex="{Binding SecilenSablonIndex}"
                                              IsEnabled="{Binding Bosta}"
                                              AutomationProperties.AutomationId="CmbProfilerSablon" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                                Visibility="{Binding EsikGorunur, Converter={StaticResource BoolGorunurluk}}">
                                        <TextBlock Text="Eşik:" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource MetinFircasi}" />
                                        <TextBox Width="64" Text="{Binding EsikMs, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" IsEnabled="{Binding Bosta}"
                                                 AutomationProperties.AutomationId="TxtProfilerEsik" />
                                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                    </StackPanel>
                                    <TextBlock Text="Veritabanı:" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource MetinFircasi}" />
                                    <ComboBox MinWidth="130" Margin="0,0,12,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding VeritabaniSecenekleri}" SelectedItem="{Binding SecilenVeritabani}"
                                              IsEnabled="{Binding Bosta}"
                                              ToolTip="Sunucu tarafında bu veritabanına süzülür; (tümü) = süzgeç yok"
                                              AutomationProperties.AutomationId="CmbProfilerVeritabani" />
                                    <Button Content="▶ İzlemeyi başlat" Padding="14,4" Margin="0,0,8,0"
                                            Style="{StaticResource BirincilDugme}" Command="{Binding BaslatCommand}"
                                            AutomationProperties.AutomationId="BtnProfilerBaslat" />
                                    <ToggleButton Content="⏸ Duraklat" Padding="10,4" Margin="0,0,8,0"
                                                  IsChecked="{Binding Duraklatildi, Mode=TwoWay}"
                                                  IsEnabled="{Binding Calisiyor}"
                                                  ToolTip="Okumayı duraklatır — sunucudaki oturum akmaya devam eder, sürdürünce birikenler gelir"
                                                  AutomationProperties.AutomationId="BtnProfilerDuraklat" />
                                    <Button Content="■ Durdur" Padding="10,4" Margin="0,0,8,0"
                                            Command="{Binding DurdurCommand}"
                                            ToolTip="İzlemeyi durdurur ve oturumu sunucudan siler"
                                            AutomationProperties.AutomationId="BtnProfilerDurdur" />
                                    <Button Content="🧹 Temizle" Padding="10,4" Command="{Binding TemizleCommand}"
                                            ToolTip="Ekrandaki akışı temizler (izleme sürüyorsa devam eder)"
                                            AutomationProperties.AutomationId="BtnProfilerTemizle" />
                                    <!-- v23-S2: imza gruplama — Log Analizi'nin motoru (LogAnaliz.Imza) -->
                                    <ToggleButton Content="🧠 Grupla" Padding="10,4" Margin="8,0,0,0"
                                                  IsChecked="{Binding GruplaAcik, Mode=TwoWay}"
                                                  ToolTip="Aynı sorgunun parametre varyantlarını tek satırda toplar (kez · ort · maks); ham akış arkada birikmeye devam eder"
                                                  AutomationProperties.AutomationId="BtnProfilerGrupla" />
                                    <Grid DockPanel.Dock="Right" Width="220" HorizontalAlignment="Right">
                                        <TextBox Padding="24,3,6,3" Text="{Binding SonucSuz, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Akışı metne göre süz (sorgu metni · uygulama · veritabanı · kullanıcı)"
                                                 AutomationProperties.AutomationId="TxtProfilerSuz" />
                                        <TextBlock Text="🔎" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource SolukMetinFircasi}" />
                                    </Grid>
                                    <Border />
                                </DockPanel>

                                <!-- Özet bandı + dışa aktarma -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource KenarFircasi}" Padding="10,7" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="⬇ CSV" Padding="10,2" Margin="8,0,0,0"
                                                Click="ProfilerCsv_Click" ToolTip="Ekrandaki akışı CSV dosyasına aktar"
                                                AutomationProperties.AutomationId="BtnProfilerCsv" />
                                        <!-- v23-S4: seçili olayı/grubu asistana yorumlat -->
                                        <Button DockPanel.Dock="Right" Content="🤖 AI Yorumla" Padding="10,2" Margin="8,0,0,0"
                                                Command="{Binding AiYorumlaCommand}" Style="{StaticResource BirincilDugme}"
                                                Visibility="{Binding AiGorunur, Converter={StaticResource BoolGorunurluk}}"
                                                ToolTip="Seçili olayı/grubu/kilitlenmeyi asistana yorumlatır: muhtemel neden + somut öneri (index/sorgu)"
                                                AutomationProperties.AutomationId="BtnProfilerAi" />
                                        <Button DockPanel.Dock="Right" Content="⧉ Kopyala" Padding="10,2" Margin="8,0,0,0"
                                                Click="ProfilerKopyala_Click" ToolTip="Ekrandaki akışı panoya kopyala (sekmeyle ayrılmış)"
                                                AutomationProperties.AutomationId="BtnProfilerKopyala" />
                                        <TextBlock Text="{Binding Ozet}" TextWrapping="Wrap" Foreground="{DynamicResource BilgiMetinFircasi}"
                                                   FontSize="12.5" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="LblProfilerOzet" />
                                    </DockPanel>
                                </Border>

                                <!-- 🤖 AI yorumu (v23-S4, kapalı başlar) -->
                                <Expander DockPanel.Dock="Bottom" Header="🤖 AI yorumu" Margin="0,6,0,0"
                                          IsExpanded="{Binding AiYorumAcik, Mode=TwoWay}"
                                          Visibility="{Binding AiGorunur, Converter={StaticResource BoolGorunurluk}}"
                                          AutomationProperties.AutomationId="ExpProfilerAi">
                                    <TextBox Text="{Binding AiYorum, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             MaxHeight="170" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                             Background="Transparent" FontSize="12.5"
                                             AutomationProperties.AutomationId="TxtProfilerAi" />
                                </Expander>

                                <!-- Seçili satırın tam metni (olay ↔ grup — TamMetin aktif görünümü izler) -->
                                <Border DockPanel.Dock="Bottom" Height="130" Margin="0,8,0,0"
                                        BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="1" CornerRadius="3"
                                        Background="{DynamicResource PanelZeminFircasi}"
                                        Visibility="{Binding TamMetin, Converter={StaticResource DegerVarsaGorunur}}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
                                            <!-- v23-S3: seçili satır kilitlenme raporuysa görsel şema -->
                                            <Button DockPanel.Dock="Right" Content="🕸 Şemayı aç" Padding="10,2"
                                                    Click="ProfilerDeadlockAc_Click"
                                                    Visibility="{Binding DeadlockSecili, Converter={StaticResource BoolGorunurluk}}"
                                                    ToolTip="Kilitlenmeyi görsel şemada aç: kim kimi bekliyor, kurban hangisi (çift tık da olur)"
                                                    AutomationProperties.AutomationId="BtnProfilerDeadlock" />
                                            <!-- v23-S5: akıştaki sorguyu editöre taşı — incele, planına bak, düzelt -->
                                            <Button DockPanel.Dock="Right" Content="⧉ Sekmede aç" Padding="10,2" Margin="0,0,8,0"
                                                    Click="ProfilerSekmedeAc_Click"
                                                    Visibility="{Binding SekmedeAcilabilir, Converter={StaticResource BoolGorunurluk}}"
                                                    ToolTip="Seçili sorguyu yeni sorgu sekmesinde açar (olayın veritabanı önseçili) — planına bak, düzelt, çalıştır"
                                                    AutomationProperties.AutomationId="BtnProfilerSekmedeAc" />
                                            <TextBlock Text="Seçili satırın tam metni" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SolukMetinFircasi}" />
                                        </DockPanel>
                                        <TextBox Text="{Binding TamMetin, Mode=OneWay}" IsReadOnly="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                                 Background="Transparent" FontFamily="{StaticResource KodYazisi}" FontSize="12"
                                                 Padding="8,0,8,8" AutomationProperties.AutomationId="TxtProfilerTamMetin" />
                                    </DockPanel>
                                </Border>

                                <!-- Canlı akış ↔ 🧠 grup görünümü: Grupla anahtarı iki grid arasında geçirir -->
                                <Grid>
                                <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" EnableRowVirtualization="True"
                                          ItemsSource="{Binding Olaylar}" SelectedItem="{Binding SeciliOlay}"
                                          MouseDoubleClick="ProfilerDeadlockAc_Click"
                                          AutomationProperties.AutomationId="ProfilerGrid">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GruplaAcik}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Zaman" Width="96"
                                                            Binding="{Binding Zaman, StringFormat='HH:mm:ss.fff'}" />
                                        <DataGridTemplateColumn Header="Olay" Width="82" SortMemberPath="Olay">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SonucRozeti}" Tag="{Binding Olay, Converter={StaticResource RozetTuru}}">
                                                        <TextBlock Text="{Binding Olay}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Süre ms" Width="72" Binding="{Binding SureMs}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,0,10,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="CPU ms" Width="66" Binding="{Binding CpuMs}" />
                                        <DataGridTextColumn Header="Reads" Width="66" Binding="{Binding Reads}" />
                                        <DataGridTextColumn Header="Satır" Width="56" Binding="{Binding SatirSayisi}" />
                                        <DataGridTextColumn Header="Veritabanı" Width="96" Binding="{Binding Veritabani}" />
                                        <DataGridTextColumn Header="Uygulama" Width="110" Binding="{Binding Uygulama}" />
                                        <DataGridTextColumn Header="Kullanıcı" Width="96" Binding="{Binding Kullanici}" />
                                        <DataGridTextColumn Header="SPID" Width="50" Binding="{Binding Spid}" />
                                        <DataGridTemplateColumn Header="Metin" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Metin, Converter={StaticResource PTekSatir}}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Metin}"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- 🧠 Grup görünümü (v23-S2): imza başına canlı sayaçlar -->
                                <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" EnableRowVirtualization="True"
                                          ItemsSource="{Binding Gruplar}" SelectedItem="{Binding SeciliGrup}"
                                          Visibility="{Binding GruplaAcik, Converter={StaticResource BoolGorunurluk}}"
                                          AutomationProperties.AutomationId="ProfilerGrupGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kez" Width="60" Binding="{Binding Kez}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,0,10,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Ort ms" Width="70" Binding="{Binding OrtMs}" />
                                        <DataGridTextColumn Header="Maks ms" Width="76" Binding="{Binding MaksMs}" />
                                        <DataGridTextColumn Header="Toplam CPU ms" Width="108" Binding="{Binding ToplamCpuMs}" />
                                        <DataGridTextColumn Header="İlk" Width="90"
                                                            Binding="{Binding IlkZaman, StringFormat='HH:mm:ss'}" />
                                        <DataGridTextColumn Header="Son" Width="90"
                                                            Binding="{Binding SonZaman, StringFormat='HH:mm:ss'}" />
                                        <DataGridTemplateColumn Header="Olay" Width="82" SortMemberPath="Olay">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SonucRozeti}" Tag="{Binding Olay, Converter={StaticResource RozetTuru}}">
                                                        <TextBlock Text="{Binding Olay}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Örnek metin" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OrnekMetin, Converter={StaticResource PTekSatir}}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding OrnekMetin}"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>

                        <!-- Execution plan sekmesi (V5-S1). Yönetim Paneli'nden AYRIDIR:
                             burada ŞU sorgunun planı vardır, panel sunucu genelini inceler. -->
                        <!-- Metin arama sekmesi (V5-S2): solda eşleşen nesneler, sağda o nesnedeki
                             eşleşen satırlar. Satıra çift tıklama tanımı yeni sorgu sekmesinde
                             O SATIRDA açar (tanım sonuçta saklı — sunucuya yeniden gidilmez). -->
                        <DataTemplate DataType="{x:Type vm:AramaSekmesiViewModel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="4">
                                    <TextBlock DockPanel.Dock="Left" Text="DB:" VerticalAlignment="Center"
                                               Margin="0,0,4,0" Foreground="{DynamicResource SolukMetinFircasi}" />
                                    <ComboBox DockPanel.Dock="Left" MinWidth="150" Margin="0,0,8,0"
                                              ItemsSource="{Binding VeritabaniAdlari}"
                                              SelectedItem="{Binding SecilenVeritabani}"
                                              ToolTip="Aramanın yapılacağı veritabanı. Değiştirince önceki sonuçlar temizlenir."
                                              AutomationProperties.AutomationId="CmbAramaVeritabani" />
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,3"
                                            Content="Ara" IsDefault="True"
                                            Command="{Binding AraCommand}"
                                            AutomationProperties.AutomationId="BtnAramaCalistir" />
                                    <CheckBox DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                                              Content="BÜYÜK/küçük duyarlı"
                                              IsChecked="{Binding BuyukKucukDuyarli}"
                                              ToolTip="Kapalıyken sunucunun karşılaştırma kuralı geçerlidir; açıkken sonuçlar istemcide ayrıca daraltılır."
                                              AutomationProperties.AutomationId="ChkAramaDuyarli" />
                                    <TextBox Text="{Binding Aranan, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Padding="4,3"
                                             AutomationProperties.AutomationId="TxtAranan" />
                                </DockPanel>

                                <!-- Kapsam AÇIKÇA yazar: "bulunamadı" yanlış yorumlanmasın -->
                                <TextBlock DockPanel.Dock="Top" Margin="4,0,4,4" TextWrapping="Wrap"
                                           Text="{Binding Kapsam}"
                                           Foreground="{DynamicResource SolukMetinFircasi}" />

                                <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8,5" CornerRadius="3"
                                        Background="{DynamicResource UyariZeminFircasi}"
                                        BorderBrush="{DynamicResource UyariKenarFircasi}" BorderThickness="1"
                                        Visibility="{Binding Hata, Converter={StaticResource DegerVarsaGorunur}}">
                                    <TextBlock Text="{Binding Hata}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource UyariMetinFircasi}" />
                                </Border>

                                <TextBlock DockPanel.Dock="Bottom" Margin="4" Text="{Binding Ozet}"
                                           Foreground="{DynamicResource SolukMetinFircasi}"
                                           AutomationProperties.AutomationId="TxtAramaOzet" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>

                                    <DataGrid Grid.Column="0" Margin="4" IsReadOnly="True"
                                              ItemsSource="{Binding Sonuclar}" SelectedItem="{Binding SeciliSonuc}"
                                              AutoGenerateColumns="False" HeadersVisibility="Column"
                                              AutomationProperties.AutomationId="GrdAramaSonuclari">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nesne" Binding="{Binding TamAd}" Width="*" />
                                            <DataGridTextColumn Header="Tür" Binding="{Binding Tur}" Width="Auto" />
                                            <DataGridTextColumn Header="Eşleşme" Binding="{Binding EslesmeSayisi}" Width="Auto" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

                                    <DataGrid Grid.Column="2" Margin="4" IsReadOnly="True"
                                              ItemsSource="{Binding SeciliSonuc.Eslesmeler}"
                                              SelectedItem="{Binding SeciliEslesme}"
                                              AutoGenerateColumns="False" HeadersVisibility="Column"
                                              AutomationProperties.AutomationId="GrdAramaEslesmeleri">
                                        <DataGrid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding EslesmeyeGitCommand}"
                                                          CommandParameter="{Binding SeciliEslesme}" />
                                        </DataGrid.InputBindings>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Satır" Binding="{Binding Satir}" Width="Auto" />
                                            <DataGridTextColumn Header="İçerik" Binding="{Binding SatirMetni}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:PlanSekmesiViewModel}">
                            <DockPanel>
                                <!-- Planın nasıl alındığı: tahmini mi gerçek mi — kullanıcı neye baktığını bilmeli.
                                     v11-S7: AI Planı yorumlat bu sekmede — alttaki planı OTOMATİK alır. -->
                                <Border DockPanel.Dock="Top" Margin="4" Padding="8,5" CornerRadius="3"
                                        Background="{DynamicResource BilgiZeminFircasi}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="AI Planı yorumlat" Margin="8,0,0,0"
                                                Style="{StaticResource AracDugmesi}" Foreground="#F59E0B"
                                                Tag="{StaticResource Ikon.Robot}" Click="AiPlanYorumla_Click"
                                                ToolTip="Bu planı yapay zekaya yorumlatır: en pahalı adımlar, sapmalar, hangi index yardım eder"
                                                AutomationProperties.AutomationId="BtnAiPlanYorumla" />
                                        <TextBlock Text="{Binding Aciklama}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BilgiMetinFircasi}" />
                                    </DockPanel>
                                </Border>

                                <!-- Sapma uyarısı: planın en işe yarar sinyali -->
                                <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8,5" CornerRadius="3"
                                        Background="{DynamicResource UyariZeminFircasi}"
                                        BorderBrush="{DynamicResource UyariKenarFircasi}" BorderThickness="1"
                                        Visibility="{Binding SapmaVar, Converter={StaticResource BoolGorunurluk}}">
                                    <StackPanel>
                                        <TextBlock Text="⚠ Tahmin/gerçek sapması — istatistikler eskimiş olabilir"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource UyariMetinFircasi}" />
                                        <ItemsControl ItemsSource="{Binding Sapmalar}" Margin="0,3,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource UyariMetinFircasi}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Uyarılar tek yerde toplanır — kullanıcı ağacı tarayarak aramasın -->
                                <Border DockPanel.Dock="Top" Margin="4,0,4,4" Padding="8,5" CornerRadius="3"
                                        Background="{DynamicResource UyariZeminFircasi}"
                                        Visibility="{Binding UyariVar, Converter={StaticResource BoolGorunurluk}}">
                                    <ItemsControl ItemsSource="{Binding Uyarilar}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource UyariMetinFircasi}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Batch birden çok ifade içerebilir → ifade seçici -->
                                <ComboBox DockPanel.Dock="Top" Margin="4,0,4,4"
                                          ItemsSource="{Binding Ifadeler}" SelectedItem="{Binding SeciliIfade}"
                                          AutomationProperties.AutomationId="CmbPlanIfade">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Baslik}" />
                                                <TextBlock Text="{Binding ToplamMaliyet}" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource SolukMetinFircasi}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ContentControl Content="{Binding SeciliIfade}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <!-- Eksik index önerisi: script YALNIZ sekmede açılır, asla çalıştırılmaz -->
                                                <Border DockPanel.Dock="Bottom" Margin="4" Padding="8,5" CornerRadius="3"
                                                        Background="{DynamicResource VurguZeminFircasi}"
                                                        Visibility="{Binding EksikIndexVar, Converter={StaticResource BoolGorunurluk}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Plan bir index önerdi — inceleyip karar verin (öneri, vaat değil):"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding EksikIndexler}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,2">
                                                                        <Button DockPanel.Dock="Right" Content="⧉ Script'i sekmede aç"
                                                                                Padding="8,2" Margin="8,0,0,0"
                                                                                Command="{Binding DataContext.EksikIndexAcCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                AutomationProperties.AutomationId="BtnEksikIndexScript" />
                                                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                                            <Run Text="{Binding Tablo, Mode=OneWay}" FontWeight="SemiBold" />
                                                                            <Run Text=" · tahmini etki %" />
                                                                            <Run Text="{Binding Etki, Mode=OneWay, StringFormat=F1}" />
                                                                        </TextBlock>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Operatör ağacı: maliyet payı + satır sayıları -->
                                                <TreeView ItemsSource="{Binding Kokler}" Margin="4,0,4,4"
                                                          AutomationProperties.AutomationId="AgacPlan">
                                                    <TreeView.ItemContainerStyle>
                                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                            <Setter Property="IsExpanded" Value="True" />
                                                        </Style>
                                                    </TreeView.ItemContainerStyle>
                                                    <TreeView.ItemTemplate>
                                                        <HierarchicalDataTemplate ItemsSource="{Binding Cocuklar}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <!-- Maliyet payı: sıralama içindir, süre vaadi değil -->
                                                                <Border Background="{DynamicResource PanelZeminFircasi}"
                                                                        CornerRadius="2" Padding="5,1" MinWidth="52">
                                                                    <TextBlock FontFamily="{StaticResource KodYazisi}" FontSize="{StaticResource YaziKucuk}"
                                                                               HorizontalAlignment="Right">
                                                                        <Run Text="%" /><Run Text="{Binding MaliyetYuzdesi, Mode=OneWay, StringFormat=F1}" />
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Text="{Binding Islem}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                                <TextBlock Text="{Binding Ayrinti}" Margin="8,0,0,0"
                                                                           Foreground="{DynamicResource IkincilFircasi}" />
                                                                <!-- Tahmin ÜRETMEYEN motorda (MongoDB) bu koşu hiç gösterilmez —
                                                                     "tahmin 0" yazmak uydurma sayıdır (A1/B1, 2026-07-19). -->
                                                                <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource SolukMetinFircasi}"
                                                                           FontSize="{StaticResource YaziKucuk}"
                                                                           Visibility="{Binding TahminVar, Converter={StaticResource BoolGorunurluk}}">
                                                                    <Run Text="tahmin " /><Run Text="{Binding TahminiSatir, Mode=OneWay, StringFormat=N0}" />
                                                                </TextBlock>
                                                                <TextBlock Margin="8,0,0,0" FontSize="{StaticResource YaziKucuk}"
                                                                           Foreground="{DynamicResource BilgiMetinFircasi}"
                                                                           Visibility="{Binding GercekSatir, Converter={StaticResource DegerVarsaGorunur}}">
                                                                    <Run Text="gerçek " /><Run Text="{Binding GercekSatir, Mode=OneWay, StringFormat=N0}" />
                                                                </TextBlock>
                                                                <TextBlock Text="⚠" Margin="8,0,0,0" FontSize="{StaticResource YaziKucuk}"
                                                                           Foreground="{DynamicResource UyariMetinFircasi}"
                                                                           ToolTip="Tahmin ile gerçek satır sayısı çok sapıyor — istatistikler eskimiş olabilir"
                                                                           Visibility="{Binding SapmaVar, Converter={StaticResource BoolGorunurluk}}" />
                                                            </StackPanel>
                                                        </HierarchicalDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </DockPanel>
                        </DataTemplate>
                        <!-- Düzenleme sekmesi (V2-S5, FG-4.9): tabloya bağlı düzenlenebilir grid -->
                        <DataTemplate DataType="{x:Type vm:DuzenlemeSekmesiViewModel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="4">
                                    <Button DockPanel.Dock="Left" Content="💾 Uygula…" Style="{StaticResource BirincilDugme}"
                                            Command="{Binding UygulaCommand}"
                                            ToolTip="Üretilecek DML önce önizlenir; onaylarsan tek işlemde uygulanır"
                                            AutomationProperties.AutomationId="BtnDuzenlemeUygula" />
                                    <Button DockPanel.Dock="Left" Content="✖ Vazgeç" Margin="4,0,0,0" Padding="10,2"
                                            Command="{Binding VazgecCommand}"
                                            ToolTip="Bekleyen tüm düzenlemeleri at, grid yüklendiği hâline dönsün"
                                            AutomationProperties.AutomationId="BtnDuzenlemeVazgec" />
                                    <Button DockPanel.Dock="Left" Content="↻ Yenile" Margin="4,0,0,0" Padding="10,2"
                                            Command="{Binding YenileCommand}"
                                            ToolTip="Tabloyu sunucudan yeniden yükler (bekleyen düzenlemeler atılır)"
                                            AutomationProperties.AutomationId="BtnDuzenlemeYenile" />
                                    <!-- Ayrı "Sorgu penceresi" (v6a) EMEKLİ — kullanıcı düzeltmesi 2026-07-26:
                                         sorgu SEKME İÇİNDE yazılır, sonucu ALTTAKİ gridde düzenlenir. -->
                                    <!-- Toplu işlemler (V5-S5): hepsi aynı raydan gider —
                                         bekleyen kümeye yazar, Uygula'da önizlenir. -->
                                    <Button DockPanel.Dock="Left" Content="∅ NULL ata" Margin="12,0,0,0" Padding="10,2"
                                            Command="{Binding NullAtaCommand}"
                                            ToolTip="Seçili hücrelere NULL yazar (Ctrl+0). NULL kabul etmeyen kolonlar atlanır."
                                            AutomationProperties.AutomationId="BtnNullAta" />
                                    <Button DockPanel.Dock="Left" Content="⇊ Kolonu toplu güncelle…" Margin="4,0,0,0" Padding="10,2"
                                            Command="{Binding TopluGuncelleCommand}"
                                            ToolTip="Bir kolonun EKRANDAKİ tüm satırlarına aynı değeri yazar (tablonun tamamına değil)"
                                            AutomationProperties.AutomationId="BtnTopluGuncelle" />
                                    <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ZayifMetinFircasi}"
                                               Text="{Binding DegisiklikSayisi, StringFormat='{}{0} bekleyen değişiklik'}"
                                               AutomationProperties.AutomationId="LblDegisiklikSayisi" />
                                    <Border />
                                </DockPanel>
                                <!-- Sekme İÇİ sorgu (kullanıcı düzeltmesi 2026-07-26): sorgu burada yazılır,
                                     sonucu ALTTAKİ gridde düzenlenir. Boş = tablonun ilk 1000 satırı.
                                     Düzenleme için sorgu PK kolonlarını da SELECT etmelidir — etmezse
                                     grid salt-okunur kalır ve bilgi satırı nedenini söyler. -->
                                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                                    <!-- Düğme SOLDA, kutuya bitişik (kullanıcı bulgusu 2026-07-26: sağ uçta
                                         geniş pencerede GÖRÜNMÜYORDU — "çalıştıramıyorum"); F5 / Ctrl+Enter de çalıştırır. -->
                                    <Button DockPanel.Dock="Left" Content="▶ Çalıştır" Margin="0,0,4,0"
                                            Padding="10,2" VerticalAlignment="Stretch"
                                            Style="{StaticResource BirincilDugme}"
                                            Command="{Binding FiltreCalistirCommand}"
                                            ToolTip="Yazdığın sorguyu bu tablonun bağlantısında çalıştırır (F5 ya da Ctrl+Enter); SONUCU gridde düzenlersin. Bekleyen düzenlemeler atılır."
                                            AutomationProperties.AutomationId="BtnEditFiltreCalistir" />
                                    <!-- v22-S4 Edit m.2 (kullanıcı: "sorgu editöründeki gibi öneriler olsun,
                                         normal textbox yerine"): düz TextBox GERÇEK editöre çevrildi —
                                         renklendirme + IntelliSense + Ctrl+F arama. Kurulum
                                         DuzenlemeEditor_Loaded'da (ana editörün sade alt kümesi). -->
                                    <Border BorderThickness="1" BorderBrush="{DynamicResource KenarFircasi}">
                                        <avalon:TextEditor Document="{Binding FiltreBelgesi}"
                                                           FontFamily="{StaticResource KodYazisi}" FontSize="13"
                                                           MinHeight="44" MaxHeight="88"
                                                           HorizontalScrollBarVisibility="Auto"
                                                           VerticalScrollBarVisibility="Auto"
                                                           Loaded="DuzenlemeEditor_Loaded"
                                                           ToolTip="Boş bırak = tablonun ilk 1000 satırı. Örn: SELECT Id, Ad FROM dbo.Musteri WHERE Sehir = 'İzmir' — düzenleme için PK kolonlarını da seç. F5 / Ctrl+Enter çalıştırır."
                                                           AutomationProperties.AutomationId="TxtEditFiltreSql" />
                                    </Border>
                                </DockPanel>
                                <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource PanelZeminFircasi}"
                                        BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="0,1,0,0">
                                    <TextBlock Text="{Binding Bilgi}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ZayifMetinFircasi}"
                                               AutomationProperties.AutomationId="LblDuzenlemeBilgi" />
                                </Border>
                                <DataGrid ItemsSource="{Binding Gorunum}" AutoGenerateColumns="True"
                                          IsReadOnly="{Binding Salt}"
                                          CanUserAddRows="{Binding Ekleyebilir}" CanUserDeleteRows="True"
                                          AutoGeneratingColumn="DuzenlemeGrid_AutoGeneratingColumn"
                                          Loaded="DuzenlemeGrid_Loaded"
                                          PreviewKeyDown="DuzenlemeGrid_PreviewKeyDown"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          SelectionUnit="CellOrRowHeader" HeadersVisibility="All"
                                          BorderThickness="0,1,0,0"
                                          AutomationProperties.AutomationId="GridDuzenleme" />
                            </DockPanel>
                        </DataTemplate>
                        <!-- Sorgu sekmesi (S3+) -->
                        <DataTemplate DataType="{x:Type vm:SorguSekmesiViewModel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="80" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="{Binding DataContext.SonucYuksekligi, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                </Grid.RowDefinitions>

                                <!-- Sekme araç çubuğu: DB seçici + Çalıştır/Durdur + süre. WrapPanel: sorgu
                                     geçmişi açılıp genişlik daralınca butonlar üst üste binmeyip ALT SATIRA
                                     iner (kullanıcı isteği 2026-07-21). DockPanel.Dock öznitelikleri WrapPanel'de
                                     yok sayılır — öğeler yazım sırasıyla soldan sağa akar.
                                     v19-S9 cila (kullanıcı kararı 2026-08-03 akşam, ÇÖZÜNÜRLÜĞE UYARLANIR):
                                     sabit satır ataması YOK — tek akışkan şerit. Geniş ekranda HER ŞEY tek
                                     satır; dar ekranda doğal yerden alt satıra iner (sıra: DB · eylem
                                     düğmeleri · anahtarlar — kırılan öğe hep komşularıyla birlikte akar,
                                     tek başına kalmaz). Düzen güvencesi: ItemHeight=32 + öğelerde dikey 2px
                                     marj → hangi çözünürlükte kaç satıra kırılırsa kırılsın satırlar aynı
                                     boyda ve aralarında boşluk kalır ("karıştı/kaydı" bulgularının kökü). -->
                                <WrapPanel Grid.Row="0" Margin="6,4,6,4" ItemHeight="32">
                                    <!-- DB çipi: vektör veritabanı silindiri (emoji değil — ikon seti 2026-07-24) -->
                                    <Path Data="{StaticResource Ikon.Veritabani}" Stretch="Uniform"
                                          Width="15" Height="15" Stroke="{DynamicResource IkonTeal}" StrokeThickness="1.7"
                                          Fill="Transparent" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="2,0,6,0"
                                          ToolTip="Bu sekmenin çalışacağı veritabanı" />
                                    <ComboBox Width="180" Margin="0,2"
                                              ItemsSource="{Binding VeritabaniAdlari}"
                                              SelectedItem="{Binding SecilenVeritabani}"
                                              AutomationProperties.AutomationId="CmbSekmeDb" />
                                    <Button Margin="8,2,0,2"
                                            Style="{StaticResource BirincilDugme}"
                                            Command="{Binding CalistirCommand}"
                                            ToolTip="Seçili metni (yoksa tümünü) çalıştırır (F5). Çok ifadeli script motorun kuralıyla sırayla koşar."
                                            AutomationProperties.AutomationId="BtnCalistir">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Renk düğmenin Foreground'undan (BirincilDugme: beyaz; v23-S14 klasik
                                                 Antrasit düzeninde dolgusuz düğme → koyu metin). Sabit "White" klasikte görünmezdi. -->
                                            <Path Data="{StaticResource Ikon.Play}" Stretch="Uniform" Width="12" Height="12"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Çalıştır (F5)" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 🔍 Sorgu provası (V15-S2, BF-2): DML'i çalıştırmadan etkisini gösterir — yalnız SQL Server -->
                                    <Button DockPanel.Dock="Left" Content="Prova" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="#0891B2"
                                            Tag="{StaticResource Ikon.Ara}"
                                            Command="{Binding ProvaCommand}"
                                            Visibility="{Binding DataContext.MotorMssqlMu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="UPDATE/DELETE'i ÇALIŞTIRMADAN etkisini gösterir (Ctrl+Shift+P): kaç satır etkilenecek + ilk 10'u — hiçbir şey değişmez, karar sizin"
                                            AutomationProperties.AutomationId="BtnProva" />
                                    <Button DockPanel.Dock="Left" Content="Durdur" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="{DynamicResource TehlikeFircasi}"
                                            Tag="{StaticResource Ikon.Stop}"
                                            Command="{Binding IptalCommand}" IsEnabled="{Binding CalisiyorMu}"
                                            ToolTip="Çalışan sorguyu iptal eder (Esc) — komut iptaline kadar iner, ≤1 sn hedef"
                                            AutomationProperties.AutomationId="BtnDurdur" />
                                    <!-- Yalnız biçimlendiricisi olan motorlarda: MSSQL (T-SQL) + Mongo (JSON) -->
                                    <Button DockPanel.Dock="Left" Content="Biçimlendir" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="{DynamicResource IkonMavi}"
                                            Tag="{StaticResource Ikon.Bicim}"
                                            Command="{Binding BicimlendirCommand}"
                                            Visibility="{Binding DataContext.BicimlendirGorunur, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="Sorguyu biçimlendir (Ctrl+Shift+F) — SQL Server'da T-SQL, MongoDB'de JSON"
                                            AutomationProperties.AutomationId="BtnBicimlendir" />
                                    <!-- Find yardımcısı raydan buraya taşındı (v12-S6, kullanıcı isteği
                                         2026-07-26: "Biçimlendir'in yanına"). Yalnız MongoDB'de görünür. -->
                                    <Button DockPanel.Dock="Left" Content="Find yardımcısı" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="#10B981"
                                            Tag="{StaticResource Ikon.GorselSorgu}" Click="MongoBul_Click"
                                            Visibility="{Binding DataContext.MotorMongoMu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="Alanlardan çalıştırılabilir find JSON üretir, yeni sekmede açar"
                                            AutomationProperties.AutomationId="BtnMongoBul" />
                                    <!-- m.26 fikir 7: $lookup sihirbazı — Mongo'nun JOIN karşılığı pipeline'ı üretir -->
                                    <Button DockPanel.Dock="Left" Content="$lookup" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="{DynamicResource IkonTeal}"
                                            Tag="{StaticResource Ikon.Linq}" Click="MongoLookup_Click"
                                            Visibility="{Binding DataContext.MotorMongoMu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="İki koleksiyonu birleştiren pipeline'ı sihirbazla üretir (Mongo'da JOIN karşılığı)"
                                            AutomationProperties.AutomationId="BtnMongoLookup" />
                                    <!-- m.26 fikir 9: panodaki shell komutunu çalıştırılabilir biçime çevirir -->
                                    <Button DockPanel.Dock="Left" Content="Shell yapıştır" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="{DynamicResource IkonAmber}"
                                            Tag="{StaticResource Ikon.DosyaAc}" Click="MongoShellYapistir_Click"
                                            Visibility="{Binding DataContext.MotorMongoMu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="Panodaki db.koleksiyon.find({…}).sort({…}).limit(n) komutunu çalıştırılabilir hâle çevirip yeni sekmede açar"
                                            AutomationProperties.AutomationId="BtnMongoShellYapistir" />
                                    <!-- 🤖 TEK AI düğmesi (kullanıcı isteği 2026-07-27: "butonları tek yap"):
                                         üç bağlam eylemi + Asistan açılır menüde toplandı. -->
                                    <Button DockPanel.Dock="Left" Content="AI ▾" Margin="8,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="#8B5CF6"
                                            Tag="{StaticResource Ikon.Robot}" Click="AiMenu_Click"
                                            ToolTip="Yapay zeka: Değerlendir · Açıkla · Hatayı çözdür · Asistan'ı aç"
                                            AutomationProperties.AutomationId="BtnAi">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Değerlendir" Click="AiDegerlendir_Click"
                                                          ToolTip="Editördeki sorguyu denetletir: söz dizimi/mantık/risk + düzeltilmiş sorgu"
                                                          AutomationProperties.AutomationId="MnuAiDegerlendir" />
                                                <MenuItem Header="Açıkla" Click="AiAcikla_Click"
                                                          ToolTip="Sorgunun ne yaptığını adım adım düz Türkçe anlatır"
                                                          AutomationProperties.AutomationId="MnuAiAcikla" />
                                                <MenuItem Header="Hatayı çözdür" Click="AiHataCoz_Click"
                                                          ToolTip="Son çalıştırmanın kırmızı hatasını çözdürür: neden + düzeltilmiş sorgu"
                                                          AutomationProperties.AutomationId="MnuAiHataCoz" />
                                                <Separator />
                                                <MenuItem Header="🤖 Asistan'ı aç" Click="AiAsistanAc_Click"
                                                          ToolTip="Sohbet sekmesini açar"
                                                          AutomationProperties.AutomationId="MnuAiAsistan" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <!-- Plan + Görsele çevir GERİ araç çubuğunda (v11-S7 rötuşu — kullanıcı isteği) -->
                                    <Button DockPanel.Dock="Left" Margin="8,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="#F59E0B"
                                            Tag="{StaticResource Ikon.Plan}"
                                            Content="{Binding DataContext.PlanDugmeBasligi, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Click="Plan_Click"
                                            IsEnabled="{Binding PlanYapilabilirMi}"
                                            Visibility="{Binding DataContext.PlanGorunur, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="Sorgunun execution plan'ını ayrı sekmede açar (sorgu çalışırken kapalı)"
                                            AutomationProperties.AutomationId="BtnPlanArac" />
                                    <!-- Performans değerlendir (eski "Neden yavaş?", BF-7): planı tek Türkçe
                                         darboğaz raporuna çevirir. On-demand performans denetimi — yazarkenki
                                         girişken maliyet bandının yerini alır (kullanıcı isteği 2026-07-28).
                                         Komşu araç düğmeleriyle uyumlu: vektör ikon (Tag) + tek renk (emojisiz). -->
                                    <Button DockPanel.Dock="Left" Content="Performans değerlendir" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="#EF4444"
                                            Tag="{StaticResource Ikon.Huni}"
                                            Click="NedenYavas_Click"
                                            IsEnabled="{Binding PlanYapilabilirMi}"
                                            Visibility="{Binding DataContext.PlanGorunur, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="Sorgunun planını tek Türkçe raporda özetler: eksik index, tam tarama, istatistik tazeliği, sunucu uyarıları — düzeltme script'leriyle"
                                            AutomationProperties.AutomationId="BtnNedenYavas" />
                                    <Button DockPanel.Dock="Left" Content="Görsele çevir" Margin="5,2,0,2"
                                            Style="{StaticResource AracDugmesi}" Foreground="#A855F7"
                                            Tag="{StaticResource Ikon.GorseleCevir}"
                                            Command="{Binding DataContext.ScriptiGorseleCevirCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding DataContext.MotorMssqlMu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="Editördeki SELECT'i Görsel Sorgu tuvaline aktarır (yalnız SQL Server)"
                                            AutomationProperties.AutomationId="BtnScriptiGorseleCevirArac" />
                                    <Button Content="↻ Yeniden dene" Margin="8,2,0,2" Padding="8,2"
                                            Command="{Binding CalistirCommand}" Foreground="{DynamicResource TehlikeFircasi}"
                                            Visibility="{Binding YenidenDenenebilir, Converter={StaticResource BoolGorunurluk}}"
                                            ToolTip="Bağlantı koptu; sorguyu yeniden çalıştır"
                                            AutomationProperties.AutomationId="BtnYenidenDene" />
                                    <!-- "📄 Rapor" buradan sonuç bölgesine taşındı (kullanıcı isteği 2026-07-22):
                                         rapor sonuçlara ait bir eylem → grid export butonlarının yanında. -->
                                    <!-- Execution plan + Metin ara buradan SOL RAYA taşındı (#7, 2026-07-25).
                                         Komutlar (PlanAcAsync / MetinAramaAc) zaten aktif sekmeyi/seçili DB'yi
                                         hedeflediğinden ray global olsa da davranış korunur. -->
                                    <!-- Auto-refresh (V5-S4, FG-3.13). Yazma sorgusunda AÇILMAZ:
                                         aralıklı kendiliğinden tekrar veri kaybı demektir. -->
                                    <CheckBox Margin="14,0,0,0" VerticalAlignment="Center"
                                              Style="{StaticResource AnahtarKutusu}"
                                              IsChecked="{Binding OtoYenileAcik, Mode=OneWay}"
                                              Click="OtoYenile_Click"
                                              ToolTip="Sorguyu belirli aralıkla yeniden çalıştırır ve neyin değiştiğini yazar. YAZMA sorgularında açılmaz."
                                              AutomationProperties.AutomationId="ChkOtoYenile">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Ikon.Yenile}" Stretch="Uniform" Width="14" Height="14"
                                                  Stroke="{DynamicResource IkonMavi}" StrokeThickness="1.7" Fill="Transparent"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Oto yenile" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBox Width="46" Margin="4,0,0,0" VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding OtoYenileSaniye}"
                                             ToolTip="Yenileme aralığı (saniye, en az 2)"
                                             AutomationProperties.AutomationId="TxtOtoYenileSn" />
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                               Text="sn" Foreground="{DynamicResource SolukMetinFircasi}" />
                                    <!-- Güvenli Yazma Modu (V2-S4, Ö1): isteğe bağlı, tercih kalıcı.
                                         V4-S2: SQL ailesinin dördünde de çalışır (işlem ifadeleri lehçeden);
                                         MongoDB'de yok. MySQL/Oracle'da DDL örtük COMMIT yaptığından o
                                         ifadelerde bant açılmaz — kullanıcıya Mesajlar'da nedeni yazılır. -->
                                    <CheckBox Margin="16,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding DataContext.GuvenliYazma, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Visibility="{Binding DataContext.GuvenliYazmaGorunur, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                              ToolTip="Açıkken yazma sorguları açık işlemde çalışır: 'N satır etkilendi' görürsün, COMMIT/ROLLBACK kararı senindir. Süre dolarsa otomatik ROLLBACK. (MySQL/Oracle'da DDL geri alınamaz — o ifadelerde devreye girmez.)"
                                              AutomationProperties.AutomationId="ChkGuvenliYazma">
                                        <CheckBox.Style>
                                            <!-- Kapsül anahtar tabanlı: açıkken etiket yeşile döner -->
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource AnahtarKutusu}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BasariFircasi}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Ikon.Kalkan}" Stretch="Uniform" Width="14" Height="14"
                                                  Stroke="{DynamicResource BasariFircasi}" StrokeThickness="1.7" Fill="Transparent"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Güvenli yazma" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <!-- Kilitsiz okuma anahtarı (FG-6.4; UI adı kullanıcı isteği 2026-07-17): tüm sekmelerde ortak, varsayılan kapalı.
                                         T-SQL'e özgü — MSSQL dışı motorda kapalı (V3-S1 kapılama). -->
                                    <CheckBox Margin="16,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding DataContext.KirliOkuma, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Visibility="{Binding DataContext.MotorMssqlMu, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                              ToolTip="Açıkken sorgu, TÜM tablolara WITH (NOLOCK) yazmışsınız gibi davranır (READ UNCOMMITTED): kilit almaz ve beklemez, ama commit edilmemiş veri okuyabilir."
                                              AutomationProperties.AutomationId="ChkKirliOkuma">
                                        <CheckBox.Style>
                                            <!-- Kapsül anahtar tabanlı: açıkken etiket kırmızıya döner (dirty read uyarısı) -->
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource AnahtarKutusu}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TehlikeFircasi}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Ikon.Kilit}" Stretch="Uniform" Width="14" Height="14"
                                                  Stroke="{DynamicResource TehlikeFircasi}" StrokeThickness="1.7" Fill="Transparent"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="NOLOCK" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <!-- "⬇ Tümünü dışa aktar" buradan sonuç bölgesine taşındı (kullanıcı isteği
                                         2026-07-22): dışa aktarma sonuçlara ait → grid export butonlarının yanında.
                                         Satır sayısı + süre de GRID ÜSTÜNE taşındı (kullanıcı isteği 2026-07-30) —
                                         çalışırken canlı "⏳" süresi ayrı ÇALIŞIYOR bandında zaten görünür. -->
                                </WrapPanel>

                                <!-- Güvenli Yazma karar bandı (V2-S4, Ö1) + Prova bandı (V15-S2) — editörün hemen üstünde -->
                                <StackPanel Grid.Row="1">
                                    <Border Background="{DynamicResource UyariZeminFircasi}" BorderBrush="{DynamicResource UyariKenarFircasi}" BorderThickness="0,1"
                                            Padding="10,7"
                                            Visibility="{Binding IslemAcik, Converter={StaticResource BoolGorunurluk}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="↩ ROLLBACK" Padding="14,4" Margin="6,0,0,0"
                                                    Command="{Binding RollbackCommand}"
                                                    ToolTip="İşlemi geri al — veri değişmez"
                                                    AutomationProperties.AutomationId="BtnRollback" />
                                            <!-- 🔍 Değişiklikleri görüntüle (kullanıcı isteği 2026-07-31): COMMIT'ten
                                                 önce önceki↔şimdiki hal — yalnız yakalama varken (UPDATE/DELETE). -->
                                            <Button DockPanel.Dock="Right" Content="🔍 Değişiklikleri görüntüle" Padding="12,4" Margin="12,0,0,0"
                                                    Command="{Binding DegisiklikleriGosterCommand}"
                                                    Visibility="{Binding DegisiklikGosterilebilir, Converter={StaticResource BoolGorunurluk}}"
                                                    ToolTip="Karar vermeden önce: etkilenen satırların ÖNCEKİ ve ŞİMDİKİ (işlem içi) halini alt alta gösterir"
                                                    AutomationProperties.AutomationId="BtnDegisiklikGoster" />
                                            <Button DockPanel.Dock="Right" Content="✔ COMMIT" Padding="14,4" Margin="12,0,0,0"
                                                    Style="{StaticResource BirincilDugme}"
                                                    Command="{Binding CommitCommand}"
                                                    ToolTip="Değişiklikleri kalıcılaştır (COMMIT öncesi XACT_STATE denetlenir)"
                                                    AutomationProperties.AutomationId="BtnCommit" />
                                            <TextBlock Text="{Binding IslemBandi}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource UyariMetinFircasi}" TextWrapping="Wrap"
                                                       ToolTip="İşlem açıkken kilitler tutulur; tetikleyiciler çalışmış, IDENTITY tüketilmiş olabilir (rollback bunları geri almaz)"
                                                       AutomationProperties.AutomationId="LblIslemBandi" />
                                        </DockPanel>
                                    </Border>
                                    <!-- 🔍 Prova bandı: "N satır etkilenecek" + karar. Metin değişince kendiliğinden söner. -->
                                    <Border Background="{DynamicResource BilgiZeminFircasi}" BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="0,1"
                                            Padding="10,7"
                                            Visibility="{Binding ProvaBandi, Converter={StaticResource NullGizle}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Kapat" Padding="14,4" Margin="6,0,0,0"
                                                    Command="{Binding ProvaKapatCommand}"
                                                    ToolTip="Provayı kapat — hiçbir şey çalıştırılmaz"
                                                    AutomationProperties.AutomationId="BtnProvaKapat" />
                                            <Button DockPanel.Dock="Right" Content="▶ Şimdi çalıştır" Padding="14,4" Margin="12,0,0,0"
                                                    Style="{StaticResource BirincilDugme}"
                                                    Command="{Binding ProvaOnaylaCommand}"
                                                    ToolTip="Prova edilen sorguyu olağan yoldan (tüm korumalarla) çalıştırır"
                                                    AutomationProperties.AutomationId="BtnProvaOnayla" />
                                            <TextBlock Text="{Binding ProvaBandi}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource BilgiMetinFircasi}" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="LblProvaBandi" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- SQL editörü. WordWrap BİLEREK KAPALI (kullanıcı 2026-09-17,
                                     SSMS eşleşmesi): uzun satır ifadenin ortasından işaretsiz alta
                                     sarılınca devam parçası kendi başına bir satır gibi görünüyor,
                                     kod "karışık" okunuyordu — SSMS gibi yatay kaydırma verilir. -->
                                <avalon:TextEditor Grid.Row="2" Document="{Binding Belge}"
                                                   SyntaxHighlighting="TSQL" ShowLineNumbers="True"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                                   Background="{DynamicResource EditorZeminFircasi}"
                                                   Foreground="{DynamicResource EditorMetinFircasi}"
                                                   LineNumbersForeground="{DynamicResource SolukMetinFircasi}"
                                                   Padding="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource KenarFircasi}"
                                                   Loaded="Editor_Loaded"
                                                   AutomationProperties.AutomationId="SqlEditor" />

                                <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="{DynamicResource KenarFircasi}" />

                                <!-- Sonuç bölgesi (S4): Results / Messages sekmeleri (FG-4.1) -->
                                <Grid Grid.Row="4">
                                <TabControl SelectedIndex="{Binding SonucSekmeIndex}"
                                            AutomationProperties.AutomationId="SonucSekmeleri">
                                    <TabItem Header="Sonuçlar">
                                        <DockPanel>
                                            <!-- Satır sınırı bilgi bandı (FG-4.5) -->
                                            <Border DockPanel.Dock="Top" Background="{DynamicResource UyariZeminFircasi}" BorderBrush="{DynamicResource UyariKenarFircasi}"
                                                    BorderThickness="0,0,0,1" Padding="8,4"
                                                    Visibility="{Binding BilgiBandi, Converter={StaticResource NullGizle}}">
                                                <TextBlock Text="{Binding BilgiBandi}" Foreground="{DynamicResource UyariMetinFircasi}" FontSize="12"
                                                           AutomationProperties.AutomationId="LblBilgiBandi" />
                                            </Border>
                                            <!-- Auto-refresh fark bandı (V5-S4): son yenilemede ne değişti -->
                                            <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}"
                                                    BorderThickness="0,0,0,1" Padding="8,4"
                                                    Visibility="{Binding OtoYenileBandi, Converter={StaticResource DegerVarsaGorunur}}">
                                                <TextBlock Text="{Binding OtoYenileBandi}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource BilgiMetinFircasi}" FontSize="12"
                                                           AutomationProperties.AutomationId="LblOtoYenileBandi" />
                                            </Border>
                                            <!-- Çoklu result set alt alta (FG-4.6) -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SonucSetleri}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SonucSetiGorunumu}">
                                                            <DockPanel Margin="0,0,0,10">
                                                                <!-- v20-S21 saha m.18 ("grid butonları az belli"): buton şeridi PANEL BANDINA alındı —
                                                                     butonların zemini (PencereZemin) grid alanıyla birebir aynıydı, eriyorlardı; bant
                                                                     zemini + ince alt kenar butonları iki temada da ayrıştırır (sekme şeridiyle aynı desen). -->
                                                                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelZeminFircasi}"
                                                                        BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="0,1,0,1"
                                                                        Padding="6,4">
                                                                <DockPanel>
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                        <!-- Satır sayısı + süre (kullanıcı isteği 2026-07-30): üst şeritten GRİDİN ÜSTÜNE,
                                                                             buton sırasının en soluna taşındı. Sekme VM'inden RelativeSource ile okunur. -->
                                                                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11.5"
                                                                                   Foreground="{DynamicResource ZayifMetinFircasi}"
                                                                                   AutomationProperties.AutomationId="LblSonucOzeti"><Run Text="{Binding DataContext.SonucOzeti, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" /><Run Text="  ·  " /><Run FontFamily="Consolas" Text="{Binding DataContext.SureMetni, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" /></TextBlock>
                                                                        <!-- 🫧 Kolon araçları (kullanıcı isteği 2026-07-28): göster/gizle + boş kolonları
                                                                             gizle. DataGridColumn.Visibility ile — hücre binding'ine DOKUNMAZ (güvenli). -->
                                                                        <Button x:Name="KolonHuniBtn" Content="Kolonlar ▾" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                                Tag="{Binding ElementName=KolonPopup}" Click="KolonHuni_Click"
                                                                                ToolTip="Kolonları göster/gizle · boş (tümü NULL) kolonları tek tıkla gizle"
                                                                                AutomationProperties.AutomationId="BtnKolonHuni" />
                                                                        <Popup x:Name="KolonPopup" Placement="Bottom" StaysOpen="False"
                                                                               PlacementTarget="{Binding ElementName=KolonHuniBtn}" AllowsTransparency="True">
                                                                            <Border Background="{DynamicResource PencereZeminFircasi}" BorderBrush="{DynamicResource KenarFircasi}"
                                                                                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,3,6,6" Width="270">
                                                                                <StackPanel>
                                                                                    <TextBox Tag="{Binding ElementName=KolonListesi}" TextChanged="KolonAra_TextChanged"
                                                                                             Margin="0,0,0,6" Padding="4,2" ToolTip="Kolon adında ara"
                                                                                             AutomationProperties.AutomationId="TxtKolonAra" />
                                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                                        <Button Content="🫧 Boş kolonları gizle" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                                                Tag="{Binding ElementName=SetGrid}" Click="BosKolonlariGizle_Click"
                                                                                                ToolTip="Bu sonuçta tümü NULL/boş olan kolonları gizler"
                                                                                                AutomationProperties.AutomationId="BtnBosKolonGizle" />
                                                                                        <Button Content="Tümünü göster" Style="{StaticResource MiniDugme}"
                                                                                                Tag="{Binding ElementName=SetGrid}" Click="TumKolonlariGoster_Click"
                                                                                                AutomationProperties.AutomationId="BtnTumKolonGoster" />
                                                                                    </StackPanel>
                                                                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                                                        <ItemsControl x:Name="KolonListesi" ItemsSource="{Binding Columns, ElementName=SetGrid}"
                                                                                                      AutomationProperties.AutomationId="ListeKolonlar">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <CheckBox Content="{Binding Header}" Margin="2,3" VerticalContentAlignment="Center"
                                                                                                              IsChecked="{Binding Visibility, Converter={StaticResource GorunurlukBool}, Mode=TwoWay}" />
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </ScrollViewer>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Popup>
                                                                        <!-- Rapor + Tümünü dışa aktar (sekme düzeyi eylemler) kopya/dışa-aktar
                                                                             butonlarıyla TEK SIRADA (kullanıcı isteği 2026-07-23). Bağlamalar
                                                                             tab VM'ine RelativeSource ile ulaşır (buradaki DataContext = SonucSetiGorunumu). -->
                                                                        <Button Content="📄 Rapor" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                                Click="HtmlRapor_Click"
                                                                                ToolTip="Sekmenin son sonucunu tek HTML dosyasına aktarır: sorgu + sunucu/DB + süre + tablolar (Ö6)"
                                                                                AutomationProperties.AutomationId="BtnHtmlRapor" />
                                                                        <Button Content="⬇ Tümünü dışa aktar" Style="{StaticResource MiniDugme}" Margin="0,0,10,0"
                                                                                Click="TumunuDisaAktar_Click"
                                                                                IsEnabled="{Binding DataContext.DisaAktarilabilir, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                Visibility="{Binding DataContext.TopluAktarGorunur, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolGorunurluk}}"
                                                                                ToolTip="Son sorgunun TÜM satırlarını CSV'ye aktarır (100.000 grid sınırına takılmadan, akışla)"
                                                                                AutomationProperties.AutomationId="BtnTumunuDisaAktar" />
                                                                        <Button Content="⧉ Başlıklı kopyala" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                                Click="KopyalaBaslikli_Click" Tag="{Binding ElementName=SetGrid}"
                                                                                ToolTip="Seçili satırları (yoksa tümünü) kolon başlıklarıyla panoya kopyalar"
                                                                                AutomationProperties.AutomationId="BtnKopyalaBaslikli" />
                                                                        <Button Content="⧉ Başlıksız" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                                Click="KopyalaBassiz_Click" Tag="{Binding ElementName=SetGrid}"
                                                                                AutomationProperties.AutomationId="BtnKopyalaBassiz" />
                                                                        <Button Content="↓ CSV" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                                Click="CsvKaydet_Click"
                                                                                ToolTip="Bu result set'i CSV dosyasına kaydeder (Excel uyumlu)"
                                                                                AutomationProperties.AutomationId="BtnCsv" />
                                                                        <Button Content="↓ Excel" Style="{StaticResource MiniDugme}" Margin="0,0,4,0"
                                                                                Click="XlsxKaydet_Click"
                                                                                ToolTip="Tip koruyan .xlsx: sayı sayı, tarih tarih olarak gider (FG-4.4)"
                                                                                AutomationProperties.AutomationId="BtnXlsx" />
                                                                        <Button Content="↓ JSON" Style="{StaticResource MiniDugme}"
                                                                                Click="JsonKaydet_Click"
                                                                                ToolTip="Tip koruyan JSON dizisi (FG-4.4)"
                                                                                AutomationProperties.AutomationId="BtnJson" />
                                                                        <!-- v22-S1 (saha turu-2 m.10): "🌐 REST'e gönder" KALDIRILDI — kullanıcı:
                                                                             "işlevli bir kullanışı yok, bu özelliğimizi kaldıralım". Zincirin tamamı
                                                                             gitti (grid butonu + REST penceresindeki 🔁 Toplu Gönder + toplu sonuç
                                                                             penceresi + RestTopluGenisletici); REST istemcisinin tek istek akışı
                                                                             ve KV↔JSON gövde tablosu dokunulmadan duruyor. -->
                                                                    </StackPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SecimIstatistigi}" Margin="0,0,10,0"
                                                                               VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource BilgiMetinFircasi}"
                                                                               AutomationProperties.AutomationId="LblSecimIstatistik" />
                                                                    <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold" Foreground="{DynamicResource ZayifMetinFircasi}"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding BaslikGorunur, Converter={StaticResource BoolGorunurluk}}" />
                                                                </DockPanel>
                                                                </Border>
                                                                <!-- Yükseklik SABİT DEĞİL: sonuç bölgesine orantılı (kullanıcı bulgusu
                                                                     2026-07-20). Tek set tüm alanı doldurur, N set alanı böler.
                                                                     🧱 MaxHeight EMNİYET KEMERİ (v22-S4, 5. çökme bildirimi — donma.txt:
                                                                     151 sn blok + 4,6 GB yığın, faz "grid-hazir"da takılı): Height bağlaması
                                                                     herhangi bir nedenle değer üretemezse grid dış ScrollViewer içinde SONSUZ
                                                                     yükseklik alır → satır sanallaştırması ölür → 33.964×43 hücre görseli
                                                                     kurulur. ÖLÇÜLDÜ: sanallaştırma ölüyken 3.000 satır 46 sn + 1,45 GB
                                                                     (sahadaki imzanın aynısı), canlıyken 0,9 sn + 24 satır görseli. MaxHeight,
                                                                     Height NaN kalsa bile ölçümü bağlar — hangi yol bozarsa bozsun
                                                                     sanallaştırma yaşar; FallbackValue da bağlama hatasında sonlu değer verir. -->
                                                                <DataGrid x:Name="SetGrid" ItemsSource="{Binding Gorunum}"
                                                                          IsReadOnly="True" AutoGenerateColumns="True"
                                                                          VerticalAlignment="Top" MaxHeight="1600"
                                                                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"
                                                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                                          SelectionUnit="CellOrRowHeader" SelectionMode="Extended"
                                                                          SelectedCellsChanged="Grid_SecimDegisti"
                                                                          MouseDoubleClick="Grid_HucreCiftTik"
                                                                          ContextMenuOpening="SonucMenu_Aciliyor"
                                                                          ClipboardCopyMode="ExcludeHeader"
                                                                          HeadersVisibility="All" RowHeaderWidth="18"
                                                                          BorderThickness="0,1,0,1"
                                                                          AutomationProperties.AutomationId="GridSonuc">
                                                                    <!-- v19-S15 (canlı test 2026-08-04 "uygulama patladı" — MSSQL dahil): Ctrl+A /
                                                                         sol-üst köşe dev sonuçta WPF hücre-seçim nesnelerini (satır×kolon) patlatıyordu
                                                                         → donma/OOM. Eşik üstünde SEÇİM yapılmaz; istatistik arka planda TÜM sonuçtan. -->
                                                                    <DataGrid.CommandBindings>
                                                                        <CommandBinding Command="SelectAll" Executed="Grid_TumunuSec" />
                                                                        <!-- v23-S8: Ctrl+C devralındı — tek hücre SATIR SONU EKLEMEDEN ham değer (SSMS gibi),
                                                                             çoklu seçim ham TSV. (PreviewExecuted şablon içinde TETİKLENMİYOR — ölçüldü; Executed şart.) -->
                                                                        <CommandBinding Command="Copy" Executed="Grid_Kopyala" />
                                                                    </DataGrid.CommandBindings>
                                                                    <DataGrid.Height>
                                                                        <MultiBinding Converter="{StaticResource OranliYukseklik}" FallbackValue="600">
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=ScrollViewer}" Path="ActualHeight" />
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="DataContext.SonucSetleri.Count" />
                                                                        </MultiBinding>
                                                                    </DataGrid.Height>
                                                                    <DataGrid.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="🔍 Hücreyi görüntüle (JSON/uzun metin)"
                                                                                      Click="HucreGoruntule_Click"
                                                                                      AutomationProperties.AutomationId="MenuHucreGoruntule" />
                                                                            <Separator />
                                                                            <!-- m.10 fikir 3: hücreden hızlı filtre — başlıklar/görünürlük
                                                                                 SonucMenu_Aciliyor'da seçili hücreye göre kurulur (T-SQL'e özgü). -->
                                                                            <MenuItem Tag="F:Esit" Click="HizliFiltre_Click"
                                                                                      AutomationProperties.AutomationId="MenuFiltreEsit" />
                                                                            <MenuItem Tag="F:EsitDegil" Click="HizliFiltre_Click"
                                                                                      AutomationProperties.AutomationId="MenuFiltreEsitDegil" />
                                                                            <MenuItem Tag="F:BuyukEsit" Click="HizliFiltre_Click"
                                                                                      AutomationProperties.AutomationId="MenuFiltreBuyukEsit" />
                                                                            <MenuItem Tag="F:KucukEsit" Click="HizliFiltre_Click"
                                                                                      AutomationProperties.AutomationId="MenuFiltreKucukEsit" />
                                                                            <Separator Tag="F:Ayrac" />
                                                                            <!-- v22-S1 (saha turu-2 m.5): motor süzgeci artık BAĞLAMA ile DEĞİL, SonucMenu_Aciliyor'da
                                                                                 Tag'e göre kurulur. Neden: ContextMenu kendi popup ağacında yaşar; içindeki
                                                                                 "RelativeSource AncestorType=Window" bağlaması Window'u BULAMIYOR → binding düşüyor
                                                                                 ve Visibility varsayılanda (Visible) kalıyordu. Sonuç: Mongo'ya özel "bu id nerede
                                                                                 geçiyor" MSSQL'de de görünüyordu (kullanıcı bulgusu) — MSSQL'e özel öğeler de
                                                                                 Mongo'da görünürdü. Tag sözleşmesi: M:Mongo · M:Mssql · M:Script -->
                                                                            <!-- m.26 fikir 1: Mongo'da FK yok → değerin geçtiği koleksiyonları tarar -->
                                                                            <MenuItem Header="🔎 Bu id nerede geçiyor? (koleksiyonları tara)"
                                                                                      Click="MongoIdIzi_Click" Tag="M:Mongo"
                                                                                      ToolTip="Seçili hücredeki değeri, tipi uyan TÜM koleksiyon alanlarında arar — hangi koleksiyonda kaç belge"
                                                                                      AutomationProperties.AutomationId="MenuMongoIdIzi" />
                                                                            <!-- T-SQL literal/tırnak üretirler (N'…', [Tablo]) → yalnız SQL Server (V3) -->
                                                                            <MenuItem Header="⧉ INSERT olarak kopyala"
                                                                                      Click="InsertKopyala_Click" Tag="M:Mssql"
                                                                                      ToolTip="Seçili satırları (yoksa tümünü) INSERT script'i olarak panoya alır — [Tablo] adını düzenleyin"
                                                                                      AutomationProperties.AutomationId="MenuInsertKopyala" />
                                                                            <!-- 🕸 Kayıt Haritası (2026-07-31): satırın FK'larla bağlı üst/alt kayıtları -->
                                                                            <MenuItem Header="🗑 Bağlılarıyla DELETE script'i"
                                                                                      Click="KayitHaritasiDelete_Click" Tag="M:Script"
                                                                                      ToolTip="Önce ▼ bağlı alt kayıtlar sonra bu satır için DELETE script'i üretir — ÇALIŞTIRMAZ; Güvenli Yazma açıkken koşup 🔍 ile görüp karar verirsiniz"
                                                                                      AutomationProperties.AutomationId="MenuKayitHaritasiDelete" />
                                                                            <MenuItem Header="🕸 Kayıt haritası (bağlı satırlar)"
                                                                                      Click="KayitHaritasi_Click" Tag="M:Script"
                                                                                      ToolTip="Seçili satırın işaret ettiği (▲) ve bu satırı işaret eden (▼) kayıtları çoklu grid olarak getirir — sorgular düzenlenebilir script'tir"
                                                                                      AutomationProperties.AutomationId="MenuKayitHaritasi" />
                                                                            <MenuItem Header="⧉ IN listesi olarak kopyala"
                                                                                      Click="InListeKopyala_Click" Tag="M:Mssql"
                                                                                      ToolTip="Seçili hücre değerlerinden tekilleştirilmiş IN (…) listesi üretir"
                                                                                      AutomationProperties.AutomationId="MenuInListeKopyala" />
                                                                        </ContextMenu>
                                                                    </DataGrid.ContextMenu>
                                                                </DataGrid>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="Mesajlar">
                                        <TextBox IsReadOnly="True" Text="{Binding Mesajlar, Mode=OneWay}"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Foreground="{DynamicResource MetinFircasi}" Background="{DynamicResource ZeminAcikFircasi}" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="12"
                                                 MouseDoubleClick="Mesajlar_CiftTik"
                                                 ToolTip="'Satır N' içeren hata satırına çift tıklayınca editör o satıra gider"
                                                 AutomationProperties.AutomationId="TxtMesajlar" />
                                    </TabItem>
                                </TabControl>
                                <!-- ÇALIŞIYOR BANDI (kullanıcı bulgusu 2026-07-20): sağ üstteki
                                     sayaç kalıyor ama insanlar sorgunun çalıştığını fark etmiyor →
                                     sonuç bölgesinin üstünde, canlı süreyle belirgin bir gösterge.
                                     SureMetni zaten 100 ms'de bir "⏳ …" olarak güncellenir. -->
                                <Border VerticalAlignment="Top" Padding="10,7"
                                        Background="{DynamicResource BilgiZeminFircasi}"
                                        BorderBrush="{DynamicResource VurguFircasi}" BorderThickness="0,0,0,2"
                                        Visibility="{Binding CalisiyorMu, Converter={StaticResource BoolGorunurluk}}"
                                        AutomationProperties.AutomationId="CalisiyorBandi">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="■ Durdur (Esc)" Padding="8,2"
                                                Command="{Binding IptalCommand}"
                                                ToolTip="Çalışan sorguyu iptal et"
                                                AutomationProperties.AutomationId="BtnCalisiyorDurdur" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BilgiMetinFircasi}"
                                                   AutomationProperties.AutomationId="LblCalisiyorSure">
                                            <Run Text="Sorgu çalışıyor…  " />
                                            <Run Text="{Binding SureMetni, Mode=OneWay}" FontFamily="Consolas" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </TabControl.Resources>
                </TabControl>
            </Grid>

            <!-- Sorgu geçmişi paneli (V2-S2, FG-3.7) — Ctrl+H -->
            <Border Grid.Column="3" Width="340" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource KenarFircasi}"
                    Visibility="{Binding GecmisGorunur, Converter={StaticResource BoolGorunurluk}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                        <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" MinHeight="0"
                                BorderThickness="0" Background="Transparent" Foreground="{DynamicResource SolukMetinFircasi}"
                                Command="{Binding GecmisiGizleGosterCommand}" ToolTip="Paneli kapat (Ctrl+H)"
                                AutomationProperties.AutomationId="BtnGecmisKapat" />
                        <Button DockPanel.Dock="Right" Content="⤺ Sekmeyi geri aç" Padding="6,1" MinHeight="0"
                                Margin="0,0,6,0" FontSize="11"
                                Command="{Binding KapatilanSekmeyiGeriAlCommand}"
                                ToolTip="Son kapatılan sekmeyi geri açar (Ctrl+Shift+T)"
                                AutomationProperties.AutomationId="BtnSekmeGeriAl" />
                        <TextBlock Text="Sorgu geçmişi" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top" Margin="8,0,8,4" Padding="4,3"
                             Text="{Binding GecmisAramasi, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="SQL metninde ara"
                             AutomationProperties.AutomationId="TxtGecmisArama" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,8">
                        <Button DockPanel.Dock="Right" Content="Temizle" Padding="8,2"
                                Command="{Binding GecmisiTemizleCommand}"
                                ToolTip="Tüm geçmişi siler (hassas değerler için gizlilik temizliği)"
                                AutomationProperties.AutomationId="BtnGecmisTemizle" />
                        <CheckBox VerticalAlignment="Center" Content="Geçmişi kaydet"
                                  IsChecked="{Binding GecmisAcik}"
                                  ToolTip="Kapatılırsa yeni çalıştırmalar geçmişe yazılmaz (yalnız bu bilgisayarda saklanır)"
                                  AutomationProperties.AutomationId="ChkGecmisAcik" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding GecmisKayitlari}" BorderThickness="0" Margin="4,0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             MouseDoubleClick="Gecmis_CiftTik"
                             AutomationProperties.AutomationId="ListGecmis">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GecmisGorunumu}">
                                <StackPanel Margin="4,3" ToolTip="{Binding Ipucu}"
                                            Background="Transparent">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DurumSimge}" Margin="0,0,6,0"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <!-- Durum renkleri palet fırçalarından: VM'deki sabit fırçalar
                                                     koyu temada sönük kalıp takas edilemiyordu (3. tur) -->
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TehlikeFircasi}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DurumSimge}" Value="✔">
                                                            <Setter Property="Foreground" Value="{DynamicResource BasariFircasi}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DurumSimge}" Value="■">
                                                            <Setter Property="Foreground" Value="{DynamicResource UyariFircasi}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SureMetni}"
                                                   Foreground="{DynamicResource IkincilFircasi}" FontSize="11" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource IkincilFircasi}">
                                            <Run Text="{Binding ZamanMetni, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Veritabani, Mode=OneWay}" /><Run Text="{Binding SekmeEki, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Text="{Binding SqlOzeti}" FontFamily="{StaticResource KodYazisi}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Kalıcı geçmiş şeridi: panel kapalıyken de görünür, tıkla → aç/kapa (kullanıcı isteği 2026-07-17) -->
            <Border Grid.Column="4" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource KenarFircasi}" Background="{DynamicResource PanelZeminFircasi}">
                <Button Command="{Binding GecmisiGizleGosterCommand}" Cursor="Hand"
                        BorderThickness="0" Padding="3,10" MinHeight="0"
                        ToolTip="Sorgu geçmişini aç/kapat (Ctrl+H)" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="BtnGecmisSerit">
                    <Button.Style>
                        <!-- BasedOn şart: yoksa temalı şablon gölgelenir, hover sistem mavisine döner (3. tur) -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GecmisGorunur}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource VurguZeminFircasi}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🕘 Sorgu geçmişi" FontSize="11.5" Foreground="{DynamicResource ZayifMetinFircasi}">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>
            </Border>
        </Grid>
    </DockPanel>

    <!-- Uzun sorgu bitiş bildirimi — uygulama-içi snackbar (V2-S2; 07-r2 §1: OS toast değil) -->
    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,36"
            Command="{Binding SnackbarTiklaCommand}" Cursor="Hand" BorderThickness="0"
            Visibility="{Binding SnackbarMetni, Converter={StaticResource NullGizle}}"
            AutomationProperties.AutomationId="BtnSnackbar">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <!-- Command Deck koyu snackbar (2026-07-24): ray lacivertiyle uyumlu -->
                <Border Background="#F21E1B4B" CornerRadius="8" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Button.Template>
        <TextBlock Text="{Binding SnackbarMetni}" Foreground="White" FontSize="12.5"
                   ToolTip="Sekmeye gitmek için tıklayın" />
    </Button>
    </Grid>
</Window>
