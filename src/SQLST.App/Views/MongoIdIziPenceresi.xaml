<Window x:Class="SQLST.App.Views.MongoIdIziPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — 🔎 ObjectId izi" Width="900" Height="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        MinWidth="640" MinHeight="380"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="12">
        <!-- Aranan değer + ilerleme + durdur -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelZeminFircasi}"
                BorderBrush="{DynamicResource KenarFircasi}" BorderThickness="1" CornerRadius="6"
                Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Değer:" VerticalAlignment="Center"
                           Foreground="{DynamicResource SolukMetinFircasi}" Margin="0,0,6,0" />
                <TextBox x:Name="DegerKutusu" DockPanel.Dock="Left" IsReadOnly="True" Width="290"
                         FontFamily="Cascadia Mono, Consolas" Padding="6,3" Margin="0,0,12,0"
                         AutomationProperties.AutomationId="TxtIdIziDeger" />
                <Button DockPanel.Dock="Right" x:Name="DurdurDugmesi" Content="⏹ Durdur" Padding="12,4"
                        Click="Durdur_Click" AutomationProperties.AutomationId="BtnIdIziDurdur" />
                <TextBlock x:Name="Ilerleme" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource BilgiMetinFircasi}"
                           AutomationProperties.AutomationId="LblIdIziIlerleme" />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" x:Name="Ozet" Margin="2,8,2,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SolukMetinFircasi}" FontSize="11.5"
                   AutomationProperties.AutomationId="LblIdIziOzet" />

        <DataGrid x:Name="Sonuclar" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" MinRowHeight="26"
                  MouseDoubleClick="Sonuc_CiftTik"
                  AutomationProperties.AutomationId="GridIdIzi">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Koleksiyon" Binding="{Binding Koleksiyon}" Width="2*" />
                <DataGridTextColumn Header="Alan" Binding="{Binding Alan}" Width="2*" />
                <DataGridTextColumn Header="Eşleşen" Binding="{Binding EslesenMetni}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
