<Window x:Class="SQLST.App.Views.InsertSatirPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — INSERT örneği" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <StackPanel Margin="16">
        <TextBlock Text="Kaç satır INSERT üretilsin?" FontWeight="SemiBold" Margin="0,0,0,4"
                   AutomationProperties.AutomationId="LblInsertSatir" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                   Foreground="{DynamicResource SolukMetinFircasi}"
                   Text="Her satır aynı tip-farkında örnek değerlerle gelir; tek satır isteyen fazlasını silebilir (1–1000)." />

        <TextBox x:Name="SatirKutusu" Text="1" Padding="6,4" MaxLength="4"
                 PreviewTextInput="SadeceRakam" AutomationProperties.AutomationId="TxtInsertSatir" />
        <TextBlock x:Name="Uyari" Foreground="#E05561" FontSize="12" Margin="0,4,0,0"
                   Visibility="Collapsed" AutomationProperties.AutomationId="LblInsertUyari" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="İptal" Padding="14,5" Margin="0,0,8,0" IsCancel="True" Click="Iptal_Click"
                    AutomationProperties.AutomationId="BtnInsertIptal" />
            <Button Content="Oluştur" Padding="16,5" IsDefault="True" Style="{StaticResource BirincilDugme}"
                    Click="Tamam_Click" AutomationProperties.AutomationId="BtnInsertTamam" />
        </StackPanel>
    </StackPanel>
</Window>
