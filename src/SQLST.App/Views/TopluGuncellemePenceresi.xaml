<Window x:Class="SQLST.App.Views.TopluGuncellemePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — Kolonu toplu güncelle" Height="290" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PencereZeminFircasi}"
        Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Padding="8" Margin="0,0,0,10" CornerRadius="3"
                Background="{DynamicResource UyariZeminFircasi}"
                BorderBrush="{DynamicResource UyariKenarFircasi}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource UyariMetinFircasi}"
                       Text="Bu işlem YALNIZ ekranda yüklü satırları değiştirir — tablonun tamamını değil. Değişiklik hemen sunucuya gitmez: Uygula'ya bastığınızda üretilen UPDATE'leri önizler ve onaylarsınız. Her satır kendi birincil anahtarıyla güncellenir." />
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="İptal" Width="90" Padding="0,4" Margin="6,0,0,0"
                    IsCancel="True" AutomationProperties.AutomationId="BtnTopluIptal" />
            <Button DockPanel.Dock="Right" Content="Uygula" Width="90" Padding="0,4"
                    IsDefault="True" Click="Tamam_Click"
                    AutomationProperties.AutomationId="BtnTopluTamam" />
            <TextBlock />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Kolon:" Margin="0,6,8,6" VerticalAlignment="Center" />
            <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,6" x:Name="KolonKutusu"
                       AutomationProperties.AutomationId="CmbTopluKolon" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Değer:" Margin="0,6,8,6" VerticalAlignment="Center" />
            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,6" x:Name="DegerKutusu"
                       AutomationProperties.AutomationId="TxtTopluDeger" />

            <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,6" x:Name="NullKutusu"
                      Content="NULL ata (değer alanı yok sayılır)"
                      AutomationProperties.AutomationId="ChkTopluNull" />
        </Grid>
    </DockPanel>
</Window>
