<Window x:Class="SQLST.App.Views.SunucuKlasorPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunucuda seç" Width="560" Height="520" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}"
        FontFamily="Segoe UI" FontSize="12.5">
    <!-- 📂 Sunucu klasör gezgini (v23-S26, K4): xp_dirtree ile SUNUCUNUN diski — yedek oraya yazılır.
         Klasöre çift tık iner, ⬆ üst klasöre çıkar; dosya adı altta; "Seç" tam yolu döner. -->
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource BilgiMetinFircasi}"
                       Text="Bu liste SUNUCUNUN diskidir (SQL Server hizmetinin gördüğü klasörler) — yedek buraya yazılır, bilgisayarınıza değil." />
        </Border>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="⬆ Üst" Padding="8,3" Margin="0,0,6,0" Click="Ust_Click" AutomationProperties.AutomationId="BtnKlasorUst" />
            <Button DockPanel.Dock="Right" Content="Git" Padding="8,3" Margin="6,0,0,0" Click="Git_Click" AutomationProperties.AutomationId="BtnKlasorGit" />
            <TextBox x:Name="YolKutusu" Padding="6,3" FontFamily="Consolas" KeyDown="Yol_KeyDown" AutomationProperties.AutomationId="TxtKlasorYol" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Vazgeç" Padding="12,4" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Seç" Padding="14,4" FontWeight="SemiBold" Click="Sec_Click" IsDefault="True"
                        Background="{DynamicResource VurguFircasi}" Foreground="White" BorderBrush="{DynamicResource VurguFircasi}"
                        AutomationProperties.AutomationId="BtnKlasorSec" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="Dosya adı:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource SolukMetinFircasi}" />
            <TextBox x:Name="DosyaAdi" Padding="6,3" FontFamily="Consolas" AutomationProperties.AutomationId="TxtKlasorDosya" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Durum" FontSize="11.5" Foreground="{DynamicResource SolukMetinFircasi}" Margin="0,6,0,0" />
        <ListBox x:Name="Liste" MouseDoubleClick="Liste_CiftTik" SelectionChanged="Liste_Secim" FontFamily="Consolas" FontSize="12"
                 AutomationProperties.AutomationId="ListeKlasor" />
    </DockPanel>
</Window>
