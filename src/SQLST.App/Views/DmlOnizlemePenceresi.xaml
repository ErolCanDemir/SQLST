<Window x:Class="SQLST.App.Views.DmlOnizlemePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — Değişiklik önizlemesi" Width="680" Height="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}" ShowInTaskbar="False" MinWidth="480" MinHeight="300">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Aşağıdaki komutlar TEK işlemde çalıştırılacak. Herhangi biri hata alır ya da 0 satır etkilerse (çakışma) TÜMÜ geri alınır." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="KomutSayisi" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource ZayifMetinFircasi}" />
            <Button Content="Vazgeç" Padding="16,5" Margin="0,0,8,0" IsCancel="True"
                    AutomationProperties.AutomationId="BtnOnizlemeVazgec" />
            <Button Content="✔ Uygula" Padding="20,5" Style="{StaticResource BirincilDugme}"
                    Click="Uygula_Click" AutomationProperties.AutomationId="BtnOnizlemeUygula" />
        </StackPanel>
        <TextBox x:Name="ScriptKutusu" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="6"
                 Background="{DynamicResource ZeminAcikFircasi}" AutomationProperties.AutomationId="TxtOnizlemeScript" />
    </DockPanel>
</Window>
