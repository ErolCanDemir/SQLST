<Window x:Class="SQLST.App.Views.TarihcePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diffplex="clr-namespace:DiffPlex.Wpf.Controls;assembly=DiffPlex.Wpf"
        Title="SQLST — Nesne Tarihçesi" Width="1000" Height="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}" ShowInTaskbar="False" MinWidth="700" MinHeight="400">
    <DockPanel Margin="10">
        <!-- Dürüst sınır (06-r1 Ö2): denetim günlüğü değildir -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}" Padding="8,5" Margin="0,0,0,8">
            <TextBlock x:Name="UstBilgi" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Sürümler (2 seçin → karşılaştırma)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Button DockPanel.Dock="Bottom" Content="⧉ Seçili sürümü ALTER olarak sekmeye aç" Padding="8,5" Margin="0,8,0,0"
                        Click="SekmeyeAc_Click" AutomationProperties.AutomationId="BtnTarihceSekmeyeAc" />
                <ListBox x:Name="Surumler" SelectionMode="Extended" SelectionChanged="Secim_Degisti"
                         HorizontalContentAlignment="Stretch"
                         AutomationProperties.AutomationId="ListSurumler">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding ZamanMetni}" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource SolukMetinFircasi}">
                                    <Run Text="{Binding Kayit.Kaynak, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding HashKisa, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="DiffBaslik" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"
                           Text="Karşılaştırma" AutomationProperties.AutomationId="LblDiffBaslik" />
                <diffplex:DiffViewer x:Name="Diff" IgnoreWhiteSpace="False"
                                     AutomationProperties.AutomationId="DiffGorunumu" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
