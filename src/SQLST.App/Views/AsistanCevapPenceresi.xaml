<Window x:Class="SQLST.App.Views.AsistanCevapPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — AI" Width="760" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Padding="10,7" CornerRadius="4" Margin="0,0,0,10"
                Background="{DynamicResource BilgiZeminFircasi}">
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="{StaticResource Ikon.Robot}" Stretch="Uniform"
                      Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                      Stroke="#EC4899" StrokeThickness="1.8" Fill="Transparent"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="DurumMetni" Text="Model düşünüyor…" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource BilgiMetinFircasi}"
                           AutomationProperties.AutomationId="LblAiDurum" />
            </DockPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Kapat" Padding="18,5" IsCancel="True"
                    Click="Kapat_Click" AutomationProperties.AutomationId="BtnAiKapat" />
            <Button DockPanel.Dock="Right" x:Name="SekmedeAcDugmesi" Content="↗ Sorguyu sekmede aç"
                    Padding="12,5" Margin="0,0,8,0" Visibility="Collapsed"
                    Style="{StaticResource BirincilDugme}" Click="SekmedeAc_Click"
                    ToolTip="Cevaptaki sorguyu yeni sekmede açar — çalıştırmaz"
                    AutomationProperties.AutomationId="BtnAiSekmedeAc" />
            <TextBlock />
        </DockPanel>
        <!-- Cevap zengin metin olarak çizilir (Markdown → WPF; rötuş 2 — ham yıldız/backtick bitti) -->
        <Border BorderThickness="1" CornerRadius="6" Padding="14,10"
                BorderBrush="{DynamicResource KenarFircasi}"
                Background="{DynamicResource PencereZeminFircasi}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="CevapAlani"
                                  AutomationProperties.AutomationId="TxtAiCevap" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
