<Window x:Class="SQLST.App.Views.HucrePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — Hücre içeriği" Width="640" Height="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}" ShowInTaskbar="False" MinWidth="360" MinHeight="240">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="⧉ Kopyala" Padding="10,3"
                    Click="Kopyala_Click" AutomationProperties.AutomationId="BtnHucreKopyala" />
            <!-- v20-S14 madde 3: hücre bir FK ise referans lookup tablosunun açıklamasını araştır -->
            <Button DockPanel.Dock="Right" x:Name="LookupDugmesi" Content="🔎 Lookup tablo araştır" Padding="10,3"
                    Margin="0,0,8,0" Click="Lookup_Click" Visibility="Collapsed"
                    ToolTip="Bu kolon bir yabancı anahtarsa referans tablonun açıklamasını (tanım) getirir"
                    AutomationProperties.AutomationId="BtnHucreLookup" />
            <TextBlock x:Name="BicimNotu" VerticalAlignment="Center" Foreground="{DynamicResource BasariFircasi}" FontSize="12" />
        </DockPanel>
        <Border DockPanel.Dock="Top" x:Name="LookupSonucKutu" Visibility="Collapsed" Margin="0,0,0,6" Padding="8,5"
                Background="{DynamicResource BilgiZeminFircasi}" BorderBrush="{DynamicResource KenarFircasi}"
                BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="LookupSonuc" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{DynamicResource BilgiMetinFircasi}" />
        </Border>
        <Button DockPanel.Dock="Bottom" Content="Kapat" HorizontalAlignment="Right" Padding="16,4"
                Margin="0,8,0,0" IsCancel="True" AutomationProperties.AutomationId="BtnHucreKapat" />
        <!-- VerticalContentAlignment=Top ŞART (m.2): Tema.xaml'deki genel TextBox stili Center verir
             (tek satırlık giriş kutuları için doğru) — burada metin kutunun ORTASINDAN başlıyordu. -->
        <TextBox x:Name="Icerik" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="6"
                 Background="{DynamicResource ZeminAcikFircasi}" AutomationProperties.AutomationId="TxtHucreIcerik" />
    </DockPanel>
</Window>
