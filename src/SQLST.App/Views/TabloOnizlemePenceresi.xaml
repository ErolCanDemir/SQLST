<Window x:Class="SQLST.App.Views.TabloOnizlemePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — 👁 Tablo önizleme" Width="720" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <!-- v22-S3 (saha turu-3 m.1, kullanıcı: "tablo önizlemeyi sağ tıkla da koyalım"): editördeki
         Ctrl+hover önizlemesinin menü karşılığı. İçerik AYNI saf sınıftan (TabloOnizleme) üretilir —
         iki yüzey ayrı kod yazmaz, davranış birebir aynı kalır. -->
    <DockPanel Margin="16,14,16,12">
        <TextBlock DockPanel.Dock="Top" x:Name="Basligi" FontWeight="SemiBold" FontSize="14"
                   TextWrapping="Wrap" AutomationProperties.AutomationId="LblOnizlemeBaslik" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="▶ İlk 100 satırı sekmede aç" Padding="12,4" Margin="0,0,8,0"
                    Click="SekmedeAc_Click" AutomationProperties.AutomationId="BtnOnizlemeSekmedeAc" />
            <Button Content="📋 Kopyala" Padding="12,4" Margin="0,0,8,0" Click="Kopyala_Click"
                    AutomationProperties.AutomationId="BtnOnizlemeKopyala" />
            <Button Content="Kapat" Padding="16,4" IsCancel="True" IsDefault="True"
                    AutomationProperties.AutomationId="BtnOnizlemeKapat" />
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Kolonlar" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                           AutomationProperties.AutomationId="LblOnizlemeKolonlar" />
            </ScrollViewer>

            <Border Grid.Row="1" Margin="0,10,0,0" Padding="8" CornerRadius="3"
                    Background="{DynamicResource EditorZeminFircasi}" BorderThickness="1"
                    BorderBrush="{DynamicResource KenarFircasi}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Veri" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                               Foreground="{DynamicResource EditorMetinFircasi}"
                               AutomationProperties.AutomationId="LblOnizlemeVeri" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
