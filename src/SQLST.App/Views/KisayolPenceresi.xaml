<Window x:Class="SQLST.App.Views.KisayolPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — Kısayollar" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}" ResizeMode="NoResize" Icon="../sqlst.ico"
        ShowInTaskbar="False">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="Kapat_Executed" />
    </Window.CommandBindings>
    <StackPanel Margin="16">
        <TextBlock Text="Klavye kısayolları" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
        <ItemsControl x:Name="Liste" AutomationProperties.AutomationId="ListKisayollar">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource PanelZeminFircasi}" CornerRadius="3"
                                Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Tus}" FontFamily="Consolas" FontSize="12" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Aciklama}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Kapat" HorizontalAlignment="Right" Padding="20,5" Margin="0,12,0,0"
                IsCancel="True" AutomationProperties.AutomationId="BtnKisayolKapat" />
    </StackPanel>
</Window>
