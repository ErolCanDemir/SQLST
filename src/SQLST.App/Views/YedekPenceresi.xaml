<Window x:Class="SQLST.App.Views.YedekPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SQLST.App.ViewModels"
        xmlns:conv="clr-namespace:SQLST.App.Converters"
        Title="{Binding PencereBasligi}" Width="1040" Height="700" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}"
        FontFamily="Segoe UI" FontSize="12.5">
    <!-- 💾 Yedek al (v23-S26 S1) — mockup docs/mockup/yedek-geri-yukle.html ONAYLI.
         Sol: tür · hedef · seçenekler · son yedekler · sağ: canlı script + ilerleme · alt: durum + düğmeler. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolGorunurluk" />
        <conv:TersBool x:Key="TersBool" />
        <conv:TersBoolGorunurluk x:Key="TersBoolGorunurluk" />
        <conv:EnumEsit x:Key="EnumEsit" />
        <conv:MetinVarsaGorunur x:Key="MetinVarsaGorunur" />
        <Style x:Key="Etiket" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SolukMetinFircasi}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Not" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource SolukMetinFircasi}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="Alan" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- alt şerit -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SeritFircasi}" BorderBrush="{DynamicResource KenarFircasi}"
                BorderThickness="0,1,0,0" Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="📄 Script olarak al" Padding="12,5" Margin="0,0,8,0" Command="{Binding ScriptiAlCommand}"
                            ToolTip="BACKUP script'ini yeni sorgu sekmesinde açar — çalıştırmaz"
                            AutomationProperties.AutomationId="BtnYedekScript" />
                    <Button Content="■ İptal" Padding="12,5" Margin="0,0,8,0" Command="{Binding IptalCommand}"
                            IsEnabled="{Binding Calisiyor}" AutomationProperties.AutomationId="BtnYedekIptal" />
                    <Button x:Name="KapatDugmesi" Content="Kapat" Padding="12,5" Margin="0,0,8,0" Click="Kapat_Click"
                            AutomationProperties.AutomationId="BtnYedekKapat" />
                    <Button Content="▶ Yedekle" Padding="14,5" FontWeight="SemiBold" Command="{Binding YedekleCommand}"
                            IsEnabled="{Binding YedeklenebilirMi}" IsDefault="True"
                            Background="{DynamicResource VurguFircasi}" Foreground="White" BorderBrush="{DynamicResource VurguFircasi}"
                            AutomationProperties.AutomationId="BtnYedekle" />
                </StackPanel>
                <TextBlock Text="{Binding Durum}" VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource SolukMetinFircasi}" AutomationProperties.AutomationId="LblYedekDurum" />
            </DockPanel>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding Calisiyor, Converter={StaticResource TersBool}}">
                    <TextBlock Text="{Binding SunucuOzeti}" FontSize="11.5" Foreground="{DynamicResource SolukMetinFircasi}"
                               Margin="0,0,0,10" AutomationProperties.AutomationId="LblYedekSunucu" />

                    <StackPanel Style="{StaticResource Alan}">
                        <TextBlock Text="YEDEK TÜRÜ" Style="{StaticResource Etiket}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Tam" Margin="0,0,14,0" AutomationProperties.AutomationId="RbYedekTam"
                                         IsChecked="{Binding Tur, Converter={StaticResource EnumEsit}, ConverterParameter=Tam}" />
                            <RadioButton Content="Fark (son tam yedeğe göre)" Margin="0,0,14,0" AutomationProperties.AutomationId="RbYedekFark"
                                         IsChecked="{Binding Tur, Converter={StaticResource EnumEsit}, ConverterParameter=Fark}" />
                            <RadioButton Content="İşlem günlüğü" IsEnabled="{Binding GunlukSecilebilir}" AutomationProperties.AutomationId="RbYedekGunluk"
                                         ToolTip="Yalnız kurtarma modeli FULL / BULK_LOGGED ise alınabilir"
                                         IsChecked="{Binding Tur, Converter={StaticResource EnumEsit}, ConverterParameter=Gunluk}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SonTamYedekNotu}" Style="{StaticResource Not}" AutomationProperties.AutomationId="LblSonTamYedek" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Alan}">
                        <TextBlock Text="HEDEF DOSYA (SUNUCUNUN DİSKİNDE)" Style="{StaticResource Etiket}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="📂 Sunucuda seç…" Padding="9,3" Margin="6,0,0,0" Click="SunucudaSec_Click"
                                    ToolTip="Sunucunun klasörlerini listeler (xp_dirtree) — yedek sunucu diskine yazılır"
                                    AutomationProperties.AutomationId="BtnYedekKlasor" />
                            <TextBox Text="{Binding Dosya, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" FontFamily="Consolas"
                                     AutomationProperties.AutomationId="TxtYedekDosya" />
                        </DockPanel>
                        <TextBlock Text="{Binding KlasorNotu}" Style="{StaticResource Not}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Alan}">
                        <TextBlock Text="SEÇENEKLER" Style="{StaticResource Etiket}" />
                        <WrapPanel>
                            <CheckBox Content="Yalnız kopya (COPY__ONLY — zinciri bozmaz)" IsChecked="{Binding KopyaOnly}" Margin="0,0,14,6"
                                      AutomationProperties.AutomationId="ChkYedekKopya" />
                            <CheckBox Content="Sağlama (CHECKSUM)" IsChecked="{Binding Checksum}" Margin="0,0,14,6"
                                      AutomationProperties.AutomationId="ChkYedekChecksum" />
                            <CheckBox Content="Sıkıştır" IsChecked="{Binding Sikistir}" Margin="0,0,14,6"
                                      Visibility="{Binding SikistirmaGorunur, Converter={StaticResource BoolGorunurluk}}"
                                      AutomationProperties.AutomationId="ChkYedekSikistir" />
                            <CheckBox Content="Dosyanın üzerine yaz (INIT)" IsChecked="{Binding UzerineYaz}" Margin="0,0,14,6"
                                      ToolTip="Kapalıysa dosyaya EKLENİR (NOINIT) — aynı dosyada birden çok yedek seti"
                                      AutomationProperties.AutomationId="ChkYedekInit" />
                        </WrapPanel>
                        <TextBlock Text="Bu sürümde (Express/LocalDB) yedek sıkıştırma yok." Style="{StaticResource Not}"
                                   Visibility="{Binding SikistirmaGorunur, Converter={StaticResource TersBoolGorunurluk}}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="AD" Style="{StaticResource Etiket}" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="TxtYedekAd" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="AÇIKLAMA" Style="{StaticResource Etiket}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                                     AutomationProperties.AutomationId="TxtYedekAciklama" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Alan}">
                        <TextBlock Text="BU VERİTABANININ SON YEDEKLERİ (MSDB)" Style="{StaticResource Etiket}" />
                        <DataGrid ItemsSource="{Binding Tarihce}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  MaxHeight="190" CanUserSortColumns="False" AutomationProperties.AutomationId="GridYedekTarihce">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" />
                                <DataGridTextColumn Header="Tür" Binding="{Binding Tur}" />
                                <DataGridTextColumn Header="Boyut" Binding="{Binding Boyut}" />
                                <DataGridTextColumn Header="Dosya" Binding="{Binding Dosya}" Width="260" />
                                <DataGridTextColumn Header="Kullanıcı" Binding="{Binding Kullanici}" />
                                <DataGridTextColumn Header="Not" Binding="{Binding Not}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- SAĞ -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="SCRIPT (CANLI ÖNİZLEME)" Style="{StaticResource Etiket}" />
                <!-- engel bandı: Dogrula'nın ilk hatası -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource UyariZeminFircasi}" BorderBrush="{DynamicResource UyariKenarFircasi}"
                        BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,8"
                        Visibility="{Binding Engel, Converter={StaticResource MetinVarsaGorunur}}">
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource UyariMetinFircasi}"
                               AutomationProperties.AutomationId="LblYedekEngel"><Run Text="⚠ " /><Run Text="{Binding Engel, Mode=OneWay}" /></TextBlock>
                </Border>
                <!-- ilerleme: yalnız koşarken / bittikten sonra (boş çubuk kaydırma çubuğu gibi görünüyordu — piksel bulgusu) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                            Visibility="{Binding IlerlemeGorunur, Converter={StaticResource BoolGorunurluk}}">
                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Yuzde, Mode=OneWay}"
                                 Foreground="{DynamicResource VurguFircasi}" AutomationProperties.AutomationId="PbYedek" />
                    <TextBlock Text="{Binding IlerlemeMetni}" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource SolukMetinFircasi}" AutomationProperties.AutomationId="LblYedekIlerleme" />
                    <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="6,4" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             Visibility="{Binding Log, Converter={StaticResource MetinVarsaGorunur}}"
                             Foreground="{DynamicResource SolukMetinFircasi}" AutomationProperties.AutomationId="TxtYedekLog" />
                </StackPanel>
                <TextBox Text="{Binding Script, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Padding="10,8"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                         Background="{DynamicResource EditorZeminFircasi}" Foreground="{DynamicResource EditorMetinFircasi}"
                         AutomationProperties.AutomationId="TxtYedekScript" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
