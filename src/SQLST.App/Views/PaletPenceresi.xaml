<Window x:Class="SQLST.App.Views.PaletPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" Topmost="False" Deactivated="Pencere_Deactivated">
    <Border Background="{DynamicResource PencereZeminFircasi}" BorderBrush="{DynamicResource BilgiMetinFircasi}" BorderThickness="2" CornerRadius="8"
            Padding="10" SnapsToDevicePixels="True">
        <StackPanel>
            <TextBox x:Name="Arama" FontSize="14" Padding="6,5" BorderThickness="1"
                     TextChanged="Arama_TextChanged" PreviewKeyDown="Arama_KeyDown"
                     AutomationProperties.AutomationId="TxtPaletArama" />
            <ListBox x:Name="Sonuclar" MaxHeight="330" Margin="0,8,0,0" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="Sonuc_CiftTik"
                     AutomationProperties.AutomationId="ListPaletSonuclar">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,2">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource BilgiZeminFircasi}" CornerRadius="3" Padding="6,1">
                                <TextBlock Text="{Binding Kategori}" FontSize="10.5" Foreground="{DynamicResource BilgiMetinFircasi}" />
                            </Border>
                            <TextBlock Text="{Binding Gosterim}" FontSize="12.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="↑↓ gezin · Enter aç · Esc kapat" FontSize="10.5" Foreground="{DynamicResource SolukMetinFircasi}" Margin="2,6,0,0" />
        </StackPanel>
    </Border>
</Window>
