<Window x:Class="SQLST.App.Views.SpParametrePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — Prosedürü çalıştır" Width="560" Height="420" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" x:Name="Baslik" FontWeight="SemiBold" Margin="0,0,0,4"
                   AutomationProperties.AutomationId="LblSpBaslik" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                   Foreground="{DynamicResource SolukMetinFircasi}"
                   Text="Parametre değerlerini girin. Metin/tarih değerleri otomatik tırnaklanır; sayısal tipler olduğu gibi geçer. Boş bırakılan giriş parametresi NULL olur. OUTPUT parametreleri için değer girilmez — çağrı sonrası değeri ekranda gösterilir." />

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnSpCalistir" Content="▶ Çalıştır" Padding="16,5"
                    Style="{StaticResource BirincilDugme}" Click="Calistir_Click"
                    ToolTip="Girilen değerlerle EXEC üretir, yeni sekmede açar ve çalıştırır"
                    AutomationProperties.AutomationId="BtnSpCalistir" />
            <Button DockPanel.Dock="Right" Content="Sekmeye al (çalıştırma)" Padding="14,5" Margin="0,0,8,0"
                    Click="SekmeyeAl_Click"
                    ToolTip="EXEC'i yeni sekmede açar ama çalıştırmaz — inceleyip F5 dersiniz"
                    AutomationProperties.AutomationId="BtnSpSekmeyeAl" />
            <Button DockPanel.Dock="Right" Content="İptal" Padding="14,5" Margin="0,0,8,0"
                    Click="Iptal_Click" AutomationProperties.AutomationId="BtnSpIptal" />
        </DockPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="{DynamicResource PanelZeminFircasi}"
                  AutomationProperties.AutomationId="GrdSpParametreler">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parametre" Binding="{Binding Ad}" IsReadOnly="True" Width="Auto" MinWidth="120" />
                <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" IsReadOnly="True" Width="Auto" MinWidth="90" />
                <DataGridTextColumn Header="Yön" Binding="{Binding Yon}" IsReadOnly="True" Width="Auto" MinWidth="60" />
                <DataGridTextColumn Header="Değer" Binding="{Binding Deger, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
