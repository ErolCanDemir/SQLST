<Window x:Class="SQLST.App.Views.GorselWherePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — WHERE düzenle" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold"
                   Text="{Binding Baslik, RelativeSource={RelativeSource AncestorType=Window}}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="11.5"
                   Foreground="{DynamicResource SolukMetinFircasi}"
                   Text="Satır satır koşul. İlk satırın VE/VEYA bağlacı yok sayılır. Sayı yazarsanız tırnaksız, metin yazarsanız tırnaklı üretilir." />

        <!-- Alt düğmeler -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="+ Koşul ekle" Padding="12,5"
                    Click="KosulEkle_Click" AutomationProperties.AutomationId="BtnKosulEkle" />
            <Button DockPanel.Dock="Right" Content="Tamam" Padding="22,5" IsDefault="True"
                    Style="{StaticResource BirincilDugme}" Click="Tamam_Click"
                    AutomationProperties.AutomationId="BtnWhereTamam" />
        </DockPanel>

        <!-- Koşul satırları -->
        <ItemsControl ItemsSource="{Binding Kosullar}" AutomationProperties.AutomationId="WhereKosullar">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3">
                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="KosulSil_Click" ToolTip="Bu koşulu kaldır" />
                        <!-- VE/VEYA bağlacı (ilk satırda anlamsız, üretimde yok sayılır):
                             işaretli = bir öncekiyle VEYA, boş = VE. -->
                        <CheckBox DockPanel.Dock="Left" Content="VEYA" Width="62" Margin="0,0,6,0"
                                  VerticalAlignment="Center" IsChecked="{Binding VeyaMi}"
                                  ToolTip="İşaretli: bir öncekiyle VEYA · boş: VE" />
                        <ComboBox DockPanel.Dock="Left" Width="150" Margin="0,0,6,0"
                                  ItemsSource="{Binding KolonAdlari, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Kolon}" />
                        <ComboBox DockPanel.Dock="Left" Width="170" Margin="0,0,6,0"
                                  ItemsSource="{Binding OperatorSecenekleri, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Etiket" SelectedValuePath="Deger"
                                  SelectedValue="{Binding Operator}" />
                        <TextBox Text="{Binding Deger, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding DegerGerekli}" VerticalContentAlignment="Center"
                                 ToolTip="Değer (IS NULL / IS NOT NULL için gerekmez)" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
