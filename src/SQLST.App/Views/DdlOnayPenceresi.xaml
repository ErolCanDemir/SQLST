<Window x:Class="SQLST.App.Views.DdlOnayPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — Yeni tablo onayı" Width="640" Height="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12.5"
                   Text="Hedef tablo yok — aşağıdaki script'le OLUŞTURULACAK, ardından aktarım başlayacak. Kolon tipleri dosya örnekleminden tahmin edildi (hepsi NULL izinli; PK üretilmez). Scripti inceleyin:"
                   AutomationProperties.AutomationId="LblDdlNot" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="✔ Oluştur ve aktar" Padding="14,5"
                    Style="{StaticResource BirincilDugme}" Click="Onayla_Click"
                    AutomationProperties.AutomationId="BtnDdlOnay" />
            <Button DockPanel.Dock="Right" Content="İptal" Padding="14,5" Margin="0,0,8,0"
                    Click="Iptal_Click" AutomationProperties.AutomationId="BtnDdlIptal" />
        </DockPanel>
        <TextBox x:Name="Script" IsReadOnly="True" FontFamily="{StaticResource KodYazisi}" FontSize="12.5"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.AutomationId="TxtDdlScript" />
    </DockPanel>
</Window>
