<Window x:Class="SQLST.App.Views.KolonIstatistikPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — 📊 Kolon istatistiği" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <StackPanel Margin="18,16,18,14">
        <TextBlock x:Name="Basligi" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LblIstatistikBaslik" />
        <TextBlock x:Name="Durum" Margin="0,8,0,0" Foreground="{DynamicResource SolukMetinFircasi}"
                   TextWrapping="Wrap" AutomationProperties.AutomationId="LblIstatistikDurum" />

        <ItemsControl x:Name="Satirlar" Margin="0,10,0,0" AutomationProperties.AutomationId="ListeIstatistik">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3">
                        <TextBlock Text="{Binding Etiket}" Width="110"
                                   Foreground="{DynamicResource ZayifMetinFircasi}" />
                        <TextBlock Text="{Binding Deger}" FontFamily="Cascadia Mono, Consolas"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Deger}" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="NotMetni" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource UyariMetinFircasi}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="📋 Kopyala" Padding="12,4" Margin="0,0,8,0" Click="Kopyala_Click"
                    AutomationProperties.AutomationId="BtnIstatistikKopyala" />
            <Button Content="Kapat" Padding="16,4" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
