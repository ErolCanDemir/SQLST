<Window x:Class="SQLST.App.Views.LinqSqlPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="SQLST — 🔁 LINQ ⇄ SQL" Width="1160" Height="700"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- üst şerit: hedef bilgisi + çıktı eylemleri (çevir düğmeleri KENDİ panellerinin
             üstünde — saha m.8 kullanıcı önerisi: hangi düğme hangi paneli çevirir, karışmasın) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" x:Name="HedefMetni" VerticalAlignment="Center"
                       FontSize="12.5" Foreground="{DynamicResource SolukMetinFircasi}"
                       AutomationProperties.AutomationId="LblLinqHedef" />
            <Button DockPanel.Dock="Right" x:Name="CalistirDugmesi" Content="▶ Sekmede Aç ve Çalıştır" Padding="12,6"
                    Click="SekmedeAc_Click" IsEnabled="False" Margin="6,0,0,0"
                    ToolTip="Üretilen SQL'i yeni sorgu sekmesinde açar ve hemen çalıştırır"
                    AutomationProperties.AutomationId="BtnLinqCalistir" />
            <Button DockPanel.Dock="Right" x:Name="KopyalaDugmesi" Content="⧉ SQL'i Kopyala" Padding="12,6"
                    Click="Kopyala_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="BtnLinqKopyala" />
            <Border />
        </DockPanel>

        <!-- gövde: LINQ | ayırıcı | SQL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- SQL SOLDA (kullanıcı isteği 2026-08-07): DB tarafı birincil çalışma alanı.
                 Çevir düğmesi PANELİN ÜSTÜNDE: bu düğme BU panelin içeriğini çevirir (m.8). -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,6,4">
                    <Button DockPanel.Dock="Right" x:Name="TersCevirDugmesi"
                            Content="Bu SQL'i LINQ'a Çevir ➜ (Shift+F5)" Padding="12,4"
                            Click="TersCevir_Click"
                            ToolTip="SOLDAKİ T-SQL SELECT'i sağda C# LINQ'a çevirir (şema gerekmez)"
                            AutomationProperties.AutomationId="BtnSqlLinqCevir" />
                    <TextBlock Text="SQL" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource SolukMetinFircasi}" />
                </DockPanel>
                <avalon:TextEditor x:Name="SqlEditor" ShowLineNumbers="True" WordWrap="False"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                   AutomationProperties.AutomationId="LinqSqlCikti" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,4">
                    <Button DockPanel.Dock="Right" x:Name="CevirDugmesi"
                            Content="⬅ Bu LINQ'u SQL'e Çevir (F5)" Padding="12,4"
                            Click="Cevir_Click" Style="{StaticResource BirincilDugme}"
                            ToolTip="SAĞDAKİ C# LINQ'i solda motorun SQL'ine çevirir (şema+FK farkındalıklı)"
                            AutomationProperties.AutomationId="BtnLinqCevir" />
                    <TextBlock Text="C# LINQ" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource SolukMetinFircasi}" />
                </DockPanel>
                <avalon:TextEditor x:Name="LinqEditor" ShowLineNumbers="True" WordWrap="False"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                   AutomationProperties.AutomationId="LinqGirdi" />
            </DockPanel>
        </Grid>

        <!-- durum/uyarı bandı -->
        <Border Grid.Row="2" Background="{DynamicResource BilgiZeminFircasi}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource KenarFircasi}" Padding="10,6" Margin="0,8,0,0">
            <TextBlock x:Name="DurumMetni" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource BilgiMetinFircasi}"
                       Text="SQL'i sola yazın (öneriler Ctrl+Space) → ➜ LINQ'a çevir · ya da LINQ'i sağa yapıştırın → ⬅ SQL'e çevir (şema+FK farkındalıklı). İki yön de kendi motorumuz — AI yok, çevrimdışı."
                       AutomationProperties.AutomationId="LblLinqDurum" />
        </Border>
    </Grid>
</Window>
