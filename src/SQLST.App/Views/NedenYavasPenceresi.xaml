<Window x:Class="SQLST.App.Views.NedenYavasPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SQLST.App.Converters"
        xmlns:app="clr-namespace:SQLST.Application;assembly=SQLST.Application"
        Title="SQLST — Performans değerlendirmesi" Width="780" Height="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <Window.Resources>
        <conv:NullGizleConverter x:Key="NullGizle" />
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" x:Name="Ozet" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"
                   AutomationProperties.AutomationId="LblYavasOzet"
                   Text="Plan çözümleniyor…" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Kapat" Padding="14,5" Click="Kapat_Click"
                    AutomationProperties.AutomationId="BtnYavasKapat" />
            <Button DockPanel.Dock="Right" Content="⧉ Raporu kopyala" Padding="14,5" Margin="0,0,8,0"
                    Click="Kopyala_Click" AutomationProperties.AutomationId="BtnYavasKopyala" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BulgularListe" AutomationProperties.AutomationId="ListeYavasBulgular">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:YavaslikBulgusu}">
                        <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="4"
                                Background="{DynamicResource GirisZeminFircasi}" BorderThickness="4,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- Sol vurgu çizgisi öneme göre: Yüksek kırmızı, Orta amber, Bilgi gri -->
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZayifMetinFircasi}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Onem}" Value="{x:Static app:YavaslikOnem.Yuksek}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource TehlikeFircasi}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Onem}" Value="{x:Static app:YavaslikOnem.Orta}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource UyariFircasi}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Simge}" FontSize="18"
                                           Margin="0,0,10,0" VerticalAlignment="Top" />
                                <Button DockPanel.Dock="Right" Content="Script'i aç" Padding="10,3" VerticalAlignment="Top"
                                        Click="ScriptAc_Click"
                                        Visibility="{Binding DuzeltmeScript, Converter={StaticResource NullGizle}}"
                                        ToolTip="Düzeltme script'ini yeni sorgu sekmesinde açar (asla kendiliğinden çalıştırmaz)" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Aciklama}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource ZayifMetinFircasi}" FontSize="12.5" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
