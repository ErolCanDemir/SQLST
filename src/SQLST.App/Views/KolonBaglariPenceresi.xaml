<Window x:Class="SQLST.App.Views.KolonBaglariPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — 🔗 Kolon bağları" Width="760" Height="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource KenarFircasi}" Padding="10,6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="Ozet" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource BilgiMetinFircasi}"
                           AutomationProperties.AutomationId="LblBagOzet" />
                <TextBlock x:Name="Baslik" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" AutomationProperties.AutomationId="LblBagBaslik" />
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11.5"
                   Foreground="{DynamicResource SolukMetinFircasi}"
                   Text="▲ bu kolonun işaret ettiği  ·  ▼ bu kolonu işaret eden  —  çift tık: ilişkiyi JOIN sorgusuyla aç (ilk 100 satır)" />
        <ListBox x:Name="Liste" DisplayMemberPath="Gosterim" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                 MouseDoubleClick="Liste_CiftTik" AutomationProperties.AutomationId="ListeKolonBaglari" />
    </DockPanel>
</Window>
