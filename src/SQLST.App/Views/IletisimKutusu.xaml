<Window x:Class="SQLST.App.Views.IletisimKutusu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}"
        BorderThickness="1" BorderBrush="{DynamicResource KenarFircasi}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- 🪟 SQLST iletişim kutusu (v23-S20 — mockup docs/mockup/iletisim-kutulari.html ONAYLI): Windows
         MessageBox'ın temalı yerine. Kendi başlık çubuğu (WindowChrome — gölge ve sürükleme yerli kalır),
         tür ikonu, kalın başlık + mesaj, açılır ayrıntı, anlamlı düğmeler. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <!-- Başlık çubuğu -->
        <DockPanel DockPanel.Dock="Top" Height="34">
            <Button x:Name="KapatDugmesi" DockPanel.Dock="Right" Width="40" Content="✕" FontSize="12"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SolukMetinFircasi}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Kapat_Click" Cursor="Hand"
                    AutomationProperties.AutomationId="BtnIletisimKapat" />
            <TextBlock x:Name="PencereBasligiMetni" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SolukMetinFircasi}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Alt çubuk: (ayrıntıyı kopyala) + düğmeler -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ZeminAcikFircasi}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource KenarFircasi}" Padding="14,10">
            <DockPanel>
                <StackPanel x:Name="Dugmeler" DockPanel.Dock="Right" Orientation="Horizontal" />
                <Button x:Name="KopyalaDugmesi" Content="⧉ Ayrıntıyı kopyala" Visibility="Collapsed" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand" FontSize="12"
                        Foreground="{DynamicResource SolukMetinFircasi}" Click="Kopyala_Click"
                        AutomationProperties.AutomationId="BtnIletisimKopyala" />
            </DockPanel>
        </Border>

        <!-- Gövde -->
        <Grid Margin="20,4,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IkonDairesi" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Margin="0,4,14,0">
                <TextBlock x:Name="IkonMetni" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="18" FontWeight="Bold" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="BaslikMetni" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,6"
                           AutomationProperties.AutomationId="LblIletisimBaslik" />
                <TextBlock x:Name="MesajMetni" TextWrapping="Wrap" LineHeight="20"
                           AutomationProperties.AutomationId="LblIletisimMesaj" />
                <Expander x:Name="AyrintiAlani" Header="Ayrıntı" Margin="0,10,0,0" Visibility="Collapsed"
                          Foreground="{DynamicResource VurguFircasi}" FontSize="12">
                    <TextBox x:Name="AyrintiMetni" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                             VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             Padding="8,6" Margin="0,6,0,0" VerticalContentAlignment="Top"
                             Foreground="{DynamicResource MetinFircasi}"
                             AutomationProperties.AutomationId="TxtIletisimAyrinti" />
                </Expander>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
