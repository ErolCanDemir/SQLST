<Window x:Class="SQLST.App.Views.BagimlilikAgaciPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — 🔗 Bağımlılık Ağacı" Width="620" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" MinWidth="480" MinHeight="400"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top" Background="{DynamicResource BilgiZeminFircasi}" CornerRadius="3"
                Padding="10,7" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource KenarFircasi}">
            <TextBlock x:Name="Not" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource BilgiMetinFircasi}"
                       Text="ALTER öncesi etki analizi: ⬅ dalı bu nesneyi KULLANANLARI (kim etkilenir?), ➡ dalı bu nesnenin KULLANDIKLARINI (SP zinciri) gösterir. Düğümü açtıkça zincir derinleşir; aynı nesne zincirde tekrar görünürse ↻ döngü olarak işaretlenir. Bir düğüme çift tıklayın: onun iki yönlü bağımlılık script'i sekmede açılır."
                       AutomationProperties.AutomationId="LblBagimlilikNot" />
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="🔗 Script olarak aç" Padding="10,3" Margin="8,0,0,0"
                    Click="ScriptAc_Click" ToolTip="Kök nesnenin iki yönlü bağımlılık sorgusunu sekmede açar ve çalıştırır"
                    AutomationProperties.AutomationId="BtnBagimlilikScript" />
            <TextBlock x:Name="Baslik" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="LblBagimlilikBaslik" />
        </DockPanel>

        <TreeView x:Name="Agac" FontSize="12.5" BorderThickness="1"
                  BorderBrush="{DynamicResource KenarFircasi}" Background="Transparent"
                  AutomationProperties.AutomationId="TrvBagimlilik" />
    </DockPanel>
</Window>
