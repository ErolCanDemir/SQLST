<Window x:Class="SQLST.App.Views.AgentSihirbazPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SQLST.App.ViewModels"
        xmlns:conv="clr-namespace:SQLST.App.Converters"
        Title="{Binding PencereBasligi}" Width="1120" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}"
        FontFamily="Segoe UI" FontSize="12.5">
    <!-- ⏱ SQL Agent S3 sihirbazı (v23-S18) — mockup docs/mockup/sql-agent-sihirbaz.html ONAYLI.
         Sol: sayfa gezgini · sağ: sayfa içeriği · alt: anlık denetim + düğmeler. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolGorunurluk" />
        <conv:DegerDoluysaGorunurConverter x:Key="NullGizle" />
        <conv:NullGizleConverter x:Key="BosGizle" />
        <conv:TersBool x:Key="TersBool" />
        <Style x:Key="Etiket" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SolukMetinFircasi}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Satir" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- Kapsül seçim çipi (zamanlama türü) -->
        <Style x:Key="CipListe" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Kap" CornerRadius="11" Padding="11,3" BorderThickness="1"
                                BorderBrush="{DynamicResource KenarFircasi}" Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{DynamicResource SolukMetinFircasi}" x:Name="Icerik" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Kap" Property="Background" Value="{DynamicResource VurguFircasi}" />
                                <Setter TargetName="Kap" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
                                <Setter TargetName="Icerik" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Gün düğmesi (haftalık) -->
        <Style x:Key="GunDugmesi" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Kap" Width="40" Padding="0,3" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource KenarFircasi}" Background="Transparent">
                            <ContentPresenter x:Name="Icerik" HorizontalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource SolukMetinFircasi}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Kap" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
                                <Setter TargetName="Kap" Property="Background" Value="{DynamicResource VurguZeminFircasi}" />
                                <Setter TargetName="Icerik" Property="TextElement.Foreground" Value="{DynamicResource VurguFircasi}" />
                                <Setter TargetName="Icerik" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Denetim" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource PanelZeminFircasi}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SolukMetinFircasi}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource FarkEklenenZeminFircasi}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BasariFircasi}" />
                </Trigger>
                <Trigger Property="Tag" Value="hata">
                    <Setter Property="Background" Value="{DynamicResource FarkSilinenZeminFircasi}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TehlikeFircasi}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Alt çubuk: denetim + düğmeler -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ZeminAcikFircasi}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource KenarFircasi}" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Vazgeç" Padding="12,4" Margin="0,0,6,0" IsCancel="True"
                            AutomationProperties.AutomationId="BtnSihirbazVazgec" />
                    <Button Content="◀ Geri" Padding="12,4" Margin="0,0,6,0" Command="{Binding GeriCommand}"
                            IsEnabled="{Binding GeriAcik}" AutomationProperties.AutomationId="BtnSihirbazGeri" />
                    <Button Content="İleri ▶" Padding="12,4" Margin="0,0,6,0" Command="{Binding IleriCommand}"
                            IsEnabled="{Binding IleriAcik}" AutomationProperties.AutomationId="BtnSihirbazIleri" />
                    <Button Content="📜 Script üret" Padding="14,4" Style="{StaticResource BirincilDugme}"
                            Command="{Binding ScriptUretCommand}"
                            ToolTip="Script yeni sorgu sekmesinde açılır — çalıştırılmaz"
                            AutomationProperties.AutomationId="BtnSihirbazScript" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding DogrulamaOzeti}" FontSize="12" Foreground="{DynamicResource BasariFircasi}"
                               AutomationProperties.AutomationId="LblSihirbazOzet" />
                    <ItemsControl ItemsSource="{Binding Hatalar}" AutomationProperties.AutomationId="ListSihirbazHatalar">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=⚠ {0}}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TehlikeFircasi}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Uyarilar}" AutomationProperties.AutomationId="ListSihirbazUyarilar">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=ℹ {0}}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource UyariMetinFircasi}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sol: sayfa gezgini -->
        <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource ZeminAcikFircasi}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource KenarFircasi}">
            <DockPanel Margin="10,14">
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{DynamicResource SolukMetinFircasi}">
                    <Run Text="Sihirbaz job'u" /> <Run Text="oluşturmaz" FontWeight="Bold" /><Run Text=" — script üretir ve yeni sorgu sekmesinde açar. Gözden geçirip siz çalıştırırsınız (msdb)." />
                </TextBlock>
                <ListBox SelectedIndex="{Binding Sayfa}" BorderThickness="0" Background="Transparent"
                         AutomationProperties.AutomationId="ListSihirbazSayfalar">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Kap" Padding="10,8" CornerRadius="6" Background="Transparent">
                                            <ContentPresenter TextElement.Foreground="{DynamicResource SolukMetinFircasi}" x:Name="Icerik" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Kap" Property="Background" Value="{DynamicResource PencereZeminFircasi}" />
                                                <Setter TargetName="Kap" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
                                                <Setter TargetName="Kap" Property="BorderThickness" Value="3,0,0,0" />
                                                <Setter TargetName="Icerik" Property="TextElement.Foreground" Value="{DynamicResource MetinFircasi}" />
                                                <Setter TargetName="Icerik" Property="TextElement.FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <TextBlock Text="1   Genel" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="2   Adımlar" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Adimlar.Count}" FontWeight="Normal" />
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="3   Zamanlama" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Zamanlamalar.Count}" FontWeight="Normal" />
                    </DockPanel>
                    <TextBlock Text="4   Özet ve script" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Sağ: sayfa içeriği -->
        <DockPanel Margin="18,14,18,8">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{Binding SayfaBasligi}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SayfaAciklamasi}" Foreground="{DynamicResource SolukMetinFircasi}" Margin="0,2,0,0" />
            </StackPanel>
            <TabControl SelectedIndex="{Binding Sayfa}" BorderThickness="0" Padding="0" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- 1 · Genel -->
                <TabItem>
                    <Grid MaxWidth="640" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Job adı *" Style="{StaticResource Etiket}" />
                        <TextBox Grid.Column="1" Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" Margin="0,0,0,8"
                                 AutomationProperties.AutomationId="TxtSihirbazAd" />
                        <TextBlock Grid.Row="1" Text="Durum" Style="{StaticResource Etiket}" />
                        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Acik}" Margin="0,0,0,8"
                                  Content="Açık (oluşunca zamanlaması çalışır)" Foreground="{DynamicResource MetinFircasi}" />
                        <TextBlock Grid.Row="2" Text="Kategori" Style="{StaticResource Etiket}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Kategoriler}"
                                  Text="{Binding Kategori, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                  ToolTip="Var olanlardan seçin ya da yeni bir ad yazın (yoksa oluşturulur)"
                                  AutomationProperties.AutomationId="CmbSihirbazKategori" />
                        <TextBlock Grid.Row="3" Text="Sahip" Style="{StaticResource Etiket}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Sahip, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" Margin="0,0,0,8"
                                 ToolTip="Job'un sahibi olacak giriş (varsayılan: bağlı kullanıcı)"
                                 AutomationProperties.AutomationId="TxtSihirbazSahip" />
                        <TextBlock Grid.Row="4" Text="Açıklama" Style="{StaticResource Etiket}" VerticalAlignment="Top" Margin="0,4,10,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"
                                 Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="TxtSihirbazAciklama" />
                    </Grid>
                </TabItem>

                <!-- 2 · Adımlar -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="＋ Adım ekle" Padding="9,3" Margin="0,0,6,0" Command="{Binding AdimEkleCommand}"
                                            AutomationProperties.AutomationId="BtnSihirbazAdimEkle" />
                                    <Button Content="⧉ Çoğalt" Padding="9,3" Margin="0,0,6,0" Command="{Binding AdimCogaltCommand}" />
                                    <Button Content="↑" Padding="9,3" Margin="0,0,6,0" Command="{Binding AdimYukariCommand}"
                                            AutomationProperties.AutomationId="BtnSihirbazAdimYukari" />
                                    <Button Content="↓" Padding="9,3" Margin="0,0,6,0" Command="{Binding AdimAsagiCommand}" />
                                    <Button Content="🗑 Sil" Padding="9,3" Command="{Binding AdimSilCommand}" Foreground="{DynamicResource TehlikeFircasi}"
                                            AutomationProperties.AutomationId="BtnSihirbazAdimSil" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SolukMetinFircasi}"
                                           Text="Job 1. adımdan başlar. Sırayı değiştirince &quot;N. adıma git&quot; hedefleri yeni numaralarla güncellenir." />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Adimlar}" SelectedItem="{Binding SeciliAdim}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                                      SelectionMode="Single" FontFamily="Segoe UI" FontSize="12.5"
                                      AutomationProperties.AutomationId="SihirbazAdimGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Numara}" Width="30" />
                                    <DataGridTextColumn Header="Adım" Binding="{Binding Ad}" Width="1.2*" />
                                    <DataGridTextColumn Header="Veritabanı" Binding="{Binding Veritabani}" Width="*" />
                                    <DataGridTextColumn Header="Başarıda" Binding="{Binding BasaridaMetni}" Width="*" />
                                    <DataGridTextColumn Header="Hatada" Binding="{Binding HatadaMetni}" Width="1.6*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Seçili adım -->
                        <Grid Grid.Column="2" DataContext="{Binding SeciliAdim}"
                              Visibility="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NullGizle}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="110" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="10,6" CornerRadius="4"
                                    Background="{DynamicResource UyariZeminFircasi}"
                                    Visibility="{Binding SaltGoruntu, Converter={StaticResource BoolGorunurluk}}">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource UyariMetinFircasi}" FontSize="12">
                                    <Run Text="{Binding Tur, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" adımı — sihirbazda salt görüntü; script'te AYNEN korunur (adım türü yalnız T-SQL düzenlenir)." />
                                </TextBlock>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Adım adı" Style="{StaticResource Etiket}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" Margin="0,0,0,8"
                                     AutomationProperties.AutomationId="TxtSihirbazAdimAd" />
                            <TextBlock Grid.Row="2" Text="Veritabanı" Style="{StaticResource Etiket}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" Margin="0,0,0,8" IsEnabled="{Binding Duzenlenebilir}"
                                      ItemsSource="{Binding DataContext.Veritabanlari, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding Veritabani, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.AutomationId="CmbSihirbazAdimDb" />
                            <TextBlock Grid.Row="3" Text="Komut" Style="{StaticResource Etiket}" VerticalAlignment="Top" Margin="0,4,10,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Komut, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding SaltGoruntu}" AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="6,5"
                                     VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="TxtSihirbazAdimKomut" />
                            <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,6,0,8" IsEnabled="{Binding Duzenlenebilir}">
                                <Button Content="📋 Açık sorgu sekmesinden al ▾" Padding="9,3" Margin="0,0,6,0" Click="SorgudanAl_Click"
                                        AutomationProperties.AutomationId="BtnSihirbazSorgudanAl" />
                                <Button Content="✓ Söz dizimini denetle" Padding="9,3" Margin="0,0,8,0"
                                        Command="{Binding DataContext.DenetleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Komut ÇALIŞTIRILMADAN derlenir (SET NOEXEC) — kendi veritabanında"
                                        AutomationProperties.AutomationId="BtnSihirbazDenetle" />
                                <Border Style="{StaticResource Denetim}" Tag="{Binding DenetimTuru}" VerticalAlignment="Center"
                                        Visibility="{Binding DenetimSonucu, Converter={StaticResource BosGizle}}">
                                    <TextBlock Text="{Binding DenetimSonucu}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="420"
                                               AutomationProperties.AutomationId="LblSihirbazDenetim" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Grid.Row="5" Text="Başarıda" Style="{StaticResource Etiket}" />
                            <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                                <ComboBox DockPanel.Dock="Right" Width="170" Margin="6,0,0,0"
                                          Visibility="{Binding BasaridaHedefGorunur, Converter={StaticResource BoolGorunurluk}}"
                                          ItemsSource="{Binding DataContext.Adimlar, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding BasaridaHedef}" DisplayMemberPath="Gosterim" />
                                <ComboBox ItemsSource="{x:Static vm:AgentAdimTaslagi.EylemSecenekleri}" SelectedIndex="{Binding BasaridaIndex}"
                                          AutomationProperties.AutomationId="CmbSihirbazBasarida" />
                            </DockPanel>
                            <TextBlock Grid.Row="6" Text="Hatada" Style="{StaticResource Etiket}" />
                            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                                <ComboBox DockPanel.Dock="Right" Width="170" Margin="6,0,0,0"
                                          Visibility="{Binding HatadaHedefGorunur, Converter={StaticResource BoolGorunurluk}}"
                                          ItemsSource="{Binding DataContext.Adimlar, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding HatadaHedef}" DisplayMemberPath="Gosterim" />
                                <ComboBox ItemsSource="{x:Static vm:AgentAdimTaslagi.EylemSecenekleri}" SelectedIndex="{Binding HatadaIndex}"
                                          AutomationProperties.AutomationId="CmbSihirbazHatada" />
                            </DockPanel>
                            <TextBlock Grid.Row="7" Text="Yeniden deneme" Style="{StaticResource Etiket}" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="54" Text="{Binding YenidenDeneme, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                <TextBlock Text="kez, aralık" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding DenemeAraligi, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                <TextBlock Text="dakika" Margin="8,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 3 · Zamanlama -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="＋ Zamanlama ekle" Padding="9,3" Margin="0,0,6,0" Command="{Binding ZamanlamaEkleCommand}"
                                        AutomationProperties.AutomationId="BtnSihirbazZamanEkle" />
                                <Button Content="🗑 Sil" Padding="9,3" Command="{Binding ZamanlamaSilCommand}" Foreground="{DynamicResource TehlikeFircasi}" />
                            </StackPanel>
                            <Grid>
                                <ListBox ItemsSource="{Binding Zamanlamalar}" SelectedItem="{Binding SeciliZamanlama}"
                                         AutomationProperties.AutomationId="ListSihirbazZamanlamalar">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3">
                                                <TextBlock Text="{Binding Ad}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Metin}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="260"
                                                           Foreground="{DynamicResource SolukMetinFircasi}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Zamanlama yok — job yalnız elle başlatılır." TextWrapping="Wrap" Margin="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource SolukMetinFircasi}"
                                           Visibility="{Binding ZamanlamaYok, Converter={StaticResource BoolGorunurluk}}" />
                            </Grid>
                        </DockPanel>

                        <StackPanel Grid.Column="2" DataContext="{Binding SeciliZamanlama}"
                                    Visibility="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource NullGizle}}">
                            <DockPanel Style="{StaticResource Satir}">
                                <TextBlock Text="Ad" Width="96" Style="{StaticResource Etiket}" />
                                <CheckBox DockPanel.Dock="Right" Content="Açık" IsChecked="{Binding Acik}" Margin="10,0,0,0"
                                          VerticalAlignment="Center" Foreground="{DynamicResource MetinFircasi}" />
                                <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"
                                         AutomationProperties.AutomationId="TxtSihirbazZamanAd" />
                            </DockPanel>
                            <ListBox ItemsSource="{x:Static vm:AgentZamanlamaTaslagi.TurSecenekleri}" SelectedIndex="{Binding TurIndex}"
                                     BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CipListe}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6"
                                     AutomationProperties.AutomationId="ListSihirbazZamanTur">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <!-- Bir kez -->
                            <DockPanel Style="{StaticResource Satir}" Visibility="{Binding BirKezMi, Converter={StaticResource BoolGorunurluk}}">
                                <TextBlock Text="Ne zaman" Width="96" Style="{StaticResource Etiket}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="100" Text="{Binding BaslangicTarihi, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                    <TextBlock Text="saat" Margin="8,0" VerticalAlignment="Center" />
                                    <TextBox Width="64" Text="{Binding Saat, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                </StackPanel>
                            </DockPanel>
                            <!-- Her N gün/hafta/ay -->
                            <DockPanel Style="{StaticResource Satir}" Visibility="{Binding TekrarliMi, Converter={StaticResource BoolGorunurluk}}">
                                <TextBlock Text="Her" Width="96" Style="{StaticResource Etiket}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="50" Text="{Binding Her, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"
                                             AutomationProperties.AutomationId="TxtSihirbazHer" />
                                    <TextBlock Text="{Binding HerBirimi}" Margin="8,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <!-- Haftalık günler -->
                            <DockPanel Style="{StaticResource Satir}" Visibility="{Binding HaftalikMi, Converter={StaticResource BoolGorunurluk}}">
                                <TextBlock Text="Günler" Width="96" Style="{StaticResource Etiket}" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Style="{StaticResource GunDugmesi}" Content="Pzt" IsChecked="{Binding Pzt}" />
                                    <CheckBox Style="{StaticResource GunDugmesi}" Content="Sal" IsChecked="{Binding Sal}" />
                                    <CheckBox Style="{StaticResource GunDugmesi}" Content="Çar" IsChecked="{Binding Car}" />
                                    <CheckBox Style="{StaticResource GunDugmesi}" Content="Per" IsChecked="{Binding Per}" />
                                    <CheckBox Style="{StaticResource GunDugmesi}" Content="Cum" IsChecked="{Binding Cum}" />
                                    <CheckBox Style="{StaticResource GunDugmesi}" Content="Cmt" IsChecked="{Binding Cmt}" />
                                    <CheckBox Style="{StaticResource GunDugmesi}" Content="Paz" IsChecked="{Binding Paz}" />
                                </StackPanel>
                            </DockPanel>
                            <!-- Aylık -->
                            <StackPanel Visibility="{Binding AylikMi, Converter={StaticResource BoolGorunurluk}}" Margin="96,0,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <RadioButton GroupName="AylikKip" IsChecked="{Binding AylikGoreli, Converter={StaticResource TersBool}}"
                                                 Content="Ayın" VerticalAlignment="Center" Foreground="{DynamicResource MetinFircasi}" />
                                    <TextBox Width="44" Margin="6,0" Text="{Binding AylikGun, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" />
                                    <TextBlock Text=". günü" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="AylikKip" IsChecked="{Binding AylikGoreli}" Content="Ayın"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource MetinFircasi}" />
                                    <ComboBox Width="100" Margin="6,0" ItemsSource="{x:Static vm:AgentZamanlamaTaslagi.SiraSecenekleri}"
                                              SelectedIndex="{Binding SiraIndex}" />
                                    <ComboBox Width="150" ItemsSource="{x:Static vm:AgentZamanlamaTaslagi.GoreliGunSecenekleri}"
                                              SelectedIndex="{Binding GoreliGunIndex}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Gün içinde -->
                            <DockPanel Style="{StaticResource Satir}" Visibility="{Binding GunIciGorunur, Converter={StaticResource BoolGorunurluk}}">
                                <TextBlock Text="Gün içinde" Width="96" Style="{StaticResource Etiket}" VerticalAlignment="Top" Margin="0,4,10,0" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton GroupName="GunIci" IsChecked="{Binding GunIciTekrar, Converter={StaticResource TersBool}}"
                                                     Content="bir kez, saat" VerticalAlignment="Center" Foreground="{DynamicResource MetinFircasi}" />
                                        <TextBox Width="64" Margin="6,0" Text="{Binding Saat, UpdateSourceTrigger=PropertyChanged}" Padding="5,3"
                                                 AutomationProperties.AutomationId="TxtSihirbazSaat" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="GunIci" IsChecked="{Binding GunIciTekrar}" Content="her"
                                                     VerticalAlignment="Center" Foreground="{DynamicResource MetinFircasi}"
                                                     AutomationProperties.AutomationId="RbSihirbazTekrar" />
                                        <TextBox Width="44" Margin="6,0" Text="{Binding TekrarAraligi, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" />
                                        <ComboBox Width="96" ItemsSource="{x:Static vm:AgentZamanlamaTaslagi.BirimSecenekleri}" SelectedIndex="{Binding BirimIndex}" />
                                        <TextBlock Text="bir," Margin="6,0" VerticalAlignment="Center" />
                                        <TextBox Width="60" Text="{Binding AraBaslangic, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" />
                                        <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" />
                                        <TextBox Width="60" Text="{Binding AraBitis, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" />
                                        <TextBlock Text="arası" Margin="6,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <!-- Geçerlilik -->
                            <DockPanel Style="{StaticResource Satir}" Visibility="{Binding BitisGorunur, Converter={StaticResource BoolGorunurluk}}">
                                <TextBlock Text="Geçerlilik" Width="96" Style="{StaticResource Etiket}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="100" Text="{Binding BaslangicTarihi, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                    <TextBlock Text="→" Margin="8,0" VerticalAlignment="Center" />
                                    <CheckBox Content="bitiş:" IsChecked="{Binding BitisVar}" VerticalAlignment="Center"
                                              Foreground="{DynamicResource MetinFircasi}" />
                                    <TextBox Width="100" Margin="6,0,0,0" Text="{Binding BitisTarihi, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"
                                             IsEnabled="{Binding BitisVar}" />
                                </StackPanel>
                            </DockPanel>
                            <Border Margin="0,6,0,0" Padding="12,9" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource ZeminAcikFircasi}" BorderBrush="{DynamicResource KenarFircasi}">
                                <TextBlock Text="{Binding Metin}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VurguFircasi}"
                                           AutomationProperties.AutomationId="LblSihirbazZamanMetin" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 4 · Özet ve script -->
                <TabItem>
                    <TextBox Text="{Binding ScriptOnizleme, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                             FontSize="12" Padding="8,6" VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="TxtSihirbazScript" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
