<Window x:Class="SQLST.App.Views.OrtamKaydetPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLST — Ortam kaydet" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource PencereZeminFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <StackPanel Margin="14">
        <TextBlock Text="Ortam adı (ör. Test, Canlı, Müşteri-X):" Margin="0,0,0,6" />
        <TextBox x:Name="Ad" VerticalContentAlignment="Center"
                 AutomationProperties.AutomationId="TxtOrtamAd" />
        <TextBlock x:Name="Bilgi" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource SolukMetinFircasi}" />
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Kaydet" Padding="14,4"
                    Style="{StaticResource BirincilDugme}" Click="Kaydet_Click"
                    AutomationProperties.AutomationId="BtnOrtamKaydet" />
            <Button DockPanel.Dock="Right" Content="İptal" Padding="14,4" Margin="0,0,8,0"
                    Click="Iptal_Click" AutomationProperties.AutomationId="BtnOrtamIptal" />
        </DockPanel>
    </StackPanel>
</Window>
