<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- AÇIK · PETROL (v19-S9, 2026-08-03): beyaz-yeşilimsi yüzeyler, teal vurgu — Veri Arama
         ailesiyle akraba. Anahtar kümesi PaletAcik.xaml ile BİREBİR (PaletUyumTestleri korur). -->
    <SolidColorBrush x:Key="SeritFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BaglamSeridiFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VurguFircasi" Color="#0D9488" />
    <SolidColorBrush x:Key="VurguKoyuFircasi" Color="#0F766E" />
    <SolidColorBrush x:Key="VurguZeminFircasi" Color="#E4F5F2" />
    <!-- v22-S1 m.8: chip/vurgu-zemin uzerindeki YAZI rengi (kontrast bekcisi olctu) -->
    <SolidColorBrush x:Key="VurguZeminMetinFircasi" Color="#0F766E" />
    <SolidColorBrush x:Key="VurguBasiliFircasi" Color="#CDEDE8" />
    <SolidColorBrush x:Key="MetinFircasi" Color="#0E1F1D" />
    <SolidColorBrush x:Key="IkincilFircasi" Color="#5E7B76" />
    <SolidColorBrush x:Key="KenarFircasi" Color="#DFEAE7" />
    <SolidColorBrush x:Key="ZeminAcikFircasi" Color="#F5FAF9" />
    <SolidColorBrush x:Key="PencereZeminFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TehlikeFircasi" Color="#DC2626" />
    <SolidColorBrush x:Key="UyariFircasi" Color="#B45309" />
    <SolidColorBrush x:Key="BasariFircasi" Color="#16A34A" />
    <!-- Ctrl+F eşleşme vurgusu (v20-S17): yarı saydam amber — koyu metinle okunur. -->
    <SolidColorBrush x:Key="AramaVurguFircasi" Color="#66FFC107" />

    <Color x:Key="RayGradyanUst">#134E48</Color>
    <Color x:Key="RayGradyanAlt">#134E48</Color> <!-- v22-S15: düz ray -->
    <SolidColorBrush x:Key="RayMetinFircasi" Color="#E7F6F3" />
    <SolidColorBrush x:Key="RaySolukFircasi" Color="#93BFB8" />
    <SolidColorBrush x:Key="RayBaslikFircasi" Color="#7FADA6" />
    <SolidColorBrush x:Key="RayHoverFircasi" Color="#1C6B62" />

    <SolidColorBrush x:Key="ZayifMetinFircasi" Color="#3C5450" />
    <SolidColorBrush x:Key="SolukMetinFircasi" Color="#8FA8A3" />
    <SolidColorBrush x:Key="PanelZeminFircasi" Color="#F0F7F5" />
    <SolidColorBrush x:Key="BilgiZeminFircasi" Color="#E4F5F2" />
    <SolidColorBrush x:Key="BilgiMetinFircasi" Color="#0F5B54" />
    <SolidColorBrush x:Key="UyariZeminFircasi" Color="#FEF3E2" />
    <SolidColorBrush x:Key="UyariMetinFircasi" Color="#92500A" />
    <SolidColorBrush x:Key="UyariKenarFircasi" Color="#E0A83A" />
    <SolidColorBrush x:Key="FarkSilinenZeminFircasi" Color="#FBEAEA" />
    <SolidColorBrush x:Key="FarkEklenenZeminFircasi" Color="#E7F5EC" />
    <SolidColorBrush x:Key="EditorZeminFircasi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorMetinFircasi" Color="#1E1E1E" />
    <SolidColorBrush x:Key="GirisZeminFircasi" Color="#FFFFFF" />

    <SolidColorBrush x:Key="KaydiriciZeminFircasi" Color="#F5FAF9" />
    <SolidColorBrush x:Key="KaydiriciTutamacFircasi" Color="#C4DAD6" />
    <SolidColorBrush x:Key="KaydiriciTutamacUstuFircasi" Color="#9FC0BA" />
    <SolidColorBrush x:Key="KaydiriciTutamacBasiliFircasi" Color="#7FA49E" />

    <SolidColorBrush x:Key="IkonMor" Color="#8B5CF6" />
    <SolidColorBrush x:Key="IkonYesil" Color="#0E9F6E" />
    <SolidColorBrush x:Key="IkonAmber" Color="#D97706" />
    <SolidColorBrush x:Key="IkonMavi" Color="#0284C7" />
    <SolidColorBrush x:Key="IkonSari" Color="#CA8A04" />
    <SolidColorBrush x:Key="IkonIndigo" Color="#4F46E5" />
    <SolidColorBrush x:Key="IkonGul" Color="#E11D48" />
    <SolidColorBrush x:Key="IkonTeal" Color="#0D9488" />
    <SolidColorBrush x:Key="IkonPembe" Color="#DB2777" />

    <SolidColorBrush x:Key="TabloFircasi" Color="#1565C0" />
    <SolidColorBrush x:Key="ViewFircasi" Color="#00838F" />
    <SolidColorBrush x:Key="SpFircasi" Color="#6A1B9A" />
    <SolidColorBrush x:Key="FonksiyonFircasi" Color="#EF6C00" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CDEDE8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0E1F1D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0EEEA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0E1F1D" />

    <!-- Durum çubuğu (v22-S15): anahtar ayrıştı; ESKİ değerlerin aynısı — görsel fark yok. -->
    <SolidColorBrush x:Key="DurumCubuguZeminFircasi" Color="#0D9488" />
    <SolidColorBrush x:Key="DurumCubuguMetinFircasi" Color="#FFFFFF" />

    <!-- Ray çipi (v22-S15 sistem tasarımı): örtü ray tonunda → monokrom ray (renk aileden). -->
    <SolidColorBrush x:Key="RayCipOrtusuFircasi" Color="#134E48" />
    <SolidColorBrush x:Key="RayIkonFircasi" Color="#FFFFFF" />

    <!-- v23-S14 GRID IZGARASI: bu aile DEĞİŞMEDİ (bkz. PaletAcik.xaml notu). -->
    <x:Static x:Key="GridCizgiGorunurlugu" Member="DataGridGridLinesVisibility.Horizontal" />
    <SolidColorBrush x:Key="GridCizgiFircasi" Color="#DFEAE7" />
    <Thickness x:Key="GridBaslikKenarKalinligi">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="GridAlternatifSatirFircasi" Color="#F5FAF9" />
</ResourceDictionary>
