<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- KOYU palet (V2-S10): PaletAcik.xaml ile aynı anahtar kümesi — birinde eklenen diğerine de eklenir.
         TASARIM 1 · "PETROL" (2026-07-24): vurgu aydınlık petrol (#38BDD8), zeminler mavi-gri aile. -->

    <!-- COMMAND DECK koyu (2026-07-24): vurgu aydınlık indigo (#818CF8), çalışma alanı lacivert-gri.
         Sol ray İKİ TEMADA DA aynı koyu (RayZemin* PaletAcik ile birebir). -->
    <SolidColorBrush x:Key="SeritFircasi" Color="#161a2e" />
    <SolidColorBrush x:Key="BaglamSeridiFircasi" Color="#161a2e" />
    <SolidColorBrush x:Key="VurguFircasi" Color="#818CF8" />
    <SolidColorBrush x:Key="VurguKoyuFircasi" Color="#6366F1" />
    <SolidColorBrush x:Key="VurguZeminFircasi" Color="#282a52" />
    <!-- v22-S1 m.8: chip/vurgu-zemin uzerindeki YAZI rengi (kontrast bekcisi olctu) -->
    <SolidColorBrush x:Key="VurguZeminMetinFircasi" Color="#818CF8" />
    <SolidColorBrush x:Key="VurguBasiliFircasi" Color="#33366b" />
    <SolidColorBrush x:Key="MetinFircasi" Color="#E6E9F5" />
    <SolidColorBrush x:Key="IkincilFircasi" Color="#9AA1C4" />
    <SolidColorBrush x:Key="KenarFircasi" Color="#2b2f4d" />
    <SolidColorBrush x:Key="ZeminAcikFircasi" Color="#1c2038" />
    <SolidColorBrush x:Key="PencereZeminFircasi" Color="#161a2e" />
    <SolidColorBrush x:Key="TehlikeFircasi" Color="#F87171" />
    <SolidColorBrush x:Key="UyariFircasi" Color="#FBBF24" />
    <SolidColorBrush x:Key="BasariFircasi" Color="#4ADE80" />
    <!-- Ctrl+F eşleşme vurgusu (v20-S17, kullanıcı bulgusu 2026-08-08: varsayılan açık yeşil
         koyu temada açık metinle okunmuyordu) — yarı saydam amber: metin rengi ne olursa okunur. -->
    <SolidColorBrush x:Key="AramaVurguFircasi" Color="#55F59E0B" />

    <!-- Sol RAY — koyu temada ESKİ koyu tonlar kalır; açık tema 2026-07-26'da bir ton açıldı
         (kullanıcı isteği) — RayGradyan* Color'ları MainWindow gradyanına DynamicResource gider. -->
    <Color x:Key="RayGradyanUst">#1E1B4B</Color>
    <Color x:Key="RayGradyanAlt">#1E1B4B</Color> <!-- v22-S15 sistem tasarımı: ray DÜZ tek ton -->
    <SolidColorBrush x:Key="RayMetinFircasi" Color="#E5E9FF" />
    <SolidColorBrush x:Key="RaySolukFircasi" Color="#8B92C8" />
    <SolidColorBrush x:Key="RayBaslikFircasi" Color="#7C83B8" />
    <SolidColorBrush x:Key="RayHoverFircasi" Color="#312E6B" />

    <SolidColorBrush x:Key="ZayifMetinFircasi" Color="#AEB4D2" />
    <SolidColorBrush x:Key="SolukMetinFircasi" Color="#6B7196" />
    <SolidColorBrush x:Key="PanelZeminFircasi" Color="#12152b" />
    <SolidColorBrush x:Key="BilgiZeminFircasi" Color="#232653" />
    <SolidColorBrush x:Key="BilgiMetinFircasi" Color="#C7CBFF" />
    <SolidColorBrush x:Key="UyariZeminFircasi" Color="#332A14" />
    <SolidColorBrush x:Key="UyariMetinFircasi" Color="#D9A441" />
    <SolidColorBrush x:Key="UyariKenarFircasi" Color="#8A6D2E" />
    <SolidColorBrush x:Key="FarkSilinenZeminFircasi" Color="#3B2826" />
    <SolidColorBrush x:Key="FarkEklenenZeminFircasi" Color="#1E3428" />
    <SolidColorBrush x:Key="EditorZeminFircasi" Color="#1E1E1E" />
    <SolidColorBrush x:Key="EditorMetinFircasi" Color="#D8DCE0" />
    <!-- Giriş kutuları NÖTR koyu gri — yeşil/teal tonu kullanıcıyı rahatsız etti (2026-07-17);
         Petrol geçişinde de kural korunur: giriş zemininde vurgu tonu yok. -->
    <SolidColorBrush x:Key="GirisZeminFircasi" Color="#20262E" />

    <!-- Kaydırıcı + satır başlığı kromu (V4-S3): varsayılan Aero2 şeridi koyu temada AÇIK GRİ
         kalıyor ve pencereden fırlıyordu. Tutamaç zeminden ayrışacak kadar açık, ama içeriği
         bastırmayacak kadar sakin. -->
    <SolidColorBrush x:Key="KaydiriciZeminFircasi" Color="#1B2129" />
    <SolidColorBrush x:Key="KaydiriciTutamacFircasi" Color="#39434F" />
    <SolidColorBrush x:Key="KaydiriciTutamacUstuFircasi" Color="#4C5866" />
    <SolidColorBrush x:Key="KaydiriciTutamacBasiliFircasi" Color="#5E6C7C" />

    <!-- Komut barı ikon renkleri (2026-07-24) — koyu zeminde okunur aydınlık tonlar -->
    <SolidColorBrush x:Key="IkonMor" Color="#A78BFA" />
    <SolidColorBrush x:Key="IkonYesil" Color="#34D399" />
    <SolidColorBrush x:Key="IkonAmber" Color="#FBBF24" />
    <SolidColorBrush x:Key="IkonMavi" Color="#38BDF8" />
    <SolidColorBrush x:Key="IkonSari" Color="#FACC15" />
    <SolidColorBrush x:Key="IkonIndigo" Color="#818CF8" />
    <SolidColorBrush x:Key="IkonGul" Color="#FB7185" />
    <SolidColorBrush x:Key="IkonTeal" Color="#2DD4BF" />
    <SolidColorBrush x:Key="IkonPembe" Color="#F472B6" />

    <SolidColorBrush x:Key="TabloFircasi" Color="#64B5F6" />
    <SolidColorBrush x:Key="ViewFircasi" Color="#4DD0E1" />
    <SolidColorBrush x:Key="SpFircasi" Color="#CE93D8" />
    <SolidColorBrush x:Key="FonksiyonFircasi" Color="#FFB74D" />

    <!-- Seçim renkleri (3. tur): ağaç/grid seçimi varsayılan SystemColors'ı DynamicResource
         ile arar — override edilmezse odak editördeyken seçili ağaç düğümü AÇIK GRİ bant
         üstünde açık yazıyla okunmaz kalıyordu. İki palette de aynı 4 anahtar olmalı. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E3A46" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E4E9EF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#232B35" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E4E9EF" />

    <!-- Durum çubuğu (v22-S15 SİSTEM TASARIMI): TÜM ailelerde vurgu renkli bant + beyaz yazı
         (VS/SSMS deseni; koyu kipte VurguKoyu tonu — beyazla ≥3:1 ölçüldü). -->
    <SolidColorBrush x:Key="DurumCubuguZeminFircasi" Color="#6366F1" />
    <SolidColorBrush x:Key="DurumCubuguMetinFircasi" Color="#FFFFFF" />

    <!-- Ray çipi (v22-S15 SİSTEM TASARIMI): örtü ray tonunda → monokrom ray (renk aileden). -->
    <SolidColorBrush x:Key="RayCipOrtusuFircasi" Color="#1E1B4B" />
    <SolidColorBrush x:Key="RayIkonFircasi" Color="#FFFFFF" />

    <!-- v23-S14 GRID IZGARASI: bu aile DEĞİŞMEDİ (bkz. PaletAcik.xaml notu). -->
    <x:Static x:Key="GridCizgiGorunurlugu" Member="DataGridGridLinesVisibility.All" />
    <SolidColorBrush x:Key="GridCizgiFircasi" Color="#2b2f4d" />
    <Thickness x:Key="GridBaslikKenarKalinligi">0,0,1,1</Thickness>
    <SolidColorBrush x:Key="GridAlternatifSatirFircasi" Color="#1c2038" />
</ResourceDictionary>
