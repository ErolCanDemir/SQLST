    <!-- SQLST LOGOSU (2026-07-25 Command Deck kimliği; v22-S15 rötuşu 2026-09-23 — kullanıcı:
         "moru daha uygun bir renge çekelim"): karo İNDİGO-MOR'dan VS/SSMS MAVİ ailesine döndü
         (yeni sistem tasarımının kimliği), amber şimşek MARKA olarak kaldı. Beyaz veritabanı
         silindiri aynı. Vektör (DrawingImage) — ray başlığı, bağlantı marka bandı ve sqlst.ico
         buradan üretilir. Renkler SABİT (marka); iki temada da aynı görünür. -->
    <DrawingImage x:Key="SqlstLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Karo -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E9BE6" Offset="0" />
                            <GradientStop Color="#0078D4" Offset="0.55" />
                            <GradientStop Color="#005A9E" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Silindir gövdesi (beyaz) -->
                <GeometryDrawing Brush="#FFFFFF"
                                 Geometry="M15,21 A17,7 0 0 1 49,21 L49,45 A17,7 0 0 1 15,45 Z" />
                <!-- Üst kapak (açık mavi ton — derinlik) -->
