                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,21" RadiusX="17" RadiusY="7" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Disk ayırıcı yaylar (mavi, ince) -->
                <GeometryDrawing Geometry="M15,29 A17,7 0 0 0 49,29">
                    <GeometryDrawing.Pen><Pen Brush="#AFD5F2" Thickness="2.2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M15,37 A17,7 0 0 0 49,37">
                    <GeometryDrawing.Pen><Pen Brush="#AFD5F2" Thickness="2.2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Amber şimşek (enerji/hız — silindirin üstünden geçer, beyaz konturla ayrışır) -->
                <GeometryDrawing Brush="#F59E0B"
                                 Geometry="M38,10 L23,35 L31,35 L26,54 L44,27 L35,27 Z">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
