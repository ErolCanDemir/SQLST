         petrol vurgusuyla tutarlı. Path'ler stroke ile çizilir (Fill yok). -->
    <StreamGeometry x:Key="Ikon.Ara">M4,10 A6,6 0 1 1 16,10 A6,6 0 1 1 4,10 Z M14.5,14.5 L20,20</StreamGeometry>
