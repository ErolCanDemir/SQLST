<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:SQLST.App.Converters"
                    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
                    xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
                    xmlns:app="clr-namespace:SQLST.App">
    <!-- Tutamak asgarisi Track.ViewportSize şişirmesiyle dayatılır (27 Ağu 2026) — gerekçe
         DikeyKaydirici şablonunun üstündeki notta. Hedef boy matematiği TutamacAsgarisi'nde. -->
    <conv:TutamacAsgarisiConverter x:Key="TutamacAsgarisi" />
    <conv:TutamacViewportConverter x:Key="TutamacViewport" />
    <!--
      Merkezi tema STİLLERİ (S6 → V2-S10): renkler PaletAcik/PaletKoyu.xaml'a taşındı;
      buradaki her renk başvurusu DynamicResource'tur ki palet takası (karanlık tema)
      uygulama açıkken ANINDA işlesin. Yeni stil eklerken renkleri palet anahtarından al.
    -->

    <!-- BoolGorunurluk BURADA da tanımlı olmalı (2026-07-24): RayOgesi stili bunu StaticResource ile
         kullanıyor; stil Tema.xaml içinde parse edilirken MainWindow.Resources'taki tanım ERİŞİLMEZ →
         StaticResourceHolder istisnası (ana pencere açılmıyordu). Ayrı sözlük, çakışma yok. -->
    <BooleanToVisibilityConverter x:Key="BoolGorunurluk" />

    <!-- Tipografi (v23-S19, kullanıcı 2026-10-06: "mockup'ların yazı tipini uygulayalım"): arayüz ve
         IZGARALAR klasik Segoe UI — onaylı mockup'larla (sql-agent, sihirbaz, REST) birebir. Eskiden
         Segoe UI Variable Text + ızgarada kod yazısıydı. Kod editörleri tek aralıklı kalır (KodYazisi). -->
    <FontFamily x:Key="ArayuzYazisi">Segoe UI</FontFamily>
    <FontFamily x:Key="KodYazisi">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="YaziKucuk">11</sys:Double>
    <sys:Double x:Key="YaziGovde">12.5</sys:Double>

    <!-- Kod editörleri PİKSEL-KENETLİ çizer (kullanıcı 2026-09-17: "editörde yazılar çok karışık,
         SSMS'de böyle değil"). WPF varsayılanı Ideal, harfleri piksel-altı konumlara yerleştirir —
         13px kod yazısı yumuşak/bulanık görünür; SSMS/VS editörleri Display modu kullanır.
         Font suçlu DEĞİLDİ (Cascadia Mono çözülüyor — ölçüldü); örtük stil TÜM TextEditor'lara
         (SQL, LINQ, REST/SOAP, önizlemeler) tek yerden uygular. -->
    <Style TargetType="avalon:TextEditor">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- ══ KLASİK (B) DÜZEN ŞABLONLARI (v23-S14 — Antrasit ailesi; kullanıcı onaylı mockup:
         docs/mockup/antrasit-tema.html). Stiller bunlara {Binding Path=(app:TemaDurumu.Klasik)}
         DataTrigger'ı ile geçer; diğer ailelerde hiç devreye girmez. Renkler yine paletten. -->

    <!-- Klasik düğme: beyaz zemin, ince gri kenar, 2px köşe; hover açık vurgu zemin. -->
    <ControlTemplate x:Key="KlasikDugmeSablonu" TargetType="Button">
        <Border x:Name="k" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="k" Property="Background" Value="{DynamicResource VurguZeminFircasi}" />
                <Setter TargetName="k" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="k" Property="Background" Value="{DynamicResource VurguBasiliFircasi}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="k" Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Klasik araç düğmesi içeriği: renkli çip YOK — tek renk küçük ikon + metin. -->
    <DataTemplate x:Key="KlasikAracIcerigi">
        <StackPanel Orientation="Horizontal">
            <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                  Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                  Stroke="{DynamicResource ZayifMetinFircasi}" StrokeThickness="1.6" Fill="Transparent"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{DynamicResource MetinFircasi}" />
        </StackPanel>
    </DataTemplate>

    <!-- Klasik anahtar: kapsül yerine KARE onay kutusu (işaretliyken turkuaz dolgu + ✓). -->
    <ControlTemplate x:Key="KlasikAnahtarSablonu" TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="kutu" Width="14" Height="14" VerticalAlignment="Center" CornerRadius="1"
                    BorderThickness="1" BorderBrush="{DynamicResource KaydiriciTutamacBasiliFircasi}"
                    Background="{DynamicResource PencereZeminFircasi}" SnapsToDevicePixels="True">
                <TextBlock x:Name="tik" Text="✓" Visibility="Collapsed" Foreground="White" FontSize="10.5"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="kutu" Property="Background" Value="{DynamicResource VurguFircasi}" />
                <Setter TargetName="kutu" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
                <Setter TargetName="tik" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kutu" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Klasik KUTULU sekme: pasif gri şerit tonunda, seçili beyaz ve alttaki çizgiyi örter. -->
    <ControlTemplate x:Key="KlasikSekmeSablonu" TargetType="TabItem">
        <Border x:Name="k" Background="{DynamicResource PanelZeminFircasi}" BorderThickness="1,1,1,0"
                BorderBrush="{DynamicResource KenarFircasi}" CornerRadius="2,2,0,0"
                Margin="0,2,-1,0" SnapsToDevicePixels="True">
            <ContentPresenter x:Name="basl" ContentSource="Header" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" TextElement.FontWeight="Normal" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="k" Property="Background" Value="{DynamicResource VurguZeminFircasi}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="k" Property="Background" Value="{DynamicResource PencereZeminFircasi}" />
                <Setter TargetName="k" Property="Margin" Value="0,0,-1,-1" />
                <Setter TargetName="basl" Property="Margin" Value="12,7,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}" />
                <Setter Property="Panel.ZIndex" Value="1" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Düğme: sade flat; hover/pressed/disabled tutarlı.
         Tooltip'ler ANINDA açılır (kullanıcı bulgusu 2026-07-24: ikon düğmelerde ad
         hemen görünsün) ve pasif düğmede de gösterilir (neden pasif olduğu okunsun). -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Background" Value="{DynamicResource PencereZeminFircasi}" />
        <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KenarFircasi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="50" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="k" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="k" Property="Background" Value="{DynamicResource VurguZeminFircasi}" />
                            <Setter TargetName="k" Property="BorderBrush" Value="{DynamicResource VurguFircasi}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="k" Property="Background" Value="{DynamicResource VurguBasiliFircasi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="k" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- v23-S14 klasik (B) düzen: 2px köşeli klasik düğme (BasedOn stiller de devralır). -->
            <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                <Setter Property="Template" Value="{StaticResource KlasikDugmeSablonu}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ☰ / ray üstü sade düğme (v22-S15 rötuşu — kullanıcı ekran görüntüsü 2026-09-23: genel
         buton şablonunun hover'ı (VurguZemin + Vurgu çerçeve) koyu monokrom rayda açık indigo
         KUTU basıyordu). Ray öğeleriyle aynı dil: şeffaf zemin, hover'da RayHoverFircasi. -->
    <Style x:Key="RayGecisDugmesi" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="k" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="k" Property="Background" Value="{DynamicResource RayHoverFircasi}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="k" Property="Background" Value="{DynamicResource RayHoverFircasi}" />
                            <Setter TargetName="k" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Birincil eylem düğmesi (Bağlan, Çalıştır): dolu turkuaz -->
    <Style x:Key="BirincilDugme" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource VurguFircasi}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource VurguKoyuFircasi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <!-- v23-S14 klasik (B): Çalıştır dahil birincil düğme de DOLGUSUZ — beyaz + gri kenar. -->
            <DataTrigger Binding="{Binding Path=(app:TemaDurumu.Klasik)}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PencereZeminFircasi}" />
                <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}" />
                <Setter Property="BorderBrush" Value="{DynamicResource KenarFircasi}" />
                <Setter Property="FontWeight" Value="Normal" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

