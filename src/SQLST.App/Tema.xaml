    <!-- 🌐 REST İstemcisi (v20-S8): küre (çember + yatay çap + iki meridyen) -->
    <StreamGeometry x:Key="Ikon.Rest">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M2,12 H22 M12,2 C6,7 6,17 12,22 M12,2 C18,7 18,17 12,22</StreamGeometry>
