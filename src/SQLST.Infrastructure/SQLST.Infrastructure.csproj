<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SQLST.Contracts\SQLST.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal bağlantı-dizesi kurucularının (Mongo BaglantiDizesi) birim testleri için -->
    <InternalsVisibleTo Include="SQLST.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- 2.x hattı BİLEREK: MongoDB.Driver 3.x, sunucudan en az wire version 9 (MongoDB 4.4)
         ister ve eski sunuculara bağlanmayı REDDEDER (kullanıcı bulgusu 2026-07-20: MERSIS'in
         Mongo'su wire 6 = MongoDB 3.6 → "requires at least 9"). Bu araç eski/kısıtlı ortamlar
         içindir; 2.28+ hattı MongoDB 3.6'dan 8.0'a kadar destekler, hem eski hem yeni sunucuyu
         kapsar. Kodumuz yalnız çekirdek API kullanıyor (Find/Aggregate/RunCommand/BsonDocument),
         3.x'in kırıcı değişiklikleri (LINQ3, GuidRepresentation) burada geçmiyor. -->
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <!-- MongoDB.Driver 2.30 wire sıkıştırma için Snappier/SharpCompress'in ESKİ, GÜVENLİK
         AÇIKLI sürümlerini getiriyor (Snappier 1.0.0 = GHSA-pggp-6c3x-2xmx YÜKSEK; SharpCompress
         0.30.1 = GHSA-6c8g-7p36-r338 orta). Yamalanmış sürümleri açıkça sabitleyerek transitif
         sürümü geçersiz kılıyoruz — sıkıştırma opsiyoneldir ve bu kütüphanelerin API'si stabildir. -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
